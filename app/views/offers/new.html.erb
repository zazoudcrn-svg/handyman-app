<h1>Make an Offer for <%= @listing.title %></h1>

<%= form_with model: @offer, url: listing_offers_path(@listing), local: true do |f| %>
  <% if @offer.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @offer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :quote, "Your Quote (€)" %>
    <%= f.number_field :quote, step: 0.01, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :note %>
    <%= f.text_area :note, rows: 4, class: "form-control" %>
  </div>

  <%= f.submit "Submit Offer", class: "btn btn-success" %>
<% end %>

<%= link_to "Back to listing", listing_path(@listing) %>
