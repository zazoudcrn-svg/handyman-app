<% # Check at the absolute top if the user is flipping weeks inside the calendar %>
<% is_emergency = @listing.title.include?("EMERGENCY") %>

<% # Main structural wrapper matching the premium SaaS design %>
<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1100px;">

    <% # ==================== 1. NAVIGATION BACK LINK ==================== %>
    <div class="mb-4">
      <%
        back_path = case params[:from]
                    when 'offered' then dashboard_path(anchor: 'offered')
                    when 'bookings' then dashboard_path(anchor: 'bookings')
                    when 'completed' then dashboard_path(anchor: 'completed')
                    when 'declined' then dashboard_path(anchor: 'archived')
                    else dashboard_path
                    end
      %>
      <%= link_to back_path, class: "text-decoration-none d-inline-flex align-items-center gap-2 small fw-medium text-muted-hover", style: "color: #64748B; transition: color 0.2s;" do %>
        <i class="bi bi-arrow-left"></i> Back to Dashboard
      <% end %>
    </div>

    <% # ==================== 2. TWO-COLUMN PREMIUM LAYOUT ==================== %>
    <div class="row g-4">

      <% # LEFT COLUMN: MAIN CONTENT PROFILE %>
      <div class="col-lg-8">
        <div class="card border-0 overflow-hidden" style="background-color: #FFFFFF; border: 1px solid #E2E8F0 !important; border-radius: 20px; box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02);">

          <% # Visual Header Image Segment: Priority hierarchy (1. User Photo, 2. Seed Keyword, 3. Placeholder) %>
          <div class="position-relative" style="height: 320px; background-color: #E2E8F0; display: flex; align-items: center; justify-content: center; border-radius: 20px 20px 0 0;">

            <% if @listing.photos.attached? && @listing.photos.first.present? %>
              <% # Priority 1: Display the first user-uploaded or seed photo %>
              <%= cl_image_tag @listing.photos.first.key, class: "w-100 h-100 object-cover" %>
            <% else %>
              <% # Priority 2: Fallback logic based on title keywords for seed data %>
              <%
                image_path = if is_emergency then "listings/burst_pipe.png"
                             elsif @listing.title.downcase.include?("sink") then "listings/kitchen_sink.png"
                             elsif @listing.title.downcase.include?("boiler") then "listings/boiler_repair.png"
                             elsif @listing.title.downcase.include?("radiator") then "listings/radiator_valve.png"
                             elsif @listing.title.downcase.include?("shower") then "listings/shower_seal.png"
                             else nil end
              %>

              <% if image_path.present? %>
                <%= image_tag image_path, class: "w-100 h-100 object-cover" %>
              <% else %>
                <% # Priority 3: Professional placeholder if no photo and no keyword match found %>
                <div class="text-center" style="color: #64748B;">
                  <i class="bi bi-camera" style="font-size: 3rem; display: block; margin-bottom: 0.5rem;"></i>
                  <span class="fw-semibold" style="font-size: 1.1rem;">No photo attached</span>
                </div>
              <% end %>
            <% end %>

            <% # Emergency Badge display %>
            <% if is_emergency %>
              <div class="position-absolute top-3 start-3">
                <span class="badge text-uppercase tracking-wider fw-bold text-white px-3 py-2 shadow-sm" style="background-color: #EF4444; font-size: 11px; border-radius: 6px;">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i> Emergency
                </span>
              </div>
            <% end %>
          </div>

          <% # Job Body Content %>
          <div class="p-4 p-md-5">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
              <span class="badge border text-capitalize px-3 py-1.5" style="border-radius: 6px; background-color: #F1F5F9; color: #475569; font-size: 12px; font-weight: 600; border-color: #E2E8F0 !important;">
                <%= @listing.category&.name || "General" %>
              </span>
              <span class="text-muted small d-flex align-items-center gap-1">
                <i class="bi bi-activity"></i> Status: <strong class="text-capitalize" style="color: #2F6BFF;"><%= @listing.listing_status %></strong>
              </span>
            </div>

            <h1 class="tracking-tight font-semibold mb-4" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2.2rem; letter-spacing: -0.5px; line-height: 1.2;">
              <%= @listing.title %>
            </h1>

            <hr style="border-color: #E2E8F0; opacity: 0.6;" class="my-4">

            <h4 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 1.1rem; letter-spacing: 0.5px;">
              Project Description
            </h4>
            <div class="text-muted mb-5" style="line-height: 1.7; font-size: 15px; color: #475569 !important;">
              <%= @listing.description || "No description provided." %>
            </div>

            <% # Cloudinary Multi-Photos Carousel Segment %>
            <% if @listing.photos.count > 1 %>
              <h4 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 1.1rem; letter-spacing: 0.5px;">
                Additional Images
              </h4>
              <div class="row g-2 mb-5">
                <% @listing.photos.drop(1).each do |photo| %>
                  <div class="col-6 col-sm-4">
                    <div class="position-relative overflow-hidden rounded-3 border" style="height: 140px; border-color: #E2E8F0 !important;">
                      <%= cl_image_tag photo.key, class: "w-100 h-100 object-cover gallery-img" %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% # Location & Schedule Details %>
            <h4 class="fw-bold" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 1.1rem; letter-spacing: 0.5px;">
              Location & Schedule Details
            </h4>

            <div class="row g-3 p-4 rounded-4 mt-4" style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
              <% if current_user.role == "customer" || @listing.offers.find_by(user: current_user, offer_status: "accepted") %>
                <div class="col-12 border-b pb-3 mb-2" style="border-bottom: 1px dashed #E2E8F0;">
                  <div class="d-flex align-items-start gap-2">
                    <span class="fw-bold text-primary me-1" style="color: #2F6BFF !important;">📍</span>
                    <div>
                      <span class="text-muted d-block small text-uppercase tracking-wider fw-semibold" style="font-size: 10px;">Precise Street Address</span>
                      <strong class="text-dark d-block fw-semibold mt-1" style="font-size: 14px;"><%= @listing.street %></strong>
                    </div>
                  </div>
                </div>
              <% end %>

              <div class="col-sm-6">
                <div class="d-flex align-items-start gap-2">
                  <span class="fw-bold text-primary me-1" style="color: #2F6BFF !important;">🏢</span>
                  <div>
                    <span class="text-muted d-block small text-uppercase tracking-wider fw-semibold" style="font-size: 10px;">City & Region</span>
                    <strong class="text-dark d-block fw-semibold mt-1" style="font-size: 14px;"><%= @listing.postcode %> <%= @listing.city %>, <%= @listing.country %></strong>
                  </div>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="d-flex align-items-start gap-2">
                  <span class="fw-bold text-primary me-1" style="color: #2F6BFF !important;">📅</span>
                  <div>
                    <span class="text-muted d-block small text-uppercase tracking-wider fw-semibold" style="font-size: 10px;">Preferred Timeframe</span>
                    <strong class="text-dark d-block fw-semibold mt-1" style="font-size: 14px;">
                      <%= @listing.preferred_date_and_time.present? ? @listing.preferred_date_and_time : "Flexible Schedule" %>
                    </strong>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <% # RIGHT COLUMN: INTERACTION CONTEXT PANEL %>
      <div class="col-lg-4">
        <div class="card border-0 position-sticky" style="top: 24px; background-color: #FFFFFF; border: 1px solid #E2E8F0 !important; border-radius: 20px; box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02);">
          <div class="p-4">
            <% if current_user.role == "customer" %>
              <%
                accepted_offer = @listing.offers.find_by(offer_status: "accepted")
                other_offers = @listing.offers.where.not(offer_status: [ "declined", "accepted" ])
                visible_offers = [ accepted_offer, *other_offers ].compact
              %>
              <h5 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">
                <%= link_to offers_path, class: "text-decoration-none text-dark d-flex justify-content-between align-items-center" do %>
                  <span>Incoming Offers</span>
                  <span class="badge rounded-pill bg-light text-dark border font-monospace" style="font-size: 13px;"><%= @listing.offers.where.not(offer_status: "declined").count %></span>
                <% end %>
              </h5>
              <div class="d-flex flex-column gap-3 my-4">
                <% if visible_offers.any? %>
                  <% visible_offers.each do |offer| %>
                    <div class="p-3 rounded-3 border d-flex justify-content-between align-items-center" style="background-color: #F8FAFC; border-color: #E2E8F0 !important;">
                      <div>
                        <span class="text-muted d-block small">Quotation</span>
                        <strong class="text-dark font-monospace" style="font-size: 15px;">€<%= offer.quote %></strong>
                      </div>
                      <div class="text-end">
                        <span class="badge mb-2 d-block text-capitalize" style="font-size: 11px; background-color: <%= offer.offer_status == 'accepted' ? '#D1FAE5' : '#EFF6FF' %>; color: <%= offer.offer_status == 'accepted' ? '#065F46' : '#2F6BFF' %>;">
                          <%= offer.offer_status || "Pending" %>
                        </span>
                        <%= link_to "Review →", listing_offer_path(@listing, offer), class: "small fw-semibold text-decoration-none", style: "color: #2F6BFF;" %>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <p class="text-muted small text-center py-3 m-0">No offers submitted yet.</p>
                <% end %>
              </div>
              <div class="d-grid gap-2 pt-2 border-top" style="border-color: #F1F5F9 !important;">
                <%= link_to edit_listing_path(@listing), class: "btn btn-light border py-2 fw-semibold text-dark", style: "border-radius: 12px; font-size: 14px;" do %>
                  <i class="bi bi-pencil-square me-1"></i> Edit Details
                <% end %>
                <%= link_to listing_path(@listing), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this listing permanently?" }, class: "btn btn-outline-danger py-2 fw-semibold", style: "border-radius: 12px; font-size: 14px;" do %>
                  <i class="bi bi-trash3-fill me-1"></i> Delete Listing
                <% end %>
              </div>
            <% else %>
              <% # Logic for contractor... %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .object-cover { object-fit: cover; }
  .gallery-img { transition: transform 0.2s ease; cursor: pointer; }
  .gallery-img:hover { transition: transform 0.2s ease; transform: scale(1.05); }
  .text-muted-hover:hover { color: #0B1B33 !important; }
</style>
