<% is_emergency = @listing.title.include?("EMERGENCY") %>

<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1100px;">

    <% # 1. NAVIGATION BACK LINK %>
    <div class="mb-4">
      <%
        back_path = case params[:from]
                    when 'offered' then dashboard_path(anchor: 'offered')
                    when 'bookings' then dashboard_path(anchor: 'bookings')
                    when 'completed' then dashboard_path(anchor: 'completed')
                    when 'declined' then dashboard_path(anchor: 'archived')
                    else dashboard_path
                    end
      %>
      <%= link_to back_path, class: "text-decoration-none d-inline-flex align-items-center gap-2 small fw-medium text-muted-hover", style: "color: #64748B; transition: color 0.2s;" do %>
        <i class="bi bi-arrow-left"></i> Back to Dashboard
      <% end %>
    </div>

    <div class="row g-4">
      <% # LEFT COLUMN: MAIN CONTENT %>
      <div class="col-lg-8">
        <div class="card border-0 overflow-hidden" style="background-color: #FFFFFF; border: 1px solid #E2E8F0 !important; border-radius: 20px; box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02);">

          <div class="position-relative" style="height: 320px; background-color: #E2E8F0; display: flex; align-items: center; justify-content: center; border-radius: 20px 20px 0 0;">
            <% if @listing.photos.attached? && @listing.photos.first.present? %>
              <%= cl_image_tag @listing.photos.first.key, class: "w-100 h-100 object-cover" %>
            <% else %>
              <%
                image_path = if is_emergency then "listings/burst_pipe.png"
                             elsif @listing.title.downcase.include?("sink") then "listings/kitchen_sink.png"
                             elsif @listing.title.downcase.include?("boiler") then "listings/boiler_repair.png"
                             elsif @listing.title.downcase.include?("radiator") then "listings/radiator_valve.png"
                             elsif @listing.title.downcase.include?("shower") then "listings/shower_seal.png"
                             else nil end
              %>
              <% if image_path.present? %>
                <%= image_tag image_path, class: "w-100 h-100 object-cover" %>
              <% else %>
                <div class="text-center" style="color: #64748B;">
                  <i class="bi bi-camera" style="font-size: 3rem; display: block; margin-bottom: 0.5rem;"></i>
                  <span class="fw-semibold" style="font-size: 1.1rem;">No photo attached</span>
                </div>
              <% end %>
            <% end %>
            <% if is_emergency %>
              <div class="position-absolute top-3 start-3">
                <span class="badge text-uppercase tracking-wider fw-bold text-white px-3 py-2 shadow-sm" style="background-color: #EF4444; font-size: 11px; border-radius: 6px;">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i> Emergency
                </span>
              </div>
            <% end %>
          </div>

          <div class="p-4 p-md-5">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
              <span class="badge border text-capitalize px-3 py-1.5" style="border-radius: 6px; background-color: #F1F5F9; color: #475569; font-size: 12px; font-weight: 600; border-color: #E2E8F0 !important;">
                <%= @listing.category&.name || "General" %>
              </span>
              <span class="text-muted small d-flex align-items-center gap-1">
                <i class="bi bi-activity"></i> Status: <strong class="text-capitalize" style="color: #2F6BFF;"><%= @listing.listing_status %></strong>
              </span>
            </div>

            <h1 class="tracking-tight font-semibold mb-4" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2.2rem; letter-spacing: -0.5px; line-height: 1.2;">
              <%= @listing.title %>
            </h1>
            <hr style="border-color: #E2E8F0; opacity: 0.6;" class="my-4">
            <h4 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 1.1rem; letter-spacing: 0.5px;">Project Description</h4>
            <div class="text-muted mb-5" style="line-height: 1.7; font-size: 15px; color: #475569 !important;">
              <%= @listing.description || "No description provided." %>
            </div>
          </div>
        </div>
      </div>

      <% # RIGHT COLUMN: ACTION PANEL %>
      <div class="col-lg-4">
        <div class="card border-0 position-sticky" style="top: 24px; background-color: #FFFFFF; border: 1px solid #E2E8F0 !important; border-radius: 20px; box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02);">
          <div class="p-4">
          <% if current_user.customer? && @listing.user == current_user %>
          <h5 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Offers (<%= @offers.count %>)</h5>

          <% if @offers.any? %>
            <% @offers.each do |offer| %>
              <div class="p-3 mb-3 rounded-3" style="border: 1px solid #E2E8F0; background-color: #F8FAFC;">
                <p class="fw-semibold mb-1" style="color: #0B1B33;">
                  <%= link_to offer.user.contractor_profile&.business_name || offer.user.first_name, profile_path(offer.user), style: "color: #2F6BFF; text-decoration: none;" %>
                </p>
                <p class="mb-1 small"><strong>Quote:</strong> €<%= offer.quote %></p>
                <p class="mb-2 small"><strong>Date:</strong> <%= offer.suggested_date_and_time&.strftime("%b %d, %Y") || "Not specified" %></p>
                <%= link_to "View Offer →", listing_offer_path(@listing, offer), class: "btn btn-primary btn-sm w-100", style: "border-radius: 8px; background-color: #2F6BFF; border: none;" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted small mb-4">No offers received yet.</p>
          <% end %>

          <hr class="my-3">

          <%= link_to edit_listing_path(@listing), class: "btn btn-light border py-2 fw-semibold text-dark w-100", style: "border-radius: 12px;" do %>
            <i class="bi bi-pencil-square me-1"></i> Edit Details
          <% end %>
            <% else %>
              <%# Customer info %>
              <h5 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Posted by</h5>
              <div class="d-flex align-items-center gap-3 mb-4 pb-4" style="border-bottom: 1px solid #E2E8F0;">
                <% if @listing.user.avatar.attached? %>
                  <%= image_tag @listing.user.avatar, class: "rounded-circle", style: "width: 48px; height: 48px; object-fit: cover;" %>
                <% else %>
                  <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                    <span class="text-white fw-bold"><%= @listing.user.first_name&.first&.upcase %></span>
                  </div>
                <% end %>
                <div>
                  <p class="fw-semibold mb-0" style="color: #0B1B33;">
                    <%= link_to "#{@listing.user.first_name} #{@listing.user.last_name&.first}.", profile_path(@listing.user), style: "color: #2F6BFF; text-decoration: none;" %>
                  </p>
                  <p class="text-muted small mb-0"><%= @listing.user.city.presence || "Location not specified" %></p>
                </div>
              </div>

              <%# Listing details %>
              <h5 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Job Details</h5>
              <div class="mb-4 pb-4" style="border-bottom: 1px solid #E2E8F0;">
                <% if @listing.urgency.present? %>
                  <p class="mb-2 small"><strong>Urgency:</strong> <%= @listing.urgency.capitalize %></p>
                <% end %>
                <% if @listing.preferred_date_and_time.present? %>
                  <p class="mb-2 small"><strong>Preferred Date:</strong> <%= @listing.preferred_date_and_time.strftime("%b %d, %Y at %H:%M") %></p>
                <% end %>
                <% if @listing.availability_profile.present? %>
                  <p class="mb-0 small"><strong>Availability:</strong> <%= @listing.availability_profile %></p>
                <% end %>
              </div>

              <%# CTA %>
              <% user_offer = @listing.offers.find_by(user: current_user) %>
              <% if (@listing.listing_status.nil? || @listing.listing_status == 'open') && user_offer.nil? %>
                <%= link_to new_listing_offer_path(@listing), class: "btn btn-primary w-100 py-2 fw-semibold", style: "background-color: #2F6BFF; border-radius: 12px; border: none;" do %>
                  <i class="bi bi-stars me-1"></i> Submit Offer
                <% end %>
              <% elsif user_offer.present? %>
                <p class="text-muted small text-center mb-2">You already submitted an offer.</p>
                <%= link_to "View My Offer →", listing_offer_path(@listing, user_offer), class: "btn btn-outline-primary w-100", style: "border-radius: 12px;" %>
              <% else %>
                <p class="text-muted small text-center">This job is no longer accepting offers.</p>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% # DELETE MODAL (Customized to match your Handyman design) %>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 20px; border: none; padding: 1rem;">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold" style="font-family: 'Outfit', sans-serif;">Delete Listing?</h5>
      </div>
      <div class="modal-body text-muted">
        Are you sure? This action cannot be undone and your job will be removed permanently.
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
        <%= button_to "Delete Permanently", listing_path(@listing), method: :delete, class: "btn btn-danger rounded-pill px-4" %>
      </div>
    </div>
  </div>
</div>

<style>
  .object-cover { object-fit: cover; }
  .text-muted-hover:hover { color: #0B1B33 !important; }
</style>
