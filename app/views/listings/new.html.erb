<%# Main structural wrapper matching the premium SaaS design %>
<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 800px;">

    <%# ==================== 1. PREMIUM HEADER SECTION ==================== %>
    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom" style="border-color: #E2E8F0;">
      <div>
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-pill fw-semibold" style="font-size: 11px; letter-spacing: 0.5px; background-color: #EFF6FF; color: #2F6BFF;">
            <i class="bi bi-plus-circle-fill"></i> New Project
          </span>
        </div>
        <h1 class="tracking-tight font-semibold m-0" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2.2rem; letter-spacing: -0.5px;">
          Post a New Job Listing
        </h1>
      </div>
      <div>
        <%= link_to dashboard_path, class: "btn btn-sm btn-light border px-3 py-2 fw-semibold text-muted shadow-sm", style: "border-radius: 9999px; font-size: 13px;" do %>
          <i class="bi bi-arrow-left me-1"></i> Cancel
        <% end %>
      </div>
    </div>

    <%# ==================== 2. PREMIUM CARD LOAD PARTIAL WITH CUSTOM WRAPPER CLASS ==================== %>
    <%# The step-indicator inside _form.html.erb will be styled perfectly by the scoped CSS rules below %>
    <div class="saas-form-wrapper">
      <%= render "form" %>
    </div>

  </div>
</div>

<%# ==================== 3. CLEAN CSS SAAS DESIGN LAYER ==================== %>
<style>
  /* Scopes the simple_form safely using higher CSS specificity hierarchy */
  .saas-form-wrapper .simple_form {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02);
    margin-top: 25px;
  }

  /* Core step headings style alignment */
  .saas-form-wrapper .form-step h2 {
    font-family: 'Outfit', sans-serif;
    color: #0B1B33;
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.5px;
    margin-bottom: 12px;
    margin-top: 15px;
  }

  /* Inner step subtext descriptions */
  .saas-form-wrapper .form-step p {
    color: #64748B;
    font-size: 14px;
    margin-bottom: 25px;
  }

  /* Form components formatting */
  .saas-form-wrapper .form-step input[type="text"],
  .saas-form-wrapper .form-step input[type="string"],
  .saas-form-wrapper .form-step input[type="email"],
  .saas-form-wrapper .form-step textarea,
  .saas-form-wrapper .form-step select {
    border-radius: 12px;
    border: 1px solid #E2E8F0;
    padding: 0.8rem 1rem;
    font-size: 14px;
    margin-bottom: 15px;
    background-color: #FFFFFF;
    width: 100%;
  }

  /* Input fields focusing effects */
  .saas-form-wrapper .form-step input:focus,
  .saas-form-wrapper .form-step textarea:focus,
  .saas-form-wrapper .form-step select:focus {
    border-color: #2F6BFF;
    box-shadow: 0 0 0 3px rgba(47, 107, 255, 0.1);
    outline: none;
  }

  /* Core operational navigation buttons mapping */
  .saas-form-wrapper .next-btn,
  .saas-form-wrapper .submit-btn,
  .saas-form-wrapper input[type="submit"],
  .saas-form-wrapper .form-step button[type="submit"] {
    background-color: #2F6BFF;
    background: #2F6BFF;
    color: #FFFFFF;
    border-radius: 9999px;
    border: none;
    padding: 12px 28px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
    box-shadow: 0 4px 12px rgba(47, 107, 255, 0.15);
    display: inline-block;
  }

  .saas-form-wrapper .next-btn:hover,
  .saas-form-wrapper .submit-btn:hover,
  .saas-form-wrapper input[type="submit"]:hover {
    background-color: #0B1B33;
    background: #0B1B33;
  }

  /* Multi-step back action selectors styling */
  .saas-form-wrapper .prev-btn {
    background-color: #F1F5F9;
    color: #64748B;
    border: 1px solid #E2E8F0;
    border-radius: 9999px;
    padding: 12px 28px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-right: 8px;
  }

  .saas-form-wrapper .prev-btn:hover {
    background-color: #E2E8F0;
    color: #0B1B33;
  }

  /* Form step checkbox alignment blocks */
  .saas-form-wrapper .form-step label:has(input[type="radio"]) {
    display: block;
    padding: 12px 16px;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
    background: #FFFFFF;
  }

  .saas-form-wrapper .form-step label:has(input[type="radio"]):hover {
    background: #F8FAFC;
    border-color: #CBD5E1;
  }

  /* Premium horizontal milestones indicator container box */
  #step-indicator {
    background: #FFFFFF;
    padding: 1rem 1.5rem;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    box-shadow: 0 2px 10px rgba(11, 27, 51, 0.02);
    color: #94A3B8;
    margin-bottom: 25px;
  }
</style>
