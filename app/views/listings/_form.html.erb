<%# Horizontal milestones milestone indicator tracker %>
<div id="step-indicator" class="mb-4">
  <span class="step-label active" id="label-1">1. What</span> &rarr;
  <span class="step-label" id="label-2">2. Category</span> &rarr;
  <span class="step-label" id="label-3">3. Photos</span> &rarr;
  <span class="step-label" id="label-4">4. Details</span> &rarr;
  <span class="step-label" id="label-5">5. Availability</span> &rarr;
  <span class="step-label" id="label-6">6. Location</span>
</div>
<%= simple_form_for(@listing, html: {
  data: { turbo: false },
  # Senior interceptor: Validates the final step active fields during submission to block bad database payloads
  onsubmit: "if(this.dataset.submitting === 'true') { event.preventDefault(); return false; } else { " \
            "  const currentStepEl = document.querySelector('.form-step:not([style*=\"display: none\"])');" \
            "  const inputs = Array.from(currentStepEl.querySelectorAll('input[required], textarea[required], select[required]'));" \
            "  let isValid = true;" \
            "  inputs.forEach(i => { if(!i.value.trim()) { i.classList.add('is-invalid'); isValid = false; } });" \
            "  const err = currentStepEl.querySelector('.step-error-message');" \
            "  if(!isValid) { if(err) { err.innerText = 'Please fill in all location data fields before publishing.'; err.style.display = 'block'; } return false; }" \
            "  this.dataset.submitting = 'true'; return true; " \
            "}" ,
  onkeydown: "if(event.keyCode == 13 && event.target.tagName == 'INPUT') { event.preventDefault(); const visibleStep = document.querySelector('.form-step:not([style*=\"display: none\"])'); const btn = visibleStep ? visibleStep.querySelector('.next-btn') : null; if(btn) { btn.click(); } return false; }"
}) do |f| %>
  <%# SimpleForm block banner commented out to prioritize clean inline alerts %>
  <%#= f.error_notification %>

  <%# STEP 1: PROJECT TITLE SUMMARY %>
  <div class="form-step" id="step-1">
    <h2>What do you need help with?</h2>
    <p>A short, clear description goes a long way.</p>
    <%= f.input :title, placeholder: "e.g. Garden maintenance needed", label: "One-line summary", required: true %>

    <%# Premium Inline SaaS Error Message Slot %>
    <div class="step-error-message text-danger small mb-3 fw-semibold" style="display: none;"></div>

    <button type="button" class="next-btn">Continue &rarr;</button>
  </div>

  <%# STEP 2: TRADE CATEGORY SELECTION %>
  <div class="form-step" id="step-2" style="display: none;">
    <h2>Select the trade category</h2>
    <%= f.association :category, label_method: :name, value_method: :id, prompt: "Choose a category", required: true %>

    <div id="subcategories-container" style="margin-top: 20px; display: none; padding: 15px; border: 1px dashed #ccc; background: #f9f9f9;">
      <h4>Specify your request (Mandatory):</h4>
      <div id="subcategories-list">
        <%# Dynamically filled via JavaScript checkboxes %>
      </div>
    </div>

    <br>
    <%# Premium Inline SaaS Error Message Slot %>
    <div class="step-error-message text-danger small mb-3 fw-semibold" style="display: none;"></div>

    <button type="button" class="prev-btn">&larr; Back</button>
    <button type="button" class="next-btn">Continue &rarr;</button>
  </div>

  <%# STEP 3: OPTIONAL FILE/PHOTO UPLOADS %>
  <div class="form-step" id="step-3" style="display: none;">
    <h2>Add photos or videos</h2>
    <p>A picture saves a thousand calls.</p>
    <%= f.input :photos, as: :file, input_html: { multiple: true, accept: 'image/*' }, label: "Click to upload or drag and drop" %>

    <br>
    <%# Premium Inline SaaS Error Message Slot %>
    <div class="step-error-message text-danger small mb-3 fw-semibold" style="display: none;"></div>

    <button type="button" class="prev-btn">&larr; Back</button>
    <button type="button" class="next-btn">Continue &rarr;</button>
  </div>

  <%# STEP 4: DETAILED DESCRIPTION & VIRTUAL AI ANSWERS %>
  <div class="form-step" id="step-4" style="display: none;">
    <h2>Tell us more details</h2>
    <%= f.input :description, as: :text, placeholder: "Describe the job as best as you can...", input_html: { rows: 5 }, required: true %>

    <%# Premium Inline SaaS Error Message Slot %>
    <div class="step-error-message text-danger small mb-3 fw-semibold" style="display: none;"></div>

    <button type="button" class="prev-btn">&larr; Back</button>
    <button type="button" class="next-btn">Continue &rarr;</button>
  </div>

  <%# STEP 5: AVAILABILITY MATCHING & URGENCY PROFILES %>
  <div class="form-step" id="step-5" style="display: none;">

    <%# --- Section 1: Availability --- %>
    <h2>When does it suit you best?</h2>
    <div class="availability-grid mb-4">
      <% [
        { val: "after_hours_and_weekend", title: "After hours & Weekend", desc: "Workdays from 4 PM + Sat/Sun all day" },
        { val: "completely_flexible", title: "Completely flexible", desc: "Home office / available anytime" },
        { val: "workdays_daytime", title: "Workdays daytime", desc: "Mon–Fri from 8 AM to 4 PM" },
        { val: "other", title: "Other", desc: "Specific schedule / shift work" }
      ].each do |option| %>
        <label class="radio-card">
          <input type="radio" name="listing[availability_profile]" value="<%= option[:val] %>" required class="d-none">
          <div class="card-content">
            <span class="card-title"><%= option[:title] %></span>
            <span class="card-text text-muted small"><%= option[:desc] %></span>
          </div>
        </label>
      <% end %>
    </div>

    <%# Other availability input (linked via JS logic) %>
    <div id="other-availability-container" style="display: none; margin-bottom: 30px;">
      <input type="text" name="listing[ai_answers][custom_availability]" placeholder="Please specify your schedule..." class="form-control" style="border-radius: 12px; padding: 12px; border: 1px solid #E2E8F0;">
    </div>

    <%# --- Section 2: Urgency (Now matching the card style) --- %>
    <h2>How urgent is your request?</h2>
    <div class="availability-grid mb-4">
      <% [
        { val: "emergency", title: "Emergency", desc: "Need help as soon as possible" },
        { val: "this_week", title: "This week", desc: "Flexible within the next few days" },
        { val: "flexible", title: "Flexible", desc: "No rush, anytime" }
      ].each do |option| %>
        <label class="radio-card">
          <input type="radio" name="listing[urgency]" value="<%= option[:val] %>" required class="d-none">
          <div class="card-content">
            <span class="card-title"><%= option[:title] %></span>
            <span class="card-text text-muted small"><%= option[:desc] %></span>
          </div>
        </label>
      <% end %>
    </div>

    <br><br>
    <%# Premium Inline SaaS Error Message Slot %>
    <div class="step-error-message text-danger small mb-3 fw-semibold" style="display: none;"></div>

    <button type="button" class="prev-btn">&larr; Back</button>
    <button type="button" class="next-btn">Continue &rarr;</button>
  </div>

  <%# STEP 6: LOCATION (Smart Pre-fill) %>
  <div class="form-step" id="step-6" style="display: none;">
    <h2>Job Location</h2>
    <p>We've pre-filled this from your profile. Update if the job is located elsewhere.</p>

    <div class="row">
      <div class="col-12 mb-3">
        <%= f.label :street, "Street" %>
        <%# Logik: Nimm die Listing-Straße, wenn vorhanden, sonst die User-Straße %>
        <%= f.text_field :street,
            value: f.object.street.presence || current_user.street,
            class: "form-control" %>
      </div>

      <div class="col-6 mb-3">
        <%= f.label :postcode, "Postcode" %>
        <%= f.text_field :postcode,
            value: f.object.postcode.presence || current_user.postcode,
            class: "form-control" %>
      </div>

      <div class="col-6 mb-3">
        <%= f.label :city, "City" %>
        <%= f.text_field :city,
            value: f.object.city.presence || current_user.city,
            class: "form-control" %>
      </div>
      <div class="col-6 mb-3">
        <%= f.label :country, "Country" %>
        <%= f.text_field :country,
            value: f.object.country.presence || current_user.country.presence || "United Kingdom",
            class: "form-control" %>
      </div>
    </div>

    <button type="button" class="prev-btn">&larr; Back</button>
    <%= f.submit "Post Listing", class: "submit-btn" %>
  </div>

<% end %>



<script>
  function initializeMultiStepForm() {
    const steps = Array.from(document.querySelectorAll(".form-step"));
    const nextButtons = document.querySelectorAll(".next-btn");
    const prevButtons = document.querySelectorAll(".prev-btn");
    const indicator = document.getElementById("step-indicator");

    const isEditMode = <%= @listing.persisted? %>;

    if (isEditMode) {
      steps.forEach(step => step.style.display = "block");
      nextButtons.forEach(btn => btn.style.display = "none");
      prevButtons.forEach(btn => btn.style.display = "none");
      if (indicator) indicator.style.display = "none";
      return;
    }

    let currentStep = 0;

    const getCategorySelect = () => document.querySelector('select[name^="listing[category"]');
    const getTitleInput = () => document.querySelector('input[name="listing[title]"]');
    const getDescriptionArea = () => document.querySelector('textarea[name="listing[description]"]');

    const keywordMapping = {
      "plumbing, heating & ac": ["water", "faucet", "pipe", "shower", "wc", "toilet", "heating", "leak", "sink", "boiler"],
      "electrical & smart home": ["power", "cable", "lamp", "socket", "light", "switch", "electricity", "wire", "oven"],
      "woodwork & carpentry": ["wood", "cabinet", "table", "bed", "door", "window", "assembly", "kitchen", "furniture", "wardrobe"],
      "painting & drywall": ["paint", "wall", "color", "wallpaper", "plaster", "ceiling"],
      "construction, tiling & flooring": ["tile", "floor", "laminat", "parquet", "masonry", "brick"],
      "garden & outdoor": ["garden", "lawn", "tree", "fence", "hedge", "patio", "roof"],
      "locksmith & security": ["lock", "key", "door lock", "locksmith", "safe", "security", "schloss"],
      "moving & clearance": ["move", "moving", "box", "transport", "clearance", "furniture moving", "truck", "carrying"],
      "cleaning services": ["clean", "cleaning", "window clean", "wash", "vacuum", "maid"]
    };

    const subcategoryMapping = {
      "plumbing, heating & ac": ["Fix a leak", "Unclog a drain", "Install a faucet", "Repair radiator/heating", "Boiler maintenance"],
      "electrical & smart home": ["Hang a lamp/light", "Fix an outlet/switch", "Connect kitchen oven", "Smart Home setup", "Rewiring"],
      "woodwork & carpentry": ["Assemble IKEA furniture", "Repair cabinet/door", "Build a terrace/deck", "Fix wooden floor"],
      "painting & drywall": ["Paint entire room", "Wallpapering", "Plaster a hole", "Paint doors/windows"],
      "construction, tiling & flooring": ["Lay laminate/parquet", "Tile a bathroom", "Minor brick/masonry work"],
      "garden & outdoor": ["Lawn mowing & care", "Hedge & tree trimming", "Patio power-washing", "Weeding & planting", "Fence repair"],
      "locksmith & security": ["Emergency lockout", "Change door cylinder", "Install window locks"],
      "moving & clearance": ["Carry heavy items/furniture", "Full apartment move", "Basement clearance/entruempelung"],
      "cleaning services": ["End of tenancy clean", "Window cleaning", "Regular house cleaning"]
    };


    function handleSubcategories() {
      const categorySelect = getCategorySelect();
      const subContainer = document.getElementById("subcategories-container");
      const subList = document.getElementById("subcategories-list");

      if (!categorySelect || !subContainer || !subList) return;

      const selectedOption = categorySelect.options[categorySelect.selectedIndex];
      const currentCategoryName = selectedOption ? selectedOption.text.toLowerCase().trim() : "";

      const subchoices = subcategoryMapping[currentCategoryName];

      if (subchoices && subchoices.length > 0) {
        subList.innerHTML = "";
        subchoices.forEach(sub => {
          const div = document.createElement("div");
          div.className = "form-check";
          // ADDED: Inputs mapped directly with required attribute bindings to enforce dynamic state validation
          div.innerHTML = `
            <label class="form-check-label cursor-pointer fw-normal">
              <input type="checkbox" class="form-check-input sub-cb" value="${sub}" required> ${sub}
            </label>
          `;
          subList.appendChild(div);
        });
        subContainer.style.display = "block";
      } else {
        subContainer.style.display = "none";
      }
    }

    const categorySelectEl = getCategorySelect();
    if (categorySelectEl) {
      categorySelectEl.addEventListener("change", handleSubcategories);
    }

    function autoSelectCategory() {
      const titleInput = getTitleInput();
      const categorySelect = getCategorySelect();

      if (!titleInput || !categorySelect) return;
      const titleValue = titleInput.value.toLowerCase();

      for (const [categoryName, keywords] of Object.entries(keywordMapping)) {
        const hasKeyword = keywords.some(keyword => titleValue.includes(keyword));

        if (hasKeyword) {
          const options = Array.from(categorySelect.options);
          const matchingOption = options.find(opt => opt.text.toLowerCase().trim() === categoryName.toLowerCase().trim());

          if (matchingOption) {
            categorySelect.value = matchingOption.value;
            break;
          }
        }
      }
    }

    function injectSubcategoriesToDescription() {
      const checkedBoxes = document.querySelectorAll(".sub-cb:checked");
      const descriptionArea = getDescriptionArea();

      if (checkedBoxes.length > 0 && descriptionArea) {
        let textToAdd = "Selected requirements:\n";
        checkedBoxes.forEach(cb => { textToAdd += `- ${cb.value}\n`; });
        textToAdd += "\nAdditional details: ";

        if (!descriptionArea.value.includes("Selected requirements:")) {
          descriptionArea.value = textToAdd + descriptionArea.value;
        }
      }
    }

    function updateFormSteps() {
      // 1. Hide/Show the correct step
      steps.forEach((step, index) => {
        step.style.display = index === currentStep ? "block" : "none";
      });

      // 2. Update the indicator labels using classes
      steps.forEach((_, index) => {
        const label = document.getElementById(`label-${index + 1}`);
        if (label) {
          // Remove all status classes first
          label.classList.remove("active", "done");

          if (index === currentStep) {
            // This is the step the user is currently on
            label.classList.add("active");
          } else if (index < currentStep) {
            // These steps are already finished
            label.classList.add("done");
          }
        }
      });
    }

    const step5Container = document.getElementById("step-5");
    if (step5Container) {
      step5Container.addEventListener("change", (e) => {
        if (e.target && e.target.name === "listing[availability_profile]") {
          const otherContainer = document.getElementById("other-availability-container");
          if (otherContainer) {
            otherContainer.style.display = e.target.value === "other" ? "block" : "none";
          }
        }
      });
    }

    // Step-by-step controller loop interceptor
    nextButtons.forEach(button => {
      button.addEventListener("click", (event) => {
        event.preventDefault();

        // 1. Gather input nodes belonging directly to the current view step bounds
        const currentStepEl = steps[currentStep];
        const inputs = Array.from(currentStepEl.querySelectorAll("input[required], textarea[required], select[required]"));

        let isStepValid = true;

        // 2. Custom Checkbox verification logic specifically for step 2 criteria bounds
        if (currentStep === 1) {
          const checkboxes = currentStepEl.querySelectorAll(".sub-cb");
          if (checkboxes.length > 0) {
            const checkedBoxes = currentStepEl.querySelectorAll(".sub-cb:checked");
            const subContainerBox = document.getElementById("subcategories-container");
            if (checkedBoxes.length === 0) {
              isStepValid = false;
              if (subContainerBox) subContainerBox.style.borderColor = "#EF4444";
            } else {
              if (subContainerBox) subContainerBox.style.borderColor = "#2F6BFF";
            }
          }
        }

        // 3. Scan inputs to verify length data strings exist
        inputs.forEach(input => {
          if (input.type === "radio") {
            const radioGroup = currentStepEl.querySelectorAll(`input[name="${input.name}"]:checked`);
            if (radioGroup.length === 0) {
              isStepValid = false;
              input.closest(".custom-radio-group")?.classList.add("is-invalid-group");
            }
          } else if (input.type !== "checkbox" && !input.value.trim()) {
            isStepValid = false;
            input.classList.add("is-invalid");

            input.addEventListener("input", () => {
              input.classList.remove("is-invalid");
            }, { once: true });
          }
        });

        // 4. Premium Inline SaaS Error Messaging block
        const errorMessageContainer = currentStepEl.querySelector(".step-error-message");

        if (!isStepValid) {
          if (errorMessageContainer) {
            errorMessageContainer.innerText = "Please fill out all required parts inside this step before shifting forward.";
            errorMessageContainer.style.display = "block";
            errorMessageContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
          return; // Strictly halts iteration blocks
        } else {
          if (errorMessageContainer) {
            errorMessageContainer.style.display = "none";
          }
        }

        if (currentStep === 0) {
          autoSelectCategory();
          const categorySelect = getCategorySelect();
          if (categorySelect) {
            categorySelect.dispatchEvent(new Event('change'));
          }
        }

        if (currentStep < steps.length - 1) {
          currentStep++;
          updateFormSteps();
        }
      });
    });

    prevButtons.forEach(button => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        if (currentStep > 0) {
          currentStep--;
          updateFormSteps();
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initializeMultiStepForm);
  document.addEventListener("turbo:load", initializeMultiStepForm);
</script>
