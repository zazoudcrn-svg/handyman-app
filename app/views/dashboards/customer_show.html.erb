<%
  # The original logic remains unchanged
  open_requests   = @listings.select { |l| l.offers.empty? }
  offers_received = @listings.select { |l| l.offers.any? && l.offers.none? { |o| o.booking.present? } }
  booked_jobs     = @listings.select { |l| l.offers.any? { |o| o.booking.present? && o.booking.booking_status != 'completed' } }
  past_jobs       = @listings.select { |l| l.offers.any? { |o| o.booking.present? && o.booking.booking_status == 'completed' } }

  # We combine them into one stream so all are displayed
  all_listings = open_requests + offers_received + booked_jobs + past_jobs
%>

<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1200px;">

    <% # Header Section %>
    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom" style="border-color: #E2E8F0 !important;">
      <div>
        <h1 class="tracking-tight font-semibold m-0" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2.5rem; letter-spacing: -1px;">
          Welcome to your Handyman Dashboard!
        </h1>
        <p class="text-muted small m-0 mt-1" style="font-size: 15px; color: #64748B !important;">
          Manage your project requests and coordinate your bookings all in one place.
        </p>
      </div>
      <div>
        <%= link_to new_listing_path, class: "btn px-4 py-2.5 text-white fw-semibold custom-primary-btn", style: "background-color: #2F6BFF; border-radius: 9999px; border: none; font-family: 'Outfit', sans-serif; font-size: 14px;" do %>
          Create a New Listing <i class="bi bi-plus-lg ms-1"></i>
        <% end %>
      </div>
    </div>

    <% # Listing Stream (No tabs, just the cards) %>
    <div class="row g-4">
      <% all_listings.each do |listing| %>
        <div class="col-12">
          <div class="card border-0 overflow-hidden custom-dashboard-card" style="background-color: #FFFFFF; border: 1px solid #E2E8F0 !important; border-radius: 16px; box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02);">
            <div class="row g-0">

              <% # Image Block (Your original logic) %>
              <div class="col-md-4 position-relative" style="min-height: 220px; background-color: #E2E8F0; display: flex; align-items: center; justify-content: center;">
                <% if listing.photos.attached? && listing.photos.first.present? %>
                  <%= cl_image_tag listing.photos.first.key, class: "w-100 h-100 object-cover position-absolute top-0 start-0" %>
                <% else %>
                  <% image_path = if listing.title.include?("EMERGENCY") then "listings/burst_pipe.png"
                                   elsif listing.title.downcase.include?("sink") then "listings/kitchen_sink.png"
                                   elsif listing.title.downcase.include?("boiler") then "listings/boiler_repair.png"
                                   elsif listing.title.downcase.include?("radiator") then "listings/radiator_valve.png"
                                   elsif listing.title.downcase.include?("shower") then "listings/shower_seal.png"
                                   else nil end %>
                  <% if image_path.present? %>
                    <%= image_tag image_path, class: "w-100 h-100 object-cover position-absolute top-0 start-0" %>
                  <% else %>
                    <i class="bi bi-camera" style="font-size: 3rem; color: #94A3B8;"></i>
                  <% end %>
                <% end %>
              </div>

              <% # Content Block %>
              <div class="col-md-8 p-4 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <span class="badge border text-capitalize px-3 py-1.5" style="border-radius: 6px; background-color: #FFFFFF; color: #64748B; font-size: 11px; border-color: #E2E8F0 !important;">
                      <%= listing.category&.name %>
                    </span>
                  </div>
                  <h3 class="fw-bold tracking-tight mb-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 1.4rem;">
                    <%= link_to listing.title, listing_path(listing), class: "text-decoration-none text-dark hover-blue-text" %>
                  </h3>
                  <p class="text-muted small mb-0 text-clamp-2" style="line-height: 1.5; color: #64748B !important;"><%= listing.description %></p>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top" style="border-color: rgba(226, 232, 240, 0.6) !important;">
                  <div class="d-flex align-items-center gap-2 text-muted small">
                    <i class="bi bi-geo-alt-fill" style="color: #2F6BFF;"></i>
                    <span class="fw-medium text-dark"><%= listing.postcode %> <%= listing.city %></span>
                  </div>
                  <div class="d-flex gap-2">
                    <%= link_to "Edit", edit_listing_path(listing), class: "btn btn-sm btn-light border px-3 py-2 fw-semibold text-muted", style: "border-radius: 9999px; font-size: 13px;" %>
                    <%= link_to "Delete", listing_path(listing), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-light border px-3 py-2 fw-semibold text-danger", style: "border-radius: 9999px; font-size: 13px;" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
