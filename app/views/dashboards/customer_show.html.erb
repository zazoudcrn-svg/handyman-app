<%
  # Filter listings by digging safely through the offers association to see booking statuses
  open_requests   = @listings.select { |l| l.offers.empty? }
  offers_received = @listings.select { |l| l.offers.any? && l.offers.none? { |o| o.booking.present? } }
  booked_jobs     = @listings.select { |l| l.offers.any? { |o| o.booking.present? && o.booking.booking_status != 'completed' } }
  past_jobs       = @listings.select { |l| l.offers.any? { |o| o.booking.present? && o.booking.booking_status == 'completed' } }
%>

<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1200px;">

    <% # 1. HEADER SECTION %>
    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom" style="border-color: #E2E8F0 !important;">
      <div>
        <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-pill fw-semibold" style="font-size: 11px; background-color: #EFF6FF; color: #2F6BFF !important;">
          <i class="bi bi-person-fill"></i> Client Account
        </span>
        <h1 class="h2 mt-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Welcome to your Handyman Dashboard!</h1>
        <p class="text-muted small">Manage your project requests, track incoming offers, and coordinate your bookings.</p>
      </div>
      <%= link_to new_listing_path, class: "btn px-4 py-2.5 text-white fw-semibold custom-primary-btn", style: "background-color: #2F6BFF; border-radius: 9999px;" do %>
        Create a New Listing <i class="bi bi-plus-lg ms-1"></i>
      <% end %>
    </div>

    <% # 2. MODERN FILTER NAVIGATION %>
    <div class="d-flex align-items-center flex-wrap gap-3 mb-4" id="customerDashboardTabs" role="tablist">
      <span class="text-uppercase fw-bold" style="font-size: 10px; color: #94A3B8; letter-spacing: 0.05em; margin-right: 5px;">Filter:</span>

      <% tabs = [
        { id: "open-requests", label: "Open Requests", count: open_requests.size },
        { id: "offers-received", label: "Offers Received", count: offers_received.size },
        { id: "booked-jobs", label: "Booked Jobs", count: booked_jobs.size },
        { id: "past-jobs", label: "Past Jobs", count: past_jobs.size }
      ] %>

      <% tabs.each_with_index do |tab, index| %>
        <button class="nav-link btn <%= 'active' if index == 0 %> custom-filter-btn"
                id="<%= tab[:id] %>-tab" data-bs-toggle="tab" data-bs-target="#<%= tab[:id] %>"
                type="button" role="tab" aria-selected="<%= index == 0 %>">
          <%= tab[:label] %>
          <span class="badge rounded-pill ms-1" style="font-size: 10px;"><%= tab[:count] %></span>
        </button>
      <% end %>
    </div>

    <% # 3. TABS CONTENT SECTION %>
    <div class="tab-content" id="customerDashboardTabsContent">

      <div class="tab-pane fade show active" id="open-requests" role="tabpanel">
        <div class="row g-4">
          <% open_requests.each do |listing| %>
            <%= render 'shared/listing_card', listing: listing, badge_text: "Waiting for Offers", action_path: listing_path(listing), link_label: "View Details" %>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="offers-received" role="tabpanel">
        <div class="row g-4">
          <% offers_received.each do |listing| %>
            <%= render 'shared/listing_card', listing: listing, badge_text: "Action Required: Offers In!", badge_style: "background-color: #EFF6FF; color: #2F6BFF;", action_path: listing_offer_path(listing, listing.offers.first), link_label: "View Offer & Chat →" %>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="booked-jobs" role="tabpanel">
        <div class="row g-4">
          <% booked_jobs.each do |listing| %>
            <%= render 'shared/listing_card', listing: listing, badge_text: "Confirmed Booking", badge_style: "background-color: #10B981; color: #FFFFFF;", action_path: booking_path(listing.offers.find { |o| o.booking.present? }&.booking), link_label: "Open Booking & Chat →" %>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="past-jobs" role="tabpanel">
        <div class="row g-4">
          <% past_jobs.each do |listing| %>
            <%= render 'shared/listing_card', listing: listing, badge_text: "Completed", badge_style: "background-color: #F1F5F9; color: #64748B;", action_path: booking_path(listing.offers.find { |o| o.booking.present? }&.booking), link_label: "View History & Review" %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>

<% # CUSTOM CSS %>
<style>
  .custom-filter-btn {
    border-radius: 9999px !important; font-family: 'Outfit', sans-serif; font-size: 13px; padding: 6px 16px !important;
    background-color: #F8FAFC !important; color: #64748B !important; border: 1px solid #E2E8F0 !important; transition: all 0.2s ease;
  }
  .custom-filter-btn.active { background-color: #2F6BFF !important; color: #FFFFFF !important; border-color: #2F6BFF !important; }
  .custom-filter-btn .badge { background-color: #F1F5F9; color: #475569; }
  .custom-filter-btn.active .badge { background-color: rgba(255, 255, 255, 0.25); color: #FFFFFF; }
  .custom-primary-btn:hover { background-color: #0B1B33 !important; }
  .custom-dashboard-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .custom-dashboard-card:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(11, 27, 51, 0.05) !important; }
  .text-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
