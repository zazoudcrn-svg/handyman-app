<% is_calendar_active = params[:start_date].present? || params[:prev_date].present? || params[:date].present? %>

<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1200px;">

    <% # 1. PREMIUM HEADER SECTION %>
    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom" style="border-color: #E2E8F0 !important;">
      <div>
        <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-pill fw-semibold" style="font-size: 11px; background-color: #EFF6FF; color: #2F6BFF !important;">
          <i class="bi bi-patch-check-fill"></i> Active Contractor
        </span>
        <h1 class="h2 mt-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33;"><%= current_user.contractor_profile&.business_name || "Workspace" %></h1>
      </div>
    </div>

    <% # 2. MODERN FILTER NAVIGATION (Contractor Version) %>
    <div class="d-flex align-items-center flex-wrap gap-3 mb-4" id="dashboardTabs" role="tablist">
      <span class="text-uppercase fw-bold" style="font-size: 10px; color: #94A3B8; letter-spacing: 0.05em; margin-right: 5px;">Filter:</span>

      <% tabs = [
        { id: "available", label: "Available Jobs", count: @available_listings.size },
        { id: "offered", label: "My Offers", count: @offered_listings.size },
        { id: "bookings", label: "Ongoing Bookings", count: @ongoing_bookings.size },
        { id: "completed", label: "Completed", count: @completed_bookings.size },
        { id: "calendar-view", label: "My Schedule", count: nil },
        { id: "archived", label: "Archived", count: @archived_listings.size }
      ] %>

      <% tabs.each_with_index do |tab, index| %>
        <button class="nav-link btn <%= 'active' if (index == 0 && !is_calendar_active) || (tab[:id] == 'calendar-view' && is_calendar_active) %> custom-filter-btn"
                id="<%= tab[:id] %>-tab" data-bs-toggle="tab" data-bs-target="#<%= tab[:id] %>"
                type="button" role="tab">
          <%= tab[:label] %>
          <% if tab[:count] %>
            <span class="badge rounded-pill ms-1" style="font-size: 10px;"><%= tab[:count] %></span>
          <% end %>
        </button>
      <% end %>
    </div>

    <% # 3. TABS CONTENT SECTION %>
    <div class="tab-content" id="dashboardTabsContent">

      <div class="tab-pane fade <%= 'show active' unless is_calendar_active %>" id="available" role="tabpanel">
        <div class="row g-4">
          <% @available_listings.each do |listing| %>
            <%= render 'shared/listing_card',
                listing: listing,
                badge_text: listing.title.include?("EMERGENCY") ? "Emergency" : "New Job",
                badge_style: listing.title.include?("EMERGENCY") ? "background-color: #EF4444; color: #FFFFFF;" : "background-color: #F1F5F9; color: #475569;",
                action_path: listing_path(listing, from: 'available'),
                link_label: "View Details →" %>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="offered" role="tabpanel">
        <div class="row g-4">
          <% @offered_listings.each do |listing| %>
            <%= render 'shared/listing_card',
                listing: listing,
                badge_text: "Offer Sent",
                action_path: listing_path(listing, from: 'offered'),
                link_label: "Review Offer →" %>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="bookings" role="tabpanel">
        <div class="row g-4">
          <% @ongoing_bookings.each do |listing| %>
            <%= render 'shared/listing_card',
                listing: listing,
                badge_text: "Confirmed Booking",
                badge_style: "background-color: #2F6BFF; color: #FFFFFF;",
                action_path: listing_path(listing, from: 'bookings'),
                link_label: "Manage Job →" %>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="completed" role="tabpanel">
        <div class="row g-4">
          <% @completed_bookings.each do |listing| %>
            <%= render 'shared/listing_card',
                listing: listing,
                badge_text: "Job Completed",
                badge_style: "background-color: #F1F5F9; color: #64748B;",
                action_path: listing_path(listing, from: 'completed'),
                link_label: "View Archive" %>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade <%= 'show active' if is_calendar_active %>" id="calendar-view" role="tabpanel">
        <div class="card p-4 border-0" style="border-radius: 16px; border: 1px solid #E2E8F0 !important;">
          <h3 class="fw-bold mb-4">Weekly Workspace Schedule</h3>
          <%= week_calendar(number_of_weeks: 1, events: @bookings, attribute: :scheduled_date_and_time) do |date, bookings| %>
            <div class="text-muted small fw-bold mb-2 text-uppercase" style="font-size: 11px;"><%= date.strftime("%a %d") %></div>
            <div class="d-flex flex-column gap-2" style="min-height: 140px;">
              <% bookings.each do |booking| %>
                <div class="p-2 rounded shadow-sm border-start border-4" style="background-color: #0B1B33; color: #FFFFFF; border-left-color: #2F6BFF;">
                  <div class="small fw-bold" style="font-size: 0.75rem;"><%= booking.listing.title %></div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="archived" role="tabpanel">
        <div class="row g-4">
          <% @archived_listings.each do |listing| %>
            <%= render 'shared/listing_card',
                listing: listing,
                badge_text: "Declined",
                badge_style: "background-color: #64748B; color: #FFFFFF;",
                action_path: listing_path(listing, from: 'declined'),
                link_label: "View Case" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% # CUSTOM STYLING %>
<style>
  .custom-filter-btn {
    border-radius: 9999px !important; font-family: 'Outfit', sans-serif; font-size: 13px; padding: 6px 16px !important;
    background-color: #F8FAFC !important; color: #64748B !important; border: 1px solid #E2E8F0 !important; transition: all 0.2s ease;
  }
  .custom-filter-btn.active { background-color: #2F6BFF !important; color: #FFFFFF !important; border-color: #2F6BFF !important; }
  .custom-filter-btn .badge { background-color: #F1F5F9; color: #475569; }
  .custom-filter-btn.active .badge { background-color: rgba(255, 255, 255, 0.25); color: #FFFFFF; }
</style>

<script>
  document.addEventListener("turbo:load", function() {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('start_date') || urlParams.has('prev_date') || urlParams.has('date')) {
      document.querySelectorAll('#dashboardTabs .nav-link').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('#dashboardTabsContent .tab-pane').forEach(pane => pane.classList.remove('show', 'active'));
      document.getElementById('calendar-tab').classList.add('active');
      document.getElementById('calendar-view').classList.add('show', 'active');
    }
  });
</script>
