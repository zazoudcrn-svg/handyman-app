<% is_calendar_active = params[:start_date].present? || params[:prev_date].present? || params[:date].present? %>

<%# NEW CODE STARTS HERE %>
<% if @onboarding_incomplete %>
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: #F8FAFC;">
    <div style="text-align: center; padding: 80px 20px;">
    <i class="ti ti-user-check" style="font-size: 64px; color: #2F6BFF; display: block; margin-bottom: 24px;"></i>
    <h2 style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-weight: 700; font-size: 1.8rem; margin-bottom: 12px;">Complete your profile to get started</h2>
    <p style="color: #64748b; font-size: 16px; margin-bottom: 32px;">Finish your onboarding to see available jobs in your area.</p>
    <%= link_to "Complete Onboarding →", onboarding_contractor_path, class: "btn", style: "background: #2F6BFF; color: white; border-radius: 9999px; padding: 12px 28px; font-weight: 600; font-size: 15px;" %>
    </div>
  </div>
<% else %>
<%# NEW CODE ENDS HERE %>

<% listings_json = @available_listings.map { |l|
  {
    id:                   l.id,
    title:                l.title,
    latitude:             l.latitude,
    longitude:            l.longitude,
    urgency:              l.urgency,
    availability_profile: l.availability_profile,
    url:                  listing_path(l, from: "available"),
    photo_url:            l.photos.attached? ? url_for(l.photos.first) : nil,
    city:                 l.city
  }
}.to_json %>

<div class="py-5"
     style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;"
     data-controller="map"
     data-map-token-value="<%= ENV["MAPBOX_API_KEY"] %>"
     data-map-listings-value="<%= listings_json %>">
  <div class="container" style="max-width: 1200px;">

    <% # 1. PREMIUM HEADER SECTION %>
    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom" style="border-color: #E2E8F0 !important;">
      <div>
        <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-pill fw-semibold" style="font-size: 11px; background-color: #EFF6FF; color: #2F6BFF !important;">
          <i class="bi bi-patch-check-fill"></i> Active Contractor
        </span>
        <h1 class="h2 mt-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Find your next Job</h1>
      </div>

      <%# VIEW TOGGLE %>
      <div class="btn-group" role="group" aria-label="View toggle">
        <button type="button"
                class="btn btn-outline-primary active"
                data-map-target="listBtn"
                data-action="click->map#showList">
          <i class="bi bi-grid-3x2-gap me-1"></i> List
        </button>
        <button type="button"
                class="btn btn-outline-primary"
                data-map-target="mapBtn"
                data-action="click->map#showMap">
          <i class="bi bi-map me-1"></i> Map
        </button>
      </div>
    </div>

    <% # 2. FILTER FORM (unchanged) %>
    <%= form_with url: dashboard_path, method: :get, local: true do |f| %>
      <div class="d-flex align-items-center flex-wrap gap-3 mb-4">
        <span class="text-uppercase fw-bold" style="font-size: 10px; color: #94A3B8; letter-spacing: 0.05em;">Filter by:</span>

        <%# CATEGORY — only shown if contractor has more than 1 specialty %>
        <% if current_user.categories.count > 1 %>
          <div class="dropdown">
            <button class="btn custom-filter-btn <%= params[:category_ids].present? ? 'active' : '' %>"
                    type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
              Category
              <% if params[:category_ids].present? %>
                <span class="badge rounded-pill ms-1" style="font-size: 10px;"><%= params[:category_ids].size %></span>
              <% end %>
              <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
            </button>
            <div class="dropdown-menu p-3 shadow-sm" style="min-width: 200px; border-radius: 12px; border: 1px solid #E2E8F0;">
              <% current_user.categories.each do |category| %>
                <div class="form-check mb-2">
                  <%= check_box_tag "category_ids[]",
                      category.id,
                      Array(params[:category_ids]).map(&:to_s).include?(category.id.to_s),
                      class: "form-check-input",
                      id: "category_#{category.id}" %>
                  <%= label_tag "category_#{category.id}", category.name, class: "form-check-label", style: "font-size: 13px;" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# DISTANCE %>
        <div class="dropdown">
          <button class="btn custom-filter-btn <%= params[:max_distance].present? ? 'active' : '' %>"
                  type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
            Distance
            <% if params[:max_distance].present? %>
              <span class="badge rounded-pill ms-1" style="font-size: 10px;"><%= params[:max_distance] %>km</span>
            <% end %>
            <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
          </button>
          <div class="dropdown-menu p-3 shadow-sm" style="min-width: 240px; border-radius: 12px; border: 1px solid #E2E8F0;">
            <p class="mb-2 fw-semibold" style="font-size: 12px; color: #0B1B33;">
              Max distance: <span id="distance-label"><%= params[:max_distance] || current_user.contractor_profile.travel_radius %></span> km
            </p>
            <%= range_field_tag :max_distance,
                params[:max_distance] || current_user.contractor_profile.travel_radius,
                min: 1,
                max: current_user.contractor_profile.travel_radius,
                class: "form-range",
                id: "distance-slider",
                oninput: "document.getElementById('distance-label').innerText = this.value" %>
            <div class="d-flex justify-content-between" style="font-size: 11px; color: #94A3B8;">
              <span>1 km</span>
              <span><%= current_user.contractor_profile.travel_radius %> km</span>
            </div>
          </div>
        </div>

        <%# URGENCY %>
        <div class="dropdown">
          <button class="btn custom-filter-btn <%= params[:urgency].present? ? 'active' : '' %>"
                  type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
            Urgency
            <% if params[:urgency].present? %>
              <span class="badge rounded-pill ms-1" style="font-size: 10px;"><%= params[:urgency].size %></span>
            <% end %>
            <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
          </button>
          <div class="dropdown-menu p-3 shadow-sm" style="min-width: 200px; border-radius: 12px; border: 1px solid #E2E8F0;">
            <% [["Emergency", "emergency"], ["This week", "this_week"], ["Flexible", "flexible"]].each do |label, value| %>
              <div class="form-check mb-2">
                <%= check_box_tag "urgency[]",
                    value,
                    Array(params[:urgency]).include?(value),
                    class: "form-check-input",
                    id: "urgency_#{value}" %>
                <%= label_tag "urgency_#{value}", label, class: "form-check-label", style: "font-size: 13px;" %>
              </div>
            <% end %>
          </div>
        </div>

        <%# AVAILABILITY %>
        <div class="dropdown">
          <button class="btn custom-filter-btn <%= params[:availability_profile].present? ? 'active' : '' %>"
                  type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
            Availability
            <% if params[:availability_profile].present? %>
              <span class="badge rounded-pill ms-1" style="font-size: 10px;"><%= params[:availability_profile].size %></span>
            <% end %>
            <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
          </button>
          <div class="dropdown-menu p-3 shadow-sm" style="min-width: 240px; border-radius: 12px; border: 1px solid #E2E8F0;">
            <% [
              ["After hours & weekends", "after_hours_and_weekend"],
              ["Completely flexible",    "completely_flexible"],
              ["Workdays daytime only",  "workdays_daytime"],
              ["Other",                  "other"]
            ].each do |label, value| %>
              <div class="form-check mb-2">
                <%= check_box_tag "availability_profile[]",
                    value,
                    Array(params[:availability_profile]).include?(value),
                    class: "form-check-input",
                    id: "availability_#{value}" %>
                <%= label_tag "availability_#{value}", label, class: "form-check-label", style: "font-size: 13px;" %>
              </div>
            <% end %>
          </div>
        </div>

        <%# SORT %>
        <div class="dropdown">
          <button class="btn custom-filter-btn <%= params[:sort_by].present? ? 'active' : '' %>"
                  type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
            Sort by
            <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
          </button>
          <div class="dropdown-menu p-3 shadow-sm" style="min-width: 180px; border-radius: 12px; border: 1px solid #E2E8F0;">
            <div class="form-check mb-2">
              <%= radio_button_tag :sort_by, "default", params[:sort_by].blank?, class: "form-check-input", id: "sort_default" %>
              <%= label_tag "sort_default", "Urgency first", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
            <div class="form-check mb-2">
              <%= radio_button_tag :sort_by, "date", params[:sort_by] == "date", class: "form-check-input", id: "sort_date" %>
              <%= label_tag "sort_date", "Most recent", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
            <div class="form-check">
              <%= radio_button_tag :sort_by, "distance", params[:sort_by] == "distance", class: "form-check-input", id: "sort_distance" %>
              <%= label_tag "sort_distance", "Closest first", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
          </div>
        </div>

        <%# APPLY + CLEAR %>
        <%= f.submit "Apply",
            class: "btn btn-primary btn-sm px-4",
            style: "border-radius: 9999px; font-size: 13px;" %>
        <%= link_to "Clear", dashboard_path,
            class: "btn btn-link btn-sm",
            style: "font-size: 13px; color: #94A3B8; text-decoration: none;" %>
        <span class="text-muted" style="font-size: 12px;">
          <%= @available_listings.size %> listing<%= @available_listings.size == 1 ? "" : "s" %> found
        </span>
      </div>
    <% end %>

    <%# 3. LIST VIEW %>
    <div data-map-target="listContainer">
      <div class="row g-4">
        <% if @available_listings.empty? %>
          <div class="col-12">
            <p class="text-muted text-center py-5" style="font-size: 14px;">No listings match your current filters.</p>
          </div>
        <% else %>
          <% @available_listings.each do |listing| %>
            <%= render 'shared/listing_card',
                listing: listing,
                badge_text: listing.urgency == "emergency" ? "Emergency" : "New Job",
                badge_style: listing.urgency == "emergency" ? "background-color: #EF4444; color: #FFFFFF;" : "background-color: #F1F5F9; color: #475569;",
                action_path: listing_path(listing, from: 'available'),
                link_label: "View Listing →" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# 4. MAP VIEW %>
    <div data-map-target="mapContainer"
         class="d-none"
         style="height: 600px; border-radius: 16px; overflow: hidden; border: 1px solid #E2E8F0;">
    </div>

  </div>
</div>

<style>
  .custom-filter-btn {
    border-radius: 9999px !important; font-family: 'Outfit', sans-serif; font-size: 13px; padding: 4px 12px !important;
    background-color: #F8FAFC !important; color: #64748B !important; border: 1px solid #E2E8F0 !important; transition: all 0.2s ease;
    box-shadow: none !important; outline: none !important;
  }
  .custom-filter-btn:focus { box-shadow: none !important; outline: none !important; }
  .custom-filter-btn.active { background-color: #F8FAFC !important; color: #2F6BFF !important; border-color: #2F6BFF !important; }
  .custom-filter-btn .badge { background-color: #EFF6FF; color: #2F6BFF; }
</style>
<% end %>
