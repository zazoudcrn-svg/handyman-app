<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1000px;">

    <% # Navigation Back Link %>
    <div class="mb-4">
      <%= link_to dashboard_path, class: "text-decoration-none d-inline-flex align-items-center gap-2 small fw-medium text-muted-hover", style: "color: #64748B; transition: color 0.2s;" do %>
        <i class="bi bi-arrow-left"></i> Back to Dashboard
      <% end %>
    </div>

    <% # Header %>
    <div class="mb-4">
      <h2 class="fw-bold" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Your Weekly Schedule</h2>
      <p class="text-muted">Manage all your confirmed bookings and completed projects.</p>
    </div>

    <% # Calendar Card %>
    <div class="card p-4 border-0 shadow-sm" style="border-radius: 20px; border: 1px solid #E2E8F0 !important;">
      <%= week_calendar(number_of_weeks: 1, events: @bookings, attribute: :scheduled_date_and_time) do |date, bookings| %>
        <div class="text-muted small fw-bold mb-2 text-uppercase" style="font-size: 11px;"><%= date.strftime("%a %d") %></div>
        <div class="d-flex flex-column gap-2" style="min-height: 140px;">
          <% bookings.each do |booking| %>
            <div class="p-2 rounded shadow-sm event-blue">
              <div class="small fw-bold" style="font-size: 0.75rem;"><%= booking.listing.title %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>

<style>
  .text-muted-hover:hover { color: #0B1B33 !important; }

  /* Navigation Links Style */
  .simple-calendar .calendar-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .simple-calendar .calendar-heading a {
    text-decoration: none;
    color: #2F6BFF;
    font-weight: 600;
    font-size: 14px;
    padding: 6px 12px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    transition: all 0.2s;
  }
  .simple-calendar .calendar-heading a:hover {
    background-color: #EFF6FF;
    border-color: #2F6BFF;
  }
  .simple-calendar .calendar-heading h2 {
    font-size: 18px;
    font-weight: 700;
    color: #0B1B33;
  }
  .simple-calendar table {
    table-layout: fixed; /* Zwingt die Spalten zu einer festen, gleichmäßigen Breite */
    width: 100%;
  }

  /* 1. Ensure the table cells are centered */
  .simple-calendar table td {
    vertical-align: top;
    text-align: center;
  }

  /* 2. Style for the event container - using flexbox to center it */
  .event-blue {
    display: flex !important;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    width: 90%;
    background-color: #2F6BFF !important;
    color: #FFFFFF !important;
    border-left: 4px solid #1D4ED8 !important;
  }
  /* Custom Blue Event Bar */
  .event-blue {
    background-color: #2F6BFF !important;
    color: #FFFFFF !important;
    border-left: 4px solid #1D4ED8 !important;
  }
</style>
