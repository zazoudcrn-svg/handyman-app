<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1000px;">

    <% # 1. Navigation Back Link %>
    <div class="mb-4">
      <%= link_to dashboard_path, class: "text-decoration-none d-inline-flex align-items-center gap-2 small fw-medium text-muted-hover", style: "color: #64748B; transition: color 0.2s;" do %>
        <i class="bi bi-arrow-left"></i> Back to Dashboard
      <% end %>
    </div>

    <% # 2. Header %>
    <div class="mb-4">
      <h2 class="fw-bold" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Your Weekly Schedule</h2>
      <p class="text-muted">Manage all your confirmed bookings and completed projects.</p>
    </div>

    <% # 3. Hier rendern wir jetzt das Kalender-Partial hinein %>
    <%= render "shared/calendar", calendar_bookings: @bookings %>

  </div>
</div>

<style>
  .text-muted-hover:hover { color: #0B1B33 !important; }
</style>
