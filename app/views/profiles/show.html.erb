<div class="container my-4">
  <div class="row g-4 align-items-start">
    <div class="col-lg-6">
      <% if @user.contractor? %>
        <%= render "contractor_profile" %>
      <% else %>
        <%= render "customer_profile" %>
      <% end %>
    </div>
    <div class="col-lg-6">
      <%= render "reviews" %>
    </div>
  </div>
</div>
