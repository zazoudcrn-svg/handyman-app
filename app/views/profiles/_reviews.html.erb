<div class="card p-5 mb-4" style="border: 1px solid #E2E8F0; border-radius: 16px; background: #FFFFFF;">

  <h5 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">
    Reviews received <span class="text-muted fw-normal" style="font-size: 14px;">(<%= @reviews.count %>)</span>
  </h5>

  <% if @reviews.any? %>
    <% @reviews.each_with_index do |review, index| %>
      <div class="<%= 'pb-3 mb-3' if index < @reviews.count - 1 %>"
           style="<%= "border-bottom: 1px solid #E2E8F0;" if index < @reviews.count - 1 %>">

        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-semibold" style="font-size: 14px; color: #0B1B33;">
            <%= review.user.first_name %> <%= review.user.last_name&.first %>.
          </span>
          <span class="text-muted" style="font-size: 12px;"><%= review.created_at.strftime("%b %d, %Y") %></span>
        </div>

        <div class="mb-1" style="color: #2F6BFF; font-size: 14px;">
          <%= "★" * (review.rating || 0) %><span style="color: #E2E8F0;"><%= "★" * (5 - (review.rating || 0)) %></span>
        </div>

        <% if review.content.present? %>
          <p class="mb-0" style="font-size: 14px; color: #475569;"><%= review.content %></p>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="text-muted mb-0" style="font-size: 14px;">No reviews yet.</p>
  <% end %>

</div>
