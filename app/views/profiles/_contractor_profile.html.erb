<div class="card p-5 mb-4" style="border: 1px solid #E2E8F0; border-radius: 16px; background: #FFFFFF;">

  <%# Header: Avatar + Name + Edit button %>
  <div class="d-flex align-items-start gap-4 mb-4">
    <div class="flex-shrink-0">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: "rounded-circle", style: "width: 90px; height: 90px; object-fit: cover;" %>
      <% else %>
        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 90px; height: 90px; background-color: #EFF6FF;">
          <span style="color: #2F6BFF; font-size: 2rem; font-weight: 700;"><%= @user.first_name&.first&.upcase %></span>
        </div>
      <% end %>
    </div>

    <div class="flex-grow-1">
      <h2 class="mb-1 fw-bold" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">
        <%= @contractor_profile&.business_name || @user.first_name %>
      </h2>
      <p class="mb-3" style="font-size: 14px; color: #475569;"><%= @user.bio %></p>

      <% if @user.bio.present? %>
        <p class="mb-3" style="font-size: 14px; color: #475569;"><%= @user.bio %></p>
      <% end %>

      <% if @user.categories.any? %>
        <div class="d-flex flex-wrap gap-2">
          <% @user.categories.each do |category| %>
            <span class="badge rounded-pill" style="background-color: #EFF6FF; color: #2F6BFF; font-size: 11px; font-weight: 600; padding: 5px 10px;">
              <%= category.name %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @is_own_profile %>
      <%= link_to edit_profile_path(@user), class: "btn btn-outline-secondary btn-sm flex-shrink-0", style: "border-radius: 8px;" do %>
        <i class="bi bi-pencil me-1"></i> Edit
      <% end %>
    <% end %>
  </div>

  <%# Stats row %>
  <div class="row text-center mt-4 pt-3" style="border-top: 1px solid #E2E8F0;">
    <div class="col">
      <div class="fw-bold fs-5" style="color: #0B1B33;"><%= @avg_rating.present? ? "#{@avg_rating} ★" : "—" %></div>
      <div class="text-muted small">Avg Rating</div>
    </div>
    <div class="col">
      <div class="fw-bold fs-5" style="color: #0B1B33;"><%= @jobs_completed %></div>
      <div class="text-muted small">Jobs Completed</div>
    </div>
    <div class="col">
      <div class="fw-bold fs-5" style="color: #0B1B33;"><%= @user.city.presence || "—" %></div>
      <div class="text-muted small">Location</div>
    </div>
    <div class="col">
      <div class="fw-bold fs-5" style="color: #0B1B33;"><%= @user.created_at.strftime("%b %Y") %></div>
      <div class="text-muted small">Member Since</div>
    </div>
  </div>

  <%# Availability + working hours %>
  <% if @contractor_profile %>
    <div class="mt-4 pt-3" style="border-top: 1px solid #E2E8F0;">

      <% if @contractor_profile.weekday_availability.present? %>
        <p class="mb-2 fw-semibold" style="font-size: 13px; color: #0B1B33;">Available Days</p>
        <div class="d-flex flex-wrap gap-2 mb-3">
          <% all_days = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"] %>
          <% active_days = @contractor_profile.weekday_availability.split(", ") %>
          <% all_days.each do |day| %>
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle fw-semibold"
                  style="width: 36px; height: 36px; font-size: 12px;
                         background-color: <%= active_days.include?(day) ? '#2F6BFF' : '#F1F5F9' %>;
                         color: <%= active_days.include?(day) ? '#FFFFFF' : '#94A3B8' %>;">
              <%= day %>
            </span>
          <% end %>
        </div>
      <% end %>

      <% if @contractor_profile.start_time && @contractor_profile.end_time %>
        <p class="mb-1" style="font-size: 14px; color: #475569;">
          <i class="bi bi-clock me-1" style="color: #2F6BFF;"></i>
          <%= @contractor_profile.start_time.strftime("%H:%M") %> – <%= @contractor_profile.end_time.strftime("%H:%M") %>
        </p>
      <% end %>

      <% if @contractor_profile.google_business_profile.present? %>
        <% website_url = @contractor_profile.google_business_profile %>
        <% website_url = "https://#{website_url}" unless website_url.start_with?("http://", "https://") %>
        <p class="mb-0 mt-1" style="font-size: 14px;">
          <i class="bi bi-globe me-1" style="color: #2F6BFF;"></i>
          <%= link_to "Visit Website →", website_url, target: "_blank", style: "color: #2F6BFF; text-decoration: none;" %>
        </p>
      <% end %>
    </div>
  <% end %>

  <%# Private info — own profile only %>
  <% if @is_own_profile %>
    <div class="mt-4 pt-3" style="border-top: 1px solid #E2E8F0;">
      <p class="mb-2 fw-semibold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #94A3B8;">Only visible to you</p>
      <p class="mb-1" style="font-size: 14px;"><strong>Email:</strong> <%= @user.email %></p>
      <% if @contractor_profile %>
        <% address = [@user.street, @user.city, @user.postcode, @user.country].compact.join(", ") %>
        <% if address.present? %>
          <p class="mb-1" style="font-size: 14px;"><strong>Address:</strong> <%= address %></p>
        <% end %>
        <% if @contractor_profile.travel_radius.present? %>
          <p class="mb-1" style="font-size: 14px;"><strong>Travel Radius:</strong> <%= @contractor_profile.travel_radius %> km</p>
        <% end %>
      <% end %>
    </div>
  <% end %>

</div>
