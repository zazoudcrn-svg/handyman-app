
<div class="card p-4 mb-4">

  <%# Header: Avatar + Name + Edit button %>
  <div class="d-flex align-items-start gap-4">
    <div class="flex-shrink-0">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: "rounded-circle", style: "width: 90px; height: 90px; object-fit: cover;" %>
      <% else %>
        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
          <span class="text-white fs-3"><%= @user.first_name&.first&.upcase %></span>
        </div>
      <% end %>
    </div>

    <div class="flex-grow-1">
      <h1 class="mb-0"><%= @contractor_profile&.business_name || @user.first_name %></h1>
      <p class="text-muted mb-2"><%= @user.first_name %> <%= @user.last_name %></p>

      <% if @user.bio.present? %>
        <p class="mb-2"><%= @user.bio %></p>
      <% end %>

      <% if @user.categories.any? %>
        <div class="d-flex flex-wrap gap-2">
          <% @user.categories.each do |category| %>
            <span class="badge bg-primary"><%= category.name %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @is_own_profile %>
      <%= link_to "Edit Profile", edit_profile_path(@user), class: "btn btn-outline-secondary btn-sm flex-shrink-0" %>
    <% end %>
  </div>

  <%# Stats row %>
  <div class="row text-center mt-4 border-top pt-3">
    <div class="col">
      <div class="fw-bold fs-5"><%= @avg_rating.present? ? "#{@avg_rating} ★" : "—" %></div>
      <div class="text-muted small">Avg Rating</div>
    </div>
    <div class="col">
      <div class="fw-bold fs-5"><%= @jobs_completed %></div>
      <div class="text-muted small">Jobs Completed</div>
    </div>
    <div class="col">
      <div class="fw-bold fs-5"><%= @user.city.presence || "—" %></div>
      <div class="text-muted small">Location</div>
    </div>
    <div class="col">
      <div class="fw-bold fs-5"><%= @user.created_at.strftime("%b %Y") %></div>
      <div class="text-muted small">Member Since</div>
    </div>
  </div>

  <%# Working hours + Google Business link — visible to all %>
  <% if @contractor_profile %>
    <div class="mt-3 d-flex flex-column gap-1">
      <% if @contractor_profile.start_time && @contractor_profile.end_time %>
        <p class="mb-0">
          <i class="fa-regular fa-clock me-1"></i>
          <%= @contractor_profile.start_time.strftime("%H:%M") %> – <%= @contractor_profile.end_time.strftime("%H:%M") %>
        </p>
      <% end %>
      <% if @contractor_profile.google_business_profile.present? %>
        <p class="mb-0">
          <%= link_to "View Google Business Profile →", @contractor_profile.google_business_profile, target: "_blank" %>
        </p>
      <% end %>
    </div>
  <% end %>

  <%# Private info — own profile only %>
  <% if @is_own_profile %>
    <div class="mt-4 border-top pt-3">
      <p class="text-muted small mb-2">Only visible to you</p>
      <p class="mb-1"><strong>Email:</strong> <%= @user.email %></p>
      <% if @contractor_profile %>
        <% address = [@contractor_profile.street, @contractor_profile.city, @contractor_profile.postcode, @contractor_profile.country].compact.join(", ") %>
        <% if address.present? %>
          <p class="mb-1"><strong>Business Address:</strong> <%= address %></p>
        <% end %>
        <% if @contractor_profile.travel_radius.present? %>
          <p class="mb-1"><strong>Travel Radius:</strong> <%= @contractor_profile.travel_radius %> km</p>
        <% end %>
      <% end %>
    </div>
  <% end %>

</div>
