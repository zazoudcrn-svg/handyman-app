<div class="container mt-5" style="max-width: 750px;">
  <h1 class="mb-4">Customer Onboarding</h1>
  <p class="text-muted">Please complete your profile to continue.</p>

  <%# PREMIUM UX: High-visibility info card for redirected users %>
  <% if flash[:alert] == "Please complete your profile details before creating a project request!" %>
    <div class="card border-0 mb-4 shadow-sm" style="background-color: #FFFBEB; border-left: 5px solid #F59E0B !important; border-radius: 8px;">
      <div class="card-body p-4">
        <div class="d-flex gap-3 align-items-start">
          <div style="font-size: 24px; line-height: 1;">⚠️</div>
          <div>
            <h4 class="fw-bold mb-1" style="color: #B45309; font-size: 16px;">Action Required: Complete Your Profile</h4>
            <p class="mb-0 text-secondary" style="font-size: 14px; line-height: 1.5;">
              To post a new job listing, our craftsmen need to know your general location and contact details.
              Please fill out the quick form below. It takes less than a minute!
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# FORM WRAPPER: Added a subtle border and shadow for a cleaner UI %>
  <div class="p-4 shadow-sm" style="border: 1px solid #e2e8f0; border-radius: 12px; background-color: #ffffff;">
    <%= form_with model: @user, url: update_onboarding_customer_path, method: :patch, local: true do |f| %>

      <div class="mb-3">
        <%= f.label :first_name, "First Name", class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control", required: true,
            oninvalid: "this.setCustomValidity('Please fill out this field.')",
            oninput: "this.setCustomValidity('')" %>
      </div>

      <div class="mb-3">
        <%= f.label :last_name, "Last Name", class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control", required: true,
            oninvalid: "this.setCustomValidity('Please fill out this field.')",
            oninput: "this.setCustomValidity('')" %>
      </div>

      <div class="mb-3">
        <%= f.label :street, "Street & House Number", class: "form-label" %>
        <%= f.text_field :street, class: "form-control", required: true,
            oninvalid: "this.setCustomValidity('Please fill out this field.')",
            oninput: "this.setCustomValidity('')" %>
      </div>

      <div class="row">
        <div class="col-md-3 mb-3">
          <%= f.label :postcode, "Postcode", class: "form-label" %>
          <%= f.text_field :postcode, class: "form-control", required: true,
              oninvalid: "this.setCustomValidity('Please fill out this field.')",
              oninput: "this.setCustomValidity('')" %>
        </div>
        <div class="col-md-5 mb-3">
          <%= f.label :city, "City", class: "form-label" %>
          <%= f.text_field :city, class: "form-control", required: true,
              oninvalid: "this.setCustomValidity('Please fill out this field.')",
              oninput: "this.setCustomValidity('')" %>
        </div>
        <div class="col-md-4 mb-3">
          <%= f.label :country, "Country", class: "form-label" %>
          <%= f.text_field :country, value: "Germany", class: "form-control", required: true,
              oninvalid: "this.setCustomValidity('Please fill out this field.')",
              oninput: "this.setCustomValidity('')" %>

              <%# NEW CODE STARTS HERE %>
          <%= f.country_select :country,
                { priority_countries: ["GB", "DE", "AT", "CH"], include_blank: "Select country" },
                { class: "form-select", required: true,
                  oninvalid: "this.setCustomValidity('Please select your country.')",
                  oninput: "this.setCustomValidity('')" }
          %>
          <%# NEW CODE ENDS HERE %>
        </div>
      </div>

      <div class="d-flex align-items-center justify-content-between mt-4 pt-3" style="border-top: 1px solid #e2e8f0;">
        <%= f.submit "Save profile & continue", class: "btn btn-primary", style: "background-color: #2F6BFF; border-color: #2F6BFF; border-radius: 8px; padding: 8px 25px; font-weight: 500;" %>
        <%= link_to "Skip onboarding for now →", skip_onboarding_path, data: { turbo_method: :patch }, class: "text-muted text-decoration-none small fw-medium", style: "font-size: 13px;" %>
      </div>

    <% end %>
  </div>
</div>
