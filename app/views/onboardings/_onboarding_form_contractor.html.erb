<div id="stepper-bar" style="display: flex; justify-content: space-between; gap: 10px; margin-bottom: 30px;">
  <div class="step-indicator" style="flex: 1; padding: 10px; border-bottom: 4px solid #38bdf8; font-weight: bold; color: #38bdf8;">1. Basic Info</div>
  <div class="step-indicator" style="flex: 1; padding: 10px; border-bottom: 4px solid #ccc; color: #94a3b8;">2. Services</div>
  <div class="step-indicator" style="flex: 1; padding: 10px; border-bottom: 4px solid #ccc; color: #94a3b8;">3. Trust</div>
  <div class="step-indicator" style="flex: 1; padding: 10px; border-bottom: 4px solid #ccc; color: #94a3b8;">4. Location & Radius</div>
  <div class="step-indicator" style="flex: 1; padding: 10px; border-bottom: 4px solid #ccc; color: #94a3b8;">5. Availability</div>
</div>

<hr>

<%= form_with model: @contractor_profile, url: onboarding_contractor_path, method: :patch, html: { novalidate: true } do |f| %>

  <div class="wizard-step">
    <h3>1. Personal & Company Name</h3>
    <%= f.fields_for :user, current_user do |user_fields| %>
      <p>
        <%= user_fields.label :first_name, "First Name" %><br>
      <%# This is our test field with the custom class %>
      <%= user_fields.text_field :first_name, class: "required-field" %>
      </p>
      <p>
        <%= user_fields.label :last_name, "Last Name" %><br>
        <%= user_fields.text_field :last_name, class: "required-field" %>
      </p>
    <% end %>
    <p>
      <%= f.label :business_name, "Official Company Name" %><br>
      <%= f.text_field :business_name, class: "required-field" %>
    </p>
    <p>
      <%= f.label :business_website, "Official Company Website" %><br>
      <%= f.text_field :business_website %>
    </p>
  </div>

  <div class="wizard-step" style="display: none;">
    <h3>2. Core Services & Specialties</h3>
    <p>Select the categories you want to work in:</p>
    <% Category.all.each do |category| %>
      <p>
        <%= check_box_tag "category_ids[]", category.id, current_user.categories.include?(category), id: "category_#{category.id}" %>
        <%= label_tag "category_#{category.id}", category.name %>
      </p>
    <% end %>
  </div>

  <div class="wizard-step" style="display: none;">
    <h3>3. Trust & Marketing</h3>
    <p>
      <%= f.label :google_business_profile, "Google Business Profile Link (Optional)" %><br>
      <%= f.url_field :google_business_profile, placeholder: "https://business.google.com/..." %>
    </p>
  </div>

  <div class="wizard-step" style="display: none;">
    <h3>4. Location & Operating Area</h3>
    <%= f.fields_for :user, current_user do |user_fields| %>
      <p>
        <%= user_fields.label :street, "Business Street & House Number" %><br>
        <%= user_fields.text_field :street, class: "required-field" %>
      </p>
      <p>
        <%= user_fields.label :postcode, "Postcode" %><br>
        <%= user_fields.text_field :postcode, id: "wizard-postcode", class: "required-field" %>
      </p>
      <p>
        <%= user_fields.label :city, "City" %><br>
        <%= user_fields.text_field :city, id: "wizard-city", class: "required-field" %>
      </p>
      <p>
        <%= user_fields.label :country, "Country", class: "form-label" %><br>
        <%= user_fields.country_select :country,
              { priority_countries: ["GB", "DE", "AT", "CH"], include_blank: "Please select your country" },
              { class: "form-select required-field", id: "wizard-country" }
        %>
      </p>
    <% end %>
    <p>
      <%= f.label :travel_radius, "Travel Radius (in km)" %><br>
      <%= f.number_field :travel_radius, value: 50, min: 1, max: 500, id: "wizard-radius", class: "required-field" %> km
    </p>

    <div id="map" style="height: 300px; width: 100%; margin-top: 20px; border-radius: 8px; border: 1px solid #ccc; z-index: 1;"></div>
  </div>

  <div class="wizard-step" style="display: none;">
    <h3>5. Availability & Working Hours</h3>

    <p><strong>Available Days:</strong></p>
    <%= f.hidden_field :weekday_availability, id: "hidden-weekdays", class: "required-field" %>

    <div style="display: flex; gap: 8px; margin-bottom: 20px;">
    <button type="button" class="day-btn" id="day-btn-mo" data-day="Mo" style="padding: 10px 15px; border: 1px solid #ccc; background: white; border-radius: 20px; cursor: pointer; font-weight: 500;">Mo</button>
    <button type="button" class="day-btn" id="day-btn-tu" data-day="Tu" style="padding: 10px 15px; border: 1px solid #ccc; background: white; border-radius: 20px; cursor: pointer; font-weight: 500;">Tu</button>
    <button type="button" class="day-btn" id="day-btn-we" data-day="We" style="padding: 10px 15px; border: 1px solid #ccc; background: white; border-radius: 20px; cursor: pointer; font-weight: 500;">We</button>
    <button type="button" class="day-btn" id="day-btn-th" data-day="Th" style="padding: 10px 15px; border: 1px solid #ccc; background: white; border-radius: 20px; cursor: pointer; font-weight: 500;">Th</button>
    <button type="button" class="day-btn" id="day-btn-fr" data-day="Fr" style="padding: 10px 15px; border: 1px solid #ccc; background: white; border-radius: 20px; cursor: pointer; font-weight: 500;">Fr</button>
    <button type="button" class="day-btn" id="day-btn-sa" data-day="Sa" style="padding: 10px 15px; border: 1px solid #ccc; background: white; border-radius: 20px; cursor: pointer; font-weight: 500;">Sa</button>
    <button type="button" class="day-btn" id="day-btn-su" data-day="Su" style="padding: 10px 15px; border: 1px solid #ccc; background: white; border-radius: 20px; cursor: pointer; font-weight: 500;">Su</button>
  </div>

    <p>
      <%= f.label :start_time, "Working Hours (Start)" %><br>
      <%= f.time_select :start_time, { default: Time.parse("08:00") } %>
    </p>
    <p>
      <%= f.label :end_time, "Working Hours (End)" %><br>
      <%= f.time_select :end_time, { default: Time.parse("17:00") } %>
    </p>
  </div>

  <br><br>

  <%# ERROR MESSAGE CONTAINER - Styled as a subtle notification box %>
  <div id="validation-error"
      class="text-danger mb-4 p-3 shadow-sm"
      style="display: none; background-color: #FEF2F2; border: 1px solid #FECACA; border-radius: 10px; margin: 0 auto; max-width: 500px;">
    <span class="fw-bold">⚠️ Please fill out all required fields in this step to continue.</span>
  </div>

  <%# Dynamic Steering Navigation Layout %>
  <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 30px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
    <div style="display: flex; gap: 10px;">
      <button type="button" id="prev-btn" class="btn btn-light" style="display: none; border: 1px solid #ccc; border-radius: 8px; padding: 8px 20px; font-weight: 500;">Back</button>
      <button type="button" id="next-btn" class="btn btn-primary" style="background-color: #2F6BFF; border-color: #2F6BFF; border-radius: 8px; padding: 8px 25px; font-weight: 500;">Next</button>
      <%= f.submit "Complete Onboarding & Go to Dashboard", id: "submit-btn", class: "btn btn-success", style: "display: none; background-color: #10B981; border-color: #10B981; border-radius: 8px; padding: 8px 25px; font-weight: 500;" %>
    </div>

    <%# Smart UX Skip Link %>
    <%= link_to "Skip onboarding for now →", skip_onboarding_path, data: { turbo_method: :patch }, id: "skip-link", class: "text-muted text-decoration-none small fw-medium", style: "font-size: 13px;" %>
  </div>

<% end %>

<style>
  /* Only target the country select dropdown specifically by its ID */
  /* This prevents the style from breaking the smaller time_select fields */
  .saas-form-wrapper #wizard-country.form-select {
    border-radius: 12px;       /* Consistent rounded corners */
    border: 1px solid #E2E8F0 ; /* Premium border color */
    padding: 0.8rem 1rem;      /* Consistent padding */
    font-size: 14px;
    color: #0B1B33 ;
    background-color: #FFFFFF;
    background-position: right 1rem center; /* Proper arrow positioning */
  }

  /* Add focus state specifically for the country dropdown */
  .saas-form-wrapper #wizard-country.form-select:focus {
    border-color: #2F6BFF ;
    box-shadow: 0 0 0 3px rgba(47, 107, 255, 0.1);
  }

  /* Style for all day buttons */
/* Styling for your day buttons using your SaaS-Blue */
/* Default State: Light Gray */

  .day-btn {
    background-color: #f1f5f9 !important;
    border: 1px solid #ccc !important;
    color: #64748b !important;
  }
  .day-btn.active {
    background-color: #2F6BFF !important;
    color: #ffffff !important;
    border: 1px solid #2F6BFF !important;
  }

  #next-btn {
  color: #ffffff !important;
  }
</style>
<script>
  (function() {
    function initWizard() {
      let currentStep = 0;
      const steps = document.querySelectorAll(".wizard-step");
      const indicators = document.querySelectorAll(".step-indicator");
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");
      const submitBtn = document.getElementById("submit-btn");

      if (!nextBtn || !prevBtn || steps.length === 0) return;

      // --- MAP SETTINGS ---
      let map = null;
      let mapMarker = null;
      let mapCircle = null;

      // --- WEEKDAY SELECTION ---

      const hiddenInput = document.getElementById("hidden-weekdays");
      const dayBtns = document.querySelectorAll(".day-btn");


      let selectedDays = hiddenInput && hiddenInput.value
        ? hiddenInput.value.split(", ").filter(Boolean)
        : [];


      dayBtns.forEach(btn => {
        if (selectedDays.includes(btn.getAttribute("data-day"))) {
          btn.classList.add("active");
        }
      });


      dayBtns.forEach(btn => {
        btn.addEventListener("click", function(e) {
          e.preventDefault();
          const day = this.getAttribute("data-day");

          this.classList.toggle("active");

          if (this.classList.contains("active")) {
            if (!selectedDays.includes(day)) selectedDays.push(day);
          } else {
            selectedDays = selectedDays.filter(d => d !== day);
          }

          if (hiddenInput) hiddenInput.value = selectedDays.join(", ");
        });
      });


      function showStep() {
        steps.forEach((step, index) => {
          step.style.display = index === currentStep ? "block" : "none";
        });

        indicators.forEach((indicator, index) => {
          if (index === currentStep) {
            indicator.style.borderBottom = "4px solid #38bdf8";
            indicator.style.color = "#38bdf8";
            indicator.style.fontWeight = "bold";
          } else {
            indicator.style.borderBottom = "4px solid #ccc";
            indicator.style.color = "#94a3b8";
            indicator.style.fontWeight = "normal";
          }
        });

        prevBtn.style.display = currentStep === 0 ? "none" : "inline-block";

        // Dynamic skip-link visibility: Only show on Step 1 (index 0)
        const skipLink = document.getElementById("skip-link");
        if (skipLink) {
          skipLink.style.display = currentStep === 0 ? "inline-block" : "none";
        }

        if (currentStep === steps.length - 1) {
          nextBtn.style.display = "none";
          submitBtn.style.display = "inline-block";
        } else {
          nextBtn.style.display = "inline-block";
          submitBtn.style.display = "none";
        }

        // Trigger Leaflet engine dynamic update when entering Step 4
        if (currentStep === 3) {
          setTimeout(() => { setupMap(); }, 50);
        }
      }

      // --- LEAFLET CORE ENGINE ---
      function setupMap() {
        const mapContainer = document.getElementById('map');
        if (!mapContainer) return;

        if (!map) {
          map = L.map('map').setView([51.1657, 10.4515], 6);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
          }).addTo(map);

          document.getElementById('wizard-city').addEventListener('change', updateMapRadius);
          document.getElementById('wizard-postcode').addEventListener('change', updateMapRadius);
          document.getElementById('wizard-radius').addEventListener('input', updateMapRadius);
        } else {
          map.invalidateSize();
        }
        updateMapRadius();
      }

      function updateMapRadius() {
        const city = document.getElementById('wizard-city').value;
        const postcode = document.getElementById('wizard-postcode').value;
        // Access the country dropdown element
        const countrySelect = document.getElementById('wizard-country');

        // Get the selected country text; default to an empty string if nothing is selected
        let country = (countrySelect && countrySelect.selectedIndex > 0)
                      ? countrySelect.options[countrySelect.selectedIndex].text
                      : "";

        // Fallback to "Germany" if the user has not selected a country yet to ensure API search results
        const finalCountry = country === "" ? "Germany" : country;
        const radiusInKm = parseFloat(document.getElementById('wizard-radius').value) || 50;

        if (!city && !postcode) return;

        const searchQuery = `${postcode} ${city}, ${country}`;

        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(searchQuery)}`)
          .then(response => response.json())
          .then(data => {
            if (data && data.length > 0) {
              const lat = parseFloat(data[0].lat);
              const lon = parseFloat(data[0].lon);
              const centerLatLng = [lat, lon];

              map.setView(centerLatLng, 9);

              if (mapMarker) {
                mapMarker.setLatLng(centerLatLng);
              } else {
                mapMarker = L.marker(centerLatLng).addTo(map);
              }

              const radiusInMeters = radiusInKm * 1000;
              if (mapCircle) {
                mapCircle.setLatLng(centerLatLng);
                mapCircle.setRadius(radiusInMeters);
              } else {
                mapCircle = L.circle(centerLatLng, {
                  color: '#38bdf8',
                  fillColor: '#38bdf8',
                  fillOpacity: 0.2,
                  radius: radiusInMeters
                }).addTo(map);
              }

              map.fitBounds(mapCircle.getBounds());
            }
          })
          .catch(err => console.log("Geocoding failed:", err));
      }

      //next button
      nextBtn.addEventListener("click", (e) => {
        e.preventDefault();

        const currentStepElement = steps[currentStep];
        const requiredFields = currentStepElement.querySelectorAll(".required-field");
        let isValid = true;

        requiredFields.forEach(field => {
          if (!field.value.trim()) {
            field.style.borderColor = "red";
            isValid = false;
          } else {
            field.style.borderColor = "#ccc";
          }
        });

        if (currentStep === 1) {
          const checkboxes = currentStepElement.querySelectorAll('input[name="category_ids[]"]');
          const isChecked = Array.from(checkboxes).some(cb => cb.checked);
          if (!isChecked) isValid = false;
        }

        if (isValid) {
          document.getElementById("validation-error").style.display = "none";
          if (currentStep < steps.length - 1) {
            currentStep++;
            showStep();
          }
        } else {
          document.getElementById("validation-error").style.display = "block";
        }
      });

      prevBtn.addEventListener("click", (e) => {
        e.preventDefault();
        if (currentStep > 0) {
          currentStep--;
          showStep();
        }

      });


      // --- RESET BORDER ON INPUT ---
      // This ensures the red border disappears immediately when the user types
      document.querySelectorAll(".required-field").forEach(field => {
        field.addEventListener("input", () => field.style.borderColor = "#ccc");
      });

      showStep();
      }

    if (document.readyState === "loading") {
      document.addEventListener("turbo:load", initWizard);
    } else {
      initWizard();
      document.addEventListener("turbo:load", initWizard);
    }
  })();
</script>
