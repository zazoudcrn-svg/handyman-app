            </span>
            <span class="cd-arrow">▼</span>
          </div>
          <div class="cd-list" id="cdListContractor" role="listbox">
            <div class="cd-option" data-value="United Kingdom" role="option">🇬🇧 United Kingdom</div>
            <div class="cd-option" data-value="Germany" role="option">🇩🇪 Germany</div>
            <div class="cd-option" data-value="Austria" role="option">🇦🇹 Austria</div>
            <div class="cd-option" data-value="Switzerland" role="option">🇨🇭 Switzerland</div>
            <div class="cd-divider"></div>
            <div class="cd-option" data-value="Afghanistan" role="option">🇦🇫 Afghanistan</div>
            <div class="cd-option" data-value="Albania" role="option">🇦🇱 Albania</div>
            <div class="cd-option" data-value="Algeria" role="option">🇩🇿 Algeria</div>
            <div class="cd-option" data-value="Argentina" role="option">🇦🇷 Argentina</div>
            <div class="cd-option" data-value="Australia" role="option">🇦🇺 Australia</div>
            <div class="cd-option" data-value="Belgium" role="option">🇧🇪 Belgium</div>
            <div class="cd-option" data-value="Brazil" role="option">🇧🇷 Brazil</div>
            <div class="cd-option" data-value="Canada" role="option">🇨🇦 Canada</div>
            <div class="cd-option" data-value="China" role="option">🇨🇳 China</div>
            <div class="cd-option" data-value="Croatia" role="option">🇭🇷 Croatia</div>
            <div class="cd-option" data-value="Czech Republic" role="option">🇨🇿 Czech Republic</div>
            <div class="cd-option" data-value="Denmark" role="option">🇩🇰 Denmark</div>
            <div class="cd-option" data-value="Egypt" role="option">🇪🇬 Egypt</div>
            <div class="cd-option" data-value="Finland" role="option">🇫🇮 Finland</div>
            <div class="cd-option" data-value="France" role="option">🇫🇷 France</div>
            <div class="cd-option" data-value="Greece" role="option">🇬🇷 Greece</div>
            <div class="cd-option" data-value="Hungary" role="option">🇭🇺 Hungary</div>
            <div class="cd-option" data-value="India" role="option">🇮🇳 India</div>
