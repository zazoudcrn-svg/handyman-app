<% upcoming_booking = @all_bookings
  .select { |b| ["pending", "confirmed", "date_change_requested"].include?(b.booking_status) }
  .select { |b| b.scheduled_date_and_time.present? && b.scheduled_date_and_time > Time.current }
  .first
%>

<% later_bookings = @all_bookings
  .select { |b| ["pending", "confirmed", "date_change_requested"].include?(b.booking_status) }
  .select { |b| b.scheduled_date_and_time.present? && b.scheduled_date_and_time > Time.current }
  .reject { |b| b == upcoming_booking }
%>

<% def friendly_date_label(date)
     return "Today" if date.to_date == Date.today
     return "Tomorrow" if date.to_date == Date.tomorrow
     return "Day after tomorrow" if date.to_date == Date.today + 2
     date.strftime("%b %d, %Y")
   end %>

<% confirmed_bookings = @bookings.select { |b| ["pending", "confirmed", "date_change_requested"].include?(b.booking_status) } %>
<% cancelled_bookings = @bookings.select { |b| b.booking_status == "cancelled" } %>
<% completed_bookings = @bookings.select { |b| b.booking_status == "completed" } %>

<div class="py-5" style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; min-height: 100vh;">
  <div class="container" style="max-width: 1200px;">

    <%# HEADER %>
    <div class="mb-5 pb-4 border-bottom" style="border-color: #E2E8F0 !important;">
      <h1 class="h2 mb-0" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">
        <%= current_user.customer? ? "My Bookings" : "My Bookings" %>
      </h1>
    </div>

<div class="upcoming-and-calendar">
  <div class="row mb-5">

    <!-- LEFT: UPCOMING BOOKING -->
    <%# NEW CODE STARTS HERE %>
    <div class="col-md-5">
      <div style="background: white; border-radius: 16px; border: 1px solid #E2E8F0; overflow: hidden; height: 100%;">

        <% if upcoming_booking.present? %>

          <%# Photo banner %>
          <div style="position: relative; height: 250px; background: #E2E8F0; overflow: hidden;">
            <% if upcoming_booking.listing.photos.attached? %>
              <%= cl_image_tag upcoming_booking.listing.photos.first.key,
                  style: "width: 100%; height: 100%; object-fit: cover;" %>
            <% else %>
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #F1F5F9;">
                <i class="bi bi-camera" style="font-size: 32px; color: #CBD5E1;"></i>
              </div>
            <% end %>
            <div style="position: absolute; top: 12px; left: 12px; background: #2F6BFF; color: white; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 9999px;">
              Upcoming
            </div>
          </div>

          <%# Content %>
          <div style="padding: 1.25rem;">
            <p style="font-size: 12px; color: #2F6BFF; font-weight: 600; margin: 0 0 4px;">
              <%= friendly_date_label(upcoming_booking.scheduled_date_and_time) %> ·
              <%= upcoming_booking.scheduled_date_and_time.strftime("%I:%M %p") %>
            </p>
            <h3 style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 16px; font-weight: 700; margin: 0 0 12px;">
              <%= upcoming_booking.listing.title %>
            </h3>

            <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px;">
              <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #64748b;">
                <i class="bi bi-geo-alt" style="color: #2F6BFF;"></i>
                <%= upcoming_booking.listing.city %>, <%= upcoming_booking.listing.postcode %>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #64748b;">
                <i class="bi bi-person-circle" style="color: #2F6BFF;"></i>
                <% if current_user.customer? %>
                  <%= upcoming_booking.offer.user.first_name %>
                <% else %>
                  <%= upcoming_booking.listing.user.first_name %>
                <% end %>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid #F1F5F9;">
              <span style="background: #ECFDF5; color: #059669; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 9999px;">
                <%= upcoming_booking.booking_status.humanize %>
              </span>
              <%= link_to "View Booking →", booking_path(upcoming_booking),
                  style: "background: #2F6BFF; color: white; font-size: 13px; font-weight: 500; padding: 8px 18px; border-radius: 9999px; text-decoration: none;" %>
            </div>
          </div>

        <% else %>

          <div style="padding: 1.25rem;">
            <p class="text-muted mt-3">No upcoming bookings</p>
          </div>

        <% end %>

      </div>
    </div>
    <%# NEW CODE ENDS HERE %>

    <!-- RIGHT: CALENDAR (ALWAYS VISIBLE) -->
    <div class="col-md-6">
      <%= render "shared/calendar", calendar_bookings: @calendar_bookings %>
    </div>

  </div>
</div>


         <%# FILTER FORM %>
          <%= form_with url: bookings_path, method: :get, local: true do |f| %>
          <!-- FILTER TABS -->
    <div class="d-flex align-items-center flex-wrap gap-3 mb-4" role="tablist">
      <span class="text-uppercase fw-bold" style="font-size: 10px; color: #94A3B8; letter-spacing: 0.05em;">Filter by:</span>
        <%# CATEGORY — only shown if customer has listings across more than 1 category %>
        <% if current_user.listings.distinct.pluck(:category_id).size > 1 %>
          <div class="dropdown">
            <button class="btn custom-filter-btn <%= params[:category_ids].present? ? 'active' : '' %>"
                    type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
              Category
              <% if params[:category_ids].present? %>
                <span class="badge rounded-pill ms-1" style="font-size: 10px;"><%= params[:category_ids].size %></span>
              <% end %>
              <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
            </button>
            <div class="dropdown-menu p-3 shadow-sm" style="min-width: 200px; border-radius: 12px; border: 1px solid #E2E8F0;">
              <% Category.where(id: current_user.listings.pluck(:category_id).uniq).each do |category| %>
                <div class="form-check mb-2">
                  <%= check_box_tag "category_ids[]",
                      category.id,
                      Array(params[:category_ids]).map(&:to_s).include?(category.id.to_s),
                      class: "form-check-input",
                      id: "category_#{category.id}" %>
                  <%= label_tag "category_#{category.id}", category.name, class: "form-check-label", style: "font-size: 13px;" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# STATUS %>
        <div class="dropdown">
          <button class="btn custom-filter-btn <%= params[:status].present? ? 'active' : '' %>"
                  type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
            Status
            <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
          </button>
          <div class="dropdown-menu p-3 shadow-sm" style="min-width: 180px; border-radius: 12px; border: 1px solid #E2E8F0;">
            <div class="form-check mb-2">
              <%= radio_button_tag :status, "confirmed", params[:status]== "confirmed", class: "form-check-input", id: "status_confirmed" %>
              <%= label_tag "status_confirmed", "Confirmed", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
            <div class="form-check mb-2">
              <%= radio_button_tag :status, "cancelled", params[:status] == "cancelled", class: "form-check-input", id: "status_cancelled" %>
              <%= label_tag "status_cancelled", "Cancelled", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
            <div class="form-check mb-2">
              <%= radio_button_tag :status, "completed", params[:status] == "completed", class: "form-check-input", id: "status_completed" %>
              <%= label_tag "status_completed", "Completed", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
          </div>
        </div>

        <%# SORT %>
        <div class="dropdown">
          <button class="btn custom-filter-btn <%= params[:sort_by].present? ? 'active' : '' %>"
                  type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
            Sort by
            <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
          </button>
          <div class="dropdown-menu p-3 shadow-sm" style="min-width: 200px; border-radius: 12px; border: 1px solid #E2E8F0;">
            <div class="form-check mb-2">
              <%= radio_button_tag :sort_by, "", params[:sort_by].blank?, class: "form-check-input", id: "sort_recent" %>
              <%= label_tag "sort_recent", "Most recent", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
            <div class="form-check mb-2">
              <%= radio_button_tag :sort_by, "quote_asc", params[:sort_by] == "quote_asc", class: "form-check-input", id: "sort_quote_asc" %>
              <%= label_tag "sort_quote_asc", "Quote: low to high", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
            <div class="form-check mb-2">
              <%= radio_button_tag :sort_by, "quote_desc", params[:sort_by] == "quote_desc", class: "form-check-input", id: "sort_quote_desc" %>
              <%= label_tag "sort_quote_desc", "Quote: high to low", class: "form-check-label", style: "font-size: 13px;" %>
            </div>
          </div>
        </div>

        <%# APPLY + CLEAR %>
        <%= f.submit "Apply",
            class: "btn btn-primary btn-sm px-4",
            style: "border-radius: 9999px; font-size: 13px;" %>
        <%= link_to "Clear", bookings_path,
            class: "btn btn-link btn-sm",
            style: "font-size: 13px; color: #94A3B8; text-decoration: none;" %>
        <span class="text-muted" style="font-size: 12px;">
          <%= @bookings.size %> booking<%= @bookings.size == 1 ? "" : "s" %>
        </span>
      </div>
        <% end %>

       <%# BOOKING GRID %>
    <div class="row g-4">
      <% if @bookings.empty? %>
        <div class="col-12">
          <p class="text-muted text-center py-5" style="font-size: 14px;">No Bookings found.</p>
        </div>
      <% else %>
        <% @bookings.each do |booking| %>
          <%= render "shared/booking_card", booking: booking %>
        <% end %>
      <% end %>
    </div>
    </div>
    </div>

<style>
  .custom-filter-btn {
    border-radius: 9999px !important; font-family: 'Outfit', sans-serif; font-size: 13px; padding: 4px 12px !important;
    background-color: #F8FAFC !important; color: #64748B !important; border: 1px solid #E2E8F0 !important; transition: all 0.2s ease;
    box-shadow: none !important; outline: none !important;
  }
  .custom-filter-btn:focus { box-shadow: none !important; outline: none !important; }
  .custom-filter-btn.active { background-color: #F8FAFC !important; color: #2F6BFF !important; border-color: #2F6BFF !important; }
  .custom-filter-btn .badge { background-color: #EFF6FF; color: #2F6BFF; }
</style>
