<div class="container mt-4">

  <!-- Back Button -->
  <%= link_to "← Back to all Bookings", bookings_path, class: "btn btn-outline-secondary mb-3" %>

  <div class="row g-4">

    <div class="col-md-8">

      <div class="card shadow-sm p-4">

        <h2 class="mb-4 text-center">Booking Details</h2>

  <% unless ["completed", "cancelled"].include?(@booking.booking_status) %>
  <div class="d-flex justify-content-end gap-2 mb-3">

    <!-- EDIT ICON -->
    <%= link_to edit_booking_path(@booking),
        class: "d-flex align-items-center justify-content-center rounded-circle",
        style: "width:40px; height:40px; background:#f1f1f1;" do %>
      <i class="bi bi-pencil text-dark"></i>
    <% end %>

    <!-- DELETE ICON -->
       <%= link_to "#",
          data: { bs_toggle: "modal", bs_target: "#cancelModal" },
          class: "d-flex align-items-center justify-content-center rounded-circle",
          style: "width:40px; height:40px; background:#ffe6e6;" do %>
          <i class="bi bi-x-lg text-danger"></i>
       <% end %>

  </div>
  <% end %>

        <h4 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33;"><%= @booking.listing.title %></h4>
        <%# CUSTOMER VIEW %>
        <% if current_user.customer? %>
          <p><strong>Contractor:</strong> <%= link_to @booking.offer.user.contractor_profile&.business_name || @booking.offer.user.first_name, profile_path(@booking.offer.user) %></p>
        <% end %>

        <% if current_user.contractor? %>
          <p><strong>Customer:</strong> <%= link_to @booking.listing.user.first_name, profile_path(@booking.listing.user) %></p>
        <% end %>

        <p><strong>Scheduled Date:</strong> <strong> <%= @booking.scheduled_date_and_time.strftime("%A") %></strong> •
           <%= @booking.scheduled_date_and_time.strftime("%d %B %Y at %I:%M %p") %></p>
        <p><strong>Address:</strong>
        <%= @booking.listing.street %>, <%= @booking.listing.city %> <%= @booking.listing.postcode %>, <%= @booking.listing.country %>
</p>
        <p><strong>Description:</strong> <%= @booking.listing.description %></p>
        <p>
          <strong>Status:</strong>
          <span class="badge bg-info text-dark"><%= @booking.booking_status %></span>
        </p>
          <% if @booking.booking_status == "cancelled" %>
            <div class="mt-3" style="border-left: 4px solid #d9534f; padding-left: 10px;">
            <strong style="color:#d9534f;">Booking Cancelled</strong>
         <% if @booking.cancellation_note.present? %>
            <p class="mt-2"><strong>Reason:</strong> <%= @booking.cancellation_note %></p>
         <% end %>
         </div>
         <% end %>

        <% if current_user.contractor? &&
          @booking.booking_status == "confirmed" &&
          @booking.accepted_by == "customer" &&
          @booking.new_proposed_date_and_time.nil? %>

        <% end %>

        <% if current_user.customer? &&
          @booking.booking_status == "confirmed" &&
          @booking.accepted_by == "contractor" &&
          @booking.new_proposed_date_and_time.nil? %>
        <% end %>

        <% unless ["cancelled", "completed", "pending"].include?(@booking.booking_status) %>
          <% if @booking.new_proposed_date_and_time.present? %>
          <p><strong>New Proposed Date:</strong> <%= @booking.new_proposed_date_and_time %></p>
          <% if @booking.proposed_by != current_user.role %>
           <%= button_to "Accept New Date",
           accept_date_booking_path(@booking),
           method: :patch,
           data: { turbo: false },
           class: "btn btn-success mb-3" %>
          <% end %>
          <% end %>
          <% end %>

        <% if current_user.role == "customer" && @booking.booking_status != "pending" %>
        <hr>

          <h4>Offer Details</h4>
          <p><strong>Quote:</strong> <%= @offer.quote %></p>
          <% if @offer.note.present? %>
          <p><strong>Note:</strong> <%= @offer.note %></p>
          <% else %>
          <p><strong>Note:</strong> No note provided.</p>
          <% end %>

          <hr>
          <% end %>

        <% if ["confirmed", "date_change_requested", "rescheduled"].include?(@booking.booking_status) %>
           <%= link_to "Mark as Completed",
           complete_booking_path(@booking),
           data: { turbo_method: :patch },
           class: "btn btn-success mt-3" %>
        <% end %>

    <%# REVIEW BUTTON %>
    <% if @booking.booking_status == "completed" %>
      <% if Review.exists?(user_id: current_user.id, booking_id: @booking.id) %>
        <p class="text-success mt-3">
          <i class="bi bi-check-circle-fill"></i> Review submitted.
        </p>
      <% else %>
        <%= link_to "Leave a Review",
                    new_review_path(booking_id: @booking.id),
                    class: "btn btn-primary mt-3" %>
      <% end %>
    <% end %>

      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-4 d-flex flex-column" style="height: 500px;">
        <h5 class="mb-3">Messages</h5>

        <div class="flex-grow-1 overflow-auto mb-3 px-1">
          <% @messages.each do |message| %>
            <% is_mine = message.user == current_user %>
            <div class="d-flex flex-column <%= is_mine ? 'align-items-end' : 'align-items-start' %> mb-3">
              <div class="px-3 py-2 rounded-3" style="max-width: 80%; background-color: <%= is_mine ? '#2F6BFF' : '#F1F5F9' %>; color: <%= is_mine ? '#FFFFFF' : '#0B1B33' %>;">
                <p class="mb-0" style="font-size: 14px; line-height: 1.5;"><%= message.content %></p>
              </div>
              <small class="text-muted mt-1" style="font-size: 11px;">
                <%= message.user.first_name %> · <%= message.created_at.strftime("%b %d, %H:%M") %>
              </small>
            </div>
          <% end %>
        </div>
        <%= simple_form_for [@booking.listing, @offer, @message], html: { data: { controller: "message-form" } } do |f| %>
          <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="border: 1px solid #E2E8F0; background-color: #F8FAFC;">
            <%= f.input :content,
                label: false,
                placeholder: "Type a message...",
                wrapper: false,
                input_html: {
                  class: "form-control border-0 bg-transparent",
                  style: "box-shadow: none; font-size: 14px; resize: none;",
                  rows: 1,
                  data: { message_form_target: "input", action: "input->message-form#toggleSubmit keydown->message-form#handleKeydown" }
                } %>
            <%= f.submit "↑",
                class: "btn btn-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0",
                style: "width: 38px; height: 38px; padding: 0; font-size: 18px;",
                disabled: true,
                data: { message_form_target: "submit" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Cancel Booking</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <%= form_with model: @booking,
                      url: cancel_booking_booking_path(@booking),
                      method: :patch,
                      data: { turbo: false } do |f| %>

          <div class="mb-3">
            <%= f.label :cancellation_note, "Reason for cancellation" %>
            <%= f.text_area :cancellation_note, class: "form-control", rows: 4 %>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <%= f.submit "Cancel Booking", class: "btn btn-danger" %>
          </div>

        <% end %>
      </div>

    </div>
  </div>
</div>
