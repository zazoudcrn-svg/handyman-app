<div class="container my-4" style="max-width: 850px;">

  <div class="mb-4">
    <%= link_to booking_path(@booking), class: "text-decoration-none d-inline-flex align-items-center gap-2 small fw-medium", style: "color: #64748B; transition: color 0.2s;" do %>
      <i class="bi bi-arrow-left"></i> Back to Booking
    <% end %>
  </div>

  <div class="mb-4">
    <h1 class="fw-bold" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2rem; letter-spacing: -0.5px;">Edit Booking</h1>
  </div>

  <div class="card" style="border-radius: 20px; border: 1px solid #E2E8F0; box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02); background: #FFFFFF;">
    <div class="p-4 p-md-5">

      <%# JOB DETAILS — read only %>
      <h5 class="fw-bold mb-4" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Job Details</h5>
      <div class="mb-4 pb-4" style="border-bottom: 1px solid #E2E8F0;">
        <p class="mb-2 small" style="color: #475569;">
          <i class="bi bi-briefcase me-2" style="color: #2F6BFF;"></i>
          <strong>Title:</strong> <%= @booking.listing.title %>
        </p>
        <% if current_user.contractor? %>
          <p class="mb-2 small" style="color: #475569;">
            <i class="bi bi-geo-alt me-2" style="color: #2F6BFF;"></i>
            <strong>Address:</strong> <%= @booking.listing.full_address %>
          </p>
          <p class="mb-0 small" style="color: #475569;">
            <i class="bi bi-person me-2" style="color: #2F6BFF;"></i>
            <strong>Customer:</strong> <%= @booking.listing.user.first_name %> <%= @booking.listing.user.last_name&.first %>.
          </p>
        <% else %>
          <p class="mb-0 small" style="color: #475569;">
            <i class="bi bi-person me-2" style="color: #2F6BFF;"></i>
            <strong>Contractor:</strong> <%= @booking.offer.user.first_name %> <%= @booking.offer.user.last_name&.first %>.
          </p>
        <% end %>
      </div>

      <%# ADDRESS EDIT FORM — customers only %>
      <% if current_user.customer? %>
        <%= form_with model: @booking, url: booking_path(@booking), method: :patch do |f| %>
          <h5 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Job Address</h5>
          <%= f.fields_for :listing do |lf| %>
            <%= lf.hidden_field :id %>
            <div class="row g-3">
              <div class="col-md-6">
                <%= lf.label :street, "Street", class: "form-label small fw-semibold", style: "color: #0B1B33;" %>
                <%= lf.text_field :street, class: "form-control", style: "border-radius: 10px; border: 1px solid #E2E8F0; font-size: 14px;" %>
              </div>
              <div class="col-md-6">
                <%= lf.label :city, "City", class: "form-label small fw-semibold", style: "color: #0B1B33;" %>
                <%= lf.text_field :city, class: "form-control", style: "border-radius: 10px; border: 1px solid #E2E8F0; font-size: 14px;" %>
              </div>
              <div class="col-md-6">
                <%= lf.label :postcode, "Postcode", class: "form-label small fw-semibold", style: "color: #0B1B33;" %>
                <%= lf.text_field :postcode, class: "form-control", style: "border-radius: 10px; border: 1px solid #E2E8F0; font-size: 14px;" %>
              </div>
              <div class="col-md-6">
                <%= lf.label :country, "Country", class: "form-label small fw-semibold", style: "color: #0B1B33;" %>
                <%= lf.text_field :country, class: "form-control", style: "border-radius: 10px; border: 1px solid #E2E8F0; font-size: 14px;" %>
              </div>
            </div>
          <% end %>
          <div class="d-flex align-items-center gap-2 mt-4">
            <%= f.hidden_field :form_type, value: "save_changes" %>
            <%= f.submit "Save Changes",
                class: "btn fw-semibold",
                style: "background-color: #2F6BFF; color: #FFFFFF; border-radius: 9999px; font-family: 'Outfit', sans-serif; font-size: 13px; padding: 10px 28px; border: none; transition: all 0.2s ease;" %>
            <%= link_to "Cancel", booking_path(@booking),
                class: "btn fw-semibold",
                style: "border: 1px solid #E2E8F0; color: #475569; border-radius: 9999px; font-family: 'Outfit', sans-serif; font-size: 13px; padding: 10px 28px; background: #F8FAFC; transition: all 0.2s ease;" %>
          </div>
        <% end %>

        <hr style="border-color: #E2E8F0; margin: 2rem 0;">
      <% end %>

      <%# PROPOSE NEW DATE FORM %>
      <h5 class="fw-bold mb-4" style="font-family: 'Outfit', sans-serif; color: #0B1B33;">Propose a New Date</h5>

      <%= form_with model: @booking,
            url: propose_date_booking_path(@booking),
            method: :patch,
            data: { turbo: false } do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small fw-semibold" style="color: #0B1B33;">Current Scheduled Date</label>
            <div class="input-group">
              <span class="input-group-text bg-white" style="border-radius: 10px 0 0 10px; border: 1px solid #E2E8F0; border-right: none;">
                <i class="bi bi-calendar-event" style="color: #2F6BFF;"></i>
              </span>
              <input type="text"
                     class="form-control bg-white"
                     value="<%= @booking.scheduled_date_and_time.strftime('%A, %d %B %Y at %I:%M %p') %>"
                     disabled
                     style="border-radius: 0 10px 10px 0; border: 1px solid #E2E8F0; font-size: 14px; color: #64748B;">
            </div>
            <small class="text-muted" style="font-size: 11px;">Use the field below to propose a change.</small>
          </div>
          <div class="col-md-6">
            <%= f.label :new_proposed_date_and_time, "Select New Date & Time", class: "form-label small fw-semibold", style: "color: #0B1B33;" %>
            <div class="input-group">
              <span class="input-group-text bg-white" style="border-radius: 10px 0 0 10px; border: 1px solid #E2E8F0; border-right: none;">
                <i class="bi bi-calendar-plus" style="color: #2F6BFF;"></i>
              </span>
              <%= f.text_field :new_proposed_date_and_time,
                    class: "form-control date-picker",
                    style: "border-radius: 0 10px 10px 0; border: 1px solid #E2E8F0; font-size: 14px;" %>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <%= f.hidden_field :form_type, value: "propose_date" %>
          <%= f.submit "Propose New Date",
                class: "btn fw-semibold",
                style: "background-color: #2F6BFF; color: #FFFFFF; border-radius: 9999px; font-family: 'Outfit', sans-serif; font-size: 13px; padding: 10px 28px; border: none; transition: all 0.2s ease;" %>
        </div>
      <% end %>

    </div>
  </div>

</div>

<style>
  .form-control:focus {
    border-color: #2F6BFF !important;
    box-shadow: 0 0 0 3px rgba(47, 107, 255, 0.1) !important;
  }
  .btn:hover[style*="background-color: #2F6BFF"] {
    background-color: #0B1B33 !important;
  }
</style>
