<div class="container mt-4">

  <%= link_to "← Back to all Bookings", booking_path(@booking), class: "btn btn-outline-secondary mb-3" %>

  <div class="card shadow-sm p-4">

    <h2 class="mb-4 text-center">Edit Booking</h2>
    <div id="status_message"></div>

    <!-- READ-ONLY DETAILS -->
    <div class="<%= current_user.customer? ? 'mb-4' : 'mb-2' %>">
  <p class="mb-1"><strong>Title:</strong> <%= @booking.listing.title %></p>

 <% if current_user.contractor? %>
  <p class="mb-1"><strong>Address:</strong> <%= @booking.listing.full_address %></p>
  <p class="mb-1"><strong>Customer:</strong> <%= @booking.listing.user.first_name %></p>
<% else %>
  <p class="mb-1"><strong>Contractor:</strong> <%= @booking.offer.user.first_name %></p>
<% end %>

</div>

    <!-- ⭐ ONE SINGLE FORM FOR ALL BOOKING UPDATES -->
    <%= form_with model: @booking, url: booking_path(@booking), method: :patch, class: "row g-3" do |f| %>

      <% if current_user.customer? %>
  <!-- ADDRESS (CUSTOMER CAN EDIT) -->
      <h5 class="mt-1 mb-2">Address</h5>
      <%= f.fields_for :listing do |lf| %>
        <%= lf.hidden_field :id %>

        <div class="row">
          <div class="col-md-6">
            <%= lf.label :street, "Street", class: "form-label" %>
            <%= lf.text_field :street, class: "form-control" %>
          </div>

          <div class="col-md-6">
            <%= lf.label :city, "City", class: "form-label" %>
            <%= lf.text_field :city, class: "form-control" %>
          </div>

          <div class="col-md-6 mt-3">
            <%= lf.label :postcode, "Postcode", class: "form-label" %>
            <%= lf.text_field :postcode, class: "form-control" %>
          </div>

          <div class="col-md-6 mt-3">
            <%= lf.label :country, "Country", class: "form-label" %>
            <%= lf.text_field :country, class: "form-control" %>
          </div>
        </div>
      <% end %>
      <% end %>
     <% if current_user.customer? %>
      <!-- ⭐ SAVE BUTTON -->
      <div class="col-12 mt-4">
        <%= f.hidden_field :form_type, value: "save_changes" %>
        <%= f.submit "Save Changes",
              class: "btn fw-semibold",
              style: "background-color: #2F6BFF; color: #FFFFFF; border-radius: 8px; font-size: 13px; padding: 12px 32px;" %>

        <%= link_to "Cancel", booking_path(@booking),
      class: "btn fw-semibold ms-2 cancel-btn",
      style: "border: 1px solid #CBD5E1; color: #475569; border-radius: 8px; font-size: 13px; padding: 12px 32px;" %>
     </div>
     <% end %>

    <% end %>

    <hr class="my-4">
<!-- ⭐ PROPOSE NEW DATE FORM -->
<h4 class="mb-3">Propose a New Date</h4>

<div class="card p-3 border-0 shadow-sm" style="border-radius: 12px; background: #F8FAFC;">
  <%= form_with model: @booking,
        url: propose_date_booking_path(@booking),
        method: :patch,
        data: { turbo: false },
        class: "row g-4" do |f| %>

    <!-- CURRENT SCHEDULED DATE (READ ONLY) -->
    <div class="col-md-6">
      <label class="form-label fw-semibold">Scheduled Date & Time</label>
      <div class="input-group">
        <span class="input-group-text bg-white">
          <i class="bi bi-calendar-event"></i>
        </span>
        <input type="text"
               class="form-control bg-white"
               value="<%= @booking.scheduled_date_and_time.strftime('%A, %d %B %Y at %I:%M %p') %>"
               disabled
               style="border-radius: 0 8px 8px 0;">
      </div>
      <small class="text-muted">This date cannot be edited. Use “Propose New Date”.</small>
    </div>

    <!-- NEW DATE + BUTTON IN SAME COLUMN -->
    <div class="col-md-6">
      <%= f.label :new_proposed_date_and_time, "Select New Date & Time", class: "form-label fw-semibold" %>
      <div class="input-group mb-3">
        <span class="input-group-text bg-white">
          <i class="bi bi-calendar-plus"></i>
        </span>
        <%= f.text_field :new_proposed_date_and_time,
              class: "form-control date-picker",
              style: "border-radius: 0 8px 8px 0;" %>
      </div>

      <!-- BUTTON RIGHT BELOW NEW DATE -->
      <%= f.hidden_field :form_type, value: "propose_date" %>
      <%= f.submit "Propose New Date",
            class: "btn fw-semibold",
            style: "background-color: #2F6BFF; color: #FFFFFF; border-radius: 8px; font-size: 14px; padding: 12px 32px;" %>
    </div>

  <% end %>
</div>


  </div>
</div>

<style>
  .cancel-btn:hover {
  background-color: #E2E8F0; /* darker grey */
  color: #1E293B !important; /* darker text */
  border-color: #CBD5E1;
  transition: all 0.2s ease;
}

  </style>
