<!DOCTYPE html>
<html>
  <body style="font-family: 'Manrope', sans-serif; background-color: #F8FAFC; margin: 0; padding: 0;">
    <div style="max-width: 600px; margin: 40px auto; background: white; border-radius: 16px; overflow: hidden; border: 1px solid #E2E8F0;">

      <%# Header %>
      <div style="background: #2F6BFF; padding: 32px; text-align: center;">
        <h1 style="color: white; margin: 0; font-size: 22px;">🔔 New Job Match!</h1>
      </div>

      <%# Body %>
      <div style="padding: 32px;">
        <p style="color: #0B1B33; font-size: 16px;">Hi <strong><%= @contractor.first_name %></strong>,</p>
        <p style="color: #64748B;">A new job has been posted that matches your skills and location:</p>

        <div style="background: #F8FAFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 20px; margin: 24px 0;">
          <p style="margin: 0 0 8px; font-size: 18px; font-weight: 700; color: #0B1B33;"><%= @listing.title %></p>
          <p style="margin: 0 0 8px; color: #64748B; font-size: 14px;"><%= @listing.description %></p>
          <p style="margin: 0; color: #94a3b8; font-size: 13px;">📍 <%= @listing.city %></p>
        </div>

        <a href="<%= listing_url(@listing) %>"
           style="display: inline-block; background: #2F6BFF; color: white; padding: 12px 28px; border-radius: 9999px; text-decoration: none; font-weight: 600; font-size: 14px;">
          View Job →
        </a>
      </div>

      <%# Footer %>
      <div style="padding: 20px 32px; border-top: 1px solid #E2E8F0; text-align: center;">
        <p style="color: #94a3b8; font-size: 12px; margin: 0;">© <%= Time.current.year %> Handyman. All rights reserved.</p>
      </div>

    </div>
  </body>
</html>
