<%# Offer card partial — mirrors the listing card structure (picture left, content right). %>
<%# Expects local: offer %>

<%
  badge_text, badge_style = case offer.offer_status
                             when "accepted"
                               ["Accepted", "background-color: #DCFCE7; color: #166534;"]
                             when "declined"
                               ["Declined", "background-color: #FEE2E2; color: #991B1B;"]
                             else
                               ["Pending", "background-color: #F1F5F9; color: #475569;"]
                             end

  icon_btn_base = "width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; padding: 0; font-size: 14px;"
  accept_style  = "#{icon_btn_base} background-color: #2F6BFF; color: #FFFFFF; border: none;"
  decline_style = "#{icon_btn_base} background-color: #F1F5F9; color: #475569; border: 1px solid #E2E8F0;"
  edit_style    = "#{icon_btn_base} background-color: #FFFFFF; color: #475569; border: 1px solid #E2E8F0;"
  cancel_style  = "#{icon_btn_base} background-color: #EEF3FF; color: #2F6BFF; border: 1px solid #c7d2e8;"

  truncated_note = if offer.note.present?
                      offer.note.length > 300 ? "#{offer.note[0...300]}..." : offer.note
                    end
%>

<div class="col-12">
  <div class="card border-0 overflow-hidden custom-dashboard-card" style="background-color: #FFFFFF; border: 1px solid #E2E8F0 !important; border-radius: 16px; box-shadow: 0 4px 20px rgba(11, 27, 51, 0.02);">

    <% if offer.offer_status.nil? || offer.offer_status == "pending" %>
      <div class="position-absolute d-flex gap-2" style="top: 16px; right: 16px; z-index: 2;">
        <% if current_user.customer? %>
          <%= button_to accept_listing_offer_path(offer.listing, offer), method: :patch, class: "btn", style: accept_style, title: "Accept" do %>
            <i class="bi bi-check-lg"></i>
          <% end %>
          <%= button_to decline_listing_offer_path(offer.listing, offer), method: :patch, class: "btn", style: decline_style, title: "Decline" do %>
            <i class="bi bi-x-lg"></i>
          <% end %>
        <% elsif current_user.contractor? %>
          <%= link_to edit_listing_offer_path(offer.listing, offer), class: "btn", style: edit_style, title: "Edit offer" do %>
            <i class="bi bi-pencil"></i>
          <% end %>
          <%= button_to listing_offer_path(offer.listing, offer), method: :delete, class: "btn", style: cancel_style, title: "Cancel offer", data: { turbo_confirm: "Are you sure?" } do %>
            <i class="bi bi-trash"></i>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="row g-0">

      <div class="col-md-4 position-relative" style="min-height: 220px; background-color: #E2E8F0; display: flex; align-items: center; justify-content: center;">

        <% if offer.listing.photos.attached? && offer.listing.photos.first.present? %>
          <%= cl_image_tag offer.listing.photos.first.key, class: "w-100 h-100 object-cover position-absolute top-0 start-0" %>
        <% else %>
          <%
            image_path = if offer.listing.title.include?("EMERGENCY") then "listings/burst_pipe.png"
                         elsif offer.listing.title.downcase.include?("sink") then "listings/kitchen_sink.png"
                         elsif offer.listing.title.downcase.include?("boiler") then "listings/boiler_repair.png"
                         elsif offer.listing.title.downcase.include?("radiator") then "listings/radiator_valve.png"
                         elsif offer.listing.title.downcase.include?("shower") then "listings/shower_seal.png"
                         else nil end
          %>

          <% if image_path.present? %>
            <%= image_tag image_path, class: "w-100 h-100 object-cover position-absolute top-0 start-0" %>
          <% else %>
            <i class="bi bi-camera" style="font-size: 3rem; color: #94A3B8;"></i>
          <% end %>
        <% end %>
      </div>

      <%# CHANGED: back to justify-content-between on the column (same pattern as the listing card) —
          top block (badge/title/note) stays top-aligned, footer row gets pushed to the bottom %>
      <div class="col-md-8 p-4 d-flex flex-column justify-content-between" style="height: 250px; overflow: hidden;">

        <div>
          <div class="mb-2">
            <span class="badge px-3 py-1.5 fw-semibold" style="border-radius: 6px; <%= badge_style %>">
              <%= badge_text %>
            </span>
          </div>

          <h3 class="fw-bold tracking-tight mb-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 1.4rem;">
            <%= offer.listing.title %>
          </h3>

          <%# CHANGED: note sits directly under the title now, same as the listing card's description %>
          <% if truncated_note.present? %>
            <p class="text-muted small mb-0" style="line-height: 1.5; color: #64748B !important;">
              <%= truncated_note %>
            </p>
          <% end %>
        </div>

        <%# Contractor/quote/duration/date stays on the same row as the action button, at the bottom %>
        <div class="d-flex justify-content-between align-items-center">
          <div class="text-muted small d-flex align-items-center flex-wrap gap-2">
            <span class="d-inline-flex align-items-center gap-1">
              <i class="bi bi-person-circle"></i>
              <% if current_user.customer? %>
                <%= link_to offer.user.contractor_profile&.business_name || offer.user.first_name, profile_path(offer.user), style: "color: #2F6BFF; text-decoration: none; font-weight: 600;" %>
              <% else %>
                <%= link_to "#{offer.listing.user.first_name} #{offer.listing.user.last_name&.first}.", profile_path(offer.listing.user), style: "color: #2F6BFF; text-decoration: none; font-weight: 600;" %>
              <% end %>
            </span>
            <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-cash-coin"></i> €<%= offer.quote.round %></span>
            <% if offer.estimated_duration_hours.present? %>
              <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-clock"></i> <%= offer.estimated_duration_hours %> hrs</span>
            <% end %>
            <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-calendar3"></i> <%= offer.suggested_date_and_time&.strftime("%b %d, %Y at %H:%M") || "Not specified" %></span>
          </div>

          <% if offer.offer_status.nil? || offer.offer_status == "pending" %>
            <%= link_to "View Offer", listing_offer_path(offer.listing, offer), class: "btn btn-sm px-4 py-2 text-white fw-semibold flex-shrink-0", style: "background-color: #2F6BFF; border-radius: 9999px; font-size: 13px;" %>
          <% elsif offer.offer_status == "accepted" %>
            <% if offer.booking.present? %>
              <%= link_to "View Booking →", booking_path(offer.booking), class: "btn btn-sm px-4 py-2 text-white fw-semibold flex-shrink-0", style: "background-color: #2F6BFF; border-radius: 9999px; font-size: 13px;" %>
            <% else %>
              <p class="text-muted small mb-0">Booking not yet created.</p>
            <% end %>
          <% else %>
            <%= link_to "View Details →", listing_offer_path(offer.listing, offer), class: "btn btn-sm px-4 py-2 fw-semibold flex-shrink-0", style: "border-radius: 9999px; font-size: 13px; border: 1px solid #CBD5E1; color: #475569;" %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
