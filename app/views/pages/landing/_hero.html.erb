<%# app/views/pages/landing/_hero.html.erb %>

<%# Part 1: Above-the-fold viewport constraint container (Matches Screenshot 2026-06-23 at 17.00.51.png) %>
<section class="d-flex flex-column align-items-center justify-content-center bg-white text-center" style="min-height: calc(100vh - 74px); padding: 40px 0;">
  <div class="container" style="max-width: 1280px;">

    <div class="inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill mb-4" style="background-color: #EFF6FF; color: #2F6BFF; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; display: inline-flex;">
      <i class="bi bi-hammer"></i> The Two-Sided Marketplace for Home Repairs
    </div>

    <h1 class="fw-bold tracking-tight mb-4" style="font-family: 'Outfit', sans-serif; font-size: calc(2.2rem + 3vw); line-height: 1.1; color: #0B1B33; letter-spacing: -1px;">
      Find the right pro.<br>
      <span style="background: linear-gradient(to right, #2F6BFF, #5B8DFF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Get the job done.</span>
    </h1>

    <p class="mx-auto mb-5" style="color: #64748B; max-width: 42rem; font-size: 1.25rem; line-height: 1.6;">
      Post your job, compare transparent flat-rate offers side-by-side, and confirm your booking instantly. No endless games of phone tag.
    </p>

    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-center gap-3">
      <%= link_to new_listing_path, class: "btn text-white px-4 py-2.5 fw-semibold d-inline-flex align-items-center text-decoration-none shadow-sm", style: "background-color: #2F6BFF; border-radius: 12px; font-size: 16px;" do %>
        Post a job <i class="bi bi-arrow-right ms-2"></i>
      <% end %>
      <%= link_to new_user_registration_path(role: 'contractor'), class: "btn btn-light border px-4 py-2.5 fw-semibold text-decoration-none shadow-sm navbar-guest-btn-outline", style: "color: #0B1B33; border-radius: 12px; font-size: 16px;" do %>
        Join as a Contractor
      <% end %>
    </div>

  </div>
</section>

<%# Part 2: Interactive Offers Engine Dashboard Mockup (Visible on initial scroll down down fold — Matches Screenshot 2026-06-23 at 17.01.26.jpg) %>
<section class="bg-white py-5" style="border-bottom: 1px solid #E2E8F0;">
  <div class="container" style="max-width: 1280px;">
    <div class="position-relative mx-auto" style="max-width: 900px;">
      <div class="card border-0 text-start shadow" style="border-radius: 20px; border: 1px solid #E2E8F0 !important; box-shadow: 0 10px 40px rgba(11,27,51,0.04) !important;">

        <div class="d-flex align-items-center justify-content-between px-4 py-3" style="background-color: #F8FAFC; border-bottom: 1px solid #E2E8F0; border-radius: 20px 20px 0 0;">
          <div class="d-flex gap-1.5">
            <span class="rounded-circle" style="width: 8px; height: 8px; background-color: #FF5F57; display: inline-block;"></span>
            <span class="rounded-circle" style="width: 8px; height: 8px; background-color: #FEBC2E; display: inline-block;"></span>
            <span class="rounded-circle" style="width: 8px; height: 8px; background-color: #27C840; display: inline-block;"></span>
          </div>
          <div class="text-muted small fw-semibold" style="font-size: 11px;">Job View · Active Offers Engine</div>
          <div style="width: 40px;"></div>
        </div>

        <div class="row g-0">
          <div class="col-12 col-md-7 p-4 p-md-5" style="border-right: 1px solid #E2E8F0;">
            <div class="d-flex justify-content-between align-items-start mb-4">
              <div>
                <span class="badge mb-2 px-2.5 py-1.5" style="background-color: #EFF6FF; color: #2F6BFF; font-size: 11px; font-weight: 600;">Plumbing</span>
                <h3 class="fw-bold mb-1" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 1.25rem;">Kitchen tap dripping & pipe repair</h3>
              </div>
              <span class="badge bg-success-subtle text-success px-2.5 py-1.5 fw-semibold" style="background-color: #E6F7ED; color: #10B981; font-size: 11px;">
                Open for Offers
              </span>
            </div>

            <p class="text-muted small mb-4">Offers received from contractors in your area:</p>

            <div class="d-flex flex-column gap-3">
              <% [
                { name: "Mark T. (Contractor)", quote: "€95.00", hours: "2.0 hrs", status: "Pending" },
                { name: "Tomáš K. (Contractor)", quote: "€90.00", hours: "1.5 hrs", status: "Pending" }
              ].each do |o| %>
                <div class="d-flex align-items-center justify-content-between p-3 border rounded-3 bg-white" style="border-color: #E2E8F0 !important;">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-primary text-xs" style="width: 32px; height: 32px; background-color: #EFF6FF;">
                      <%= o[:name][0] %>
                    </div>
                    <div>
                      <span class="d-block fw-semibold text-sm" style="color: #0B1B33; font-size: 14px;"><%= o[:name] %></span>
                      <span class="text-muted" style="font-size: 11px;"><i class="bi bi-clock"></i> Estimated: <%= o[:hours] %></span>
                    </div>
                  </div>
                  <div class="text-end">
                    <span class="fw-bold d-block" style="color: #0B1B33; font-size: 14px;"><%= o[:quote] %></span>
                    <span class="badge rounded-pill fw-bold text-uppercase" style="font-size: 8px; background-color: #EFF6FF; color: #2F6BFF;"><%= o[:status] %></span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <div class="col-12 col-md-5 p-4 p-md-5 bg-light" style="border-radius: 0 0 20px 0;">
            <h5 class="fw-bold mb-3" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 14px;">Offer Chat Thread</h5>

            <div class="d-flex flex-column gap-3 p-3 bg-white border rounded-3 mb-3 shadow-sm" style="height: 180px; border-color: #E2E8F0 !important; overflow: hidden;">
              <div class="align-self-start bg-light p-2.5 rounded-3" style="max-width: 85%;">
                <p class="mb-0 text-muted" style="font-size: 11px; line-height: 1.4;">I can fix the leak tomorrow morning. Parts included.</p>
              </div>
              <div class="align-self-end text-white p-2.5 rounded-3" style="max-width: 85%; background-color: #2F6BFF;">
                <p class="mb-0" style="font-size: 11px; line-height: 1.4;">Perfect. Confirming the booking parameters now.</p>
              </div>
            </div>

            <div class="btn text-white w-100 py-2 fw-semibold text-center text-xs" style="background-color: #0B1B33; border-radius: 10px; font-size: 13px;">
              View All Offers
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
