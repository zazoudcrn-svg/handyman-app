<%# app/views/pages/landing/_hero.html.erb %>
<section class="relative overflow-hidden bg-white text-center" style="padding: 90px 0 120px 0;">
  <div class="absolute inset-0 bg-radial-blue pointer-events-none" style="position:absolute; top:0; left:0; right:0; bottom:0; z-index:1;"></div>

  <div class="container relative" style="max-w: 1280px; position: relative; z-index: 2;">
    <div class="inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill border mb-4" style="background-color: rgba(255,255,255,0.8); border-color: var(--cf-brand-accent) !important; color: var(--cf-brand-primary); font-size: 0.75rem; font-weight: 500; backdrop-filter: blur(4px);">
      <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
      AI-powered admin assistant for craftsmen
    </div>

    <h1 class="fw-bold tracking-tight mb-4" style="font-size: calc(2rem + 3.5vw); font-family: var(--cf-font-heading); line-height: 1.05; color: var(--cf-text-primary);">
      Less paperwork.<br>
      <span style="background: linear-gradient(to right, #2F6BFF, #5B8DFF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Better projects.</span>
    </h1>

    <p class="mx-auto mb-5 text-base md:text-xl" style="color: var(--cf-text-secondary); max-width: 42rem; font-size: 1.125rem;">
      CraftFlow uses AI to connect customers with trusted craftsmen — while automating quotes, scheduling, and project organization.
    </p>

    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-center gap-3 mb-5">
      <%= link_to new_listing_path, class: "btn-cf-primary d-inline-flex align-items-center text-decoration-none" do %>
        For Customers <i data-lucide="arrow-right" class="ms-2" style="width: 18px; height: 18px;"></i>
      <% end %>
      <%= link_to new_user_registration_path(role: 'contractor'), class: "btn-cf-secondary text-decoration-none" do %>
        For Craftsmen
      <% end %>
    </div>

    <div class="d-flex align-items-center justify-content-center gap-4 text-muted" style="font-size: 0.75rem; color: var(--cf-text-tertiary) !important;">
      <div class="d-flex align-items-center gap-1"><i data-lucide="check-circle-2" style="color: var(--cf-brand-primary); width: 14px;"></i> Free to start</div>
      <div class="d-flex align-items-center gap-1"><i data-lucide="check-circle-2" style="color: var(--cf-brand-primary); width: 14px;"></i> No credit card</div>
      <div class="d-flex align-items-center gap-1 d-none d-sm-flex"><i data-lucide="check-circle-2" style="color: var(--cf-brand-primary); width: 14px;"></i> GDPR ready</div>
    </div>

    <div class="position-relative mx-auto mt-5 pt-4" style="max-width: 960px;">
      <div class="cf-card text-start" style="box-shadow: 0 30px 80px rgba(11,27,51,0.12);">
        <div class="d-flex align-items-center justify-content-between px-4 py-2.5 border-b" style="background-color: #F8FAFC; border-bottom: 1px solid var(--cf-border-light);">
          <div class="d-flex gap-1.5">
            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: #FF5F57; display: inline-block;"></span>
            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: #FEBC2E; display: inline-block;"></span>
            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: #27C840; display: inline-block;"></span>
          </div>
          <div class="text-muted d-none d-sm-block" style="font-size: 11px;">app.craftflow.com / dashboard</div>
          <div style="width: 40px;"></div>
        </div>

        <div class="row g-0">
          <div class="col-2 border-end p-3 d-none d-md-flex flex-column gap-2" style="border-right: 1px solid var(--cf-border-light);">
            <% ["Dashboard", "Projects", "Quotes", "Calendar", "Clients", "Settings"].each_with_index do |item, idx| %>
              <div class="px-2 py-1.5 rounded-2 text-xs <%= 'fw-semibold' if idx == 0 %>" style="font-size: 12px; <%= idx == 0 ? 'background-color: var(--cf-brand-accent); color: var(--cf-brand-primary);' : 'color: var(--cf-text-secondary);' %>">
                <%= item %>
              </div>
            <% end %>
          </div>

          <div class="col-12 col-md-10 p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
              <div>
                <p class="mb-0 text-muted" style="font-size: 11px;">Good morning, Mark</p>
                <h3 class="fw-bold mb-0 h5" style="font-family: var(--cf-font-heading);">Your projects today</h3>
              </div>
              <div class="d-none d-sm-block px-3 py-1.5 rounded-pill text-xs fw-medium" style="background-color: var(--cf-brand-accent); color: var(--cf-brand-primary);">
                3 new AI-prepared quotes
              </div>
            </div>

            <div class="row g-3 mb-4">
              <% [
                { label: "Active projects", val: "12", trend: "+3" },
                { label: "Hours saved", val: "27h", trend: "+8h" },
                { label: "Quote response", val: "94%", trend: "+12%" }
              ].each do |s| %>
                <div class="col-4">
                  <div class="p-3 border rounded-3 bg-white" style="border-color: var(--cf-border-light) !important;">
                    <p class="text-muted text-uppercase tracking-wider mb-1" style="font-size: 9px;"><%= s[:label] %></p>
                    <div class="d-flex align-items-baseline gap-2">
                      <span class="fw-bold h5 mb-0" style="font-family: var(--cf-font-heading);"><%= s[:val] %></span>
                      <span class="text-success" style="font-size: 10px;"><%= s[:trend] %></span>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="d-flex flex-column gap-2">
              <% [
                { name: "Kitchen renovation — Müller", status: "Quote ready", color: "#2F6BFF" },
                { name: "Bathroom leak — Schneider", status: "Emergency", color: "#EF4444" },
                { name: "Living room paint — Becker", status: "Scheduled", color: "#10B981" }
              ].each do |p| %>
                <div class="d-flex align-items-center justify-content-between p-3 border rounded-3 bg-white" style="border-color: var(--cf-border-light) !important;">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded d-flex align-items-center justify-content-center text-xs fw-semibold" style="width: 32px; height: 32px; background-color: var(--cf-brand-soft-blue); color: var(--cf-brand-primary);">
                      <%= p[:name][0..1] %>
                    </div>
                    <span class="text-sm fw-medium" style="color: var(--cf-text-primary); font-size: 14px;"><%= p[:name] %></span>
                  </div>
                  <span class="px-2 py-1 rounded-pill fw-semibold" style="font-size: 10px; background-color: <%= p[:color] %>15; color: <%= p[:color] %>;">
                    <%= p[:status] %>
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="position-absolute bg-white border p-3 rounded-4 shadow-sm animate-float-slow d-none d-sm-block" style="width: 210px; top: -25px; left: -40px; z-index: 10; border-color: var(--cf-border-light) !important;">
        <div class="d-flex align-items-center gap-2">
          <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; background-color: var(--cf-brand-soft-blue);"><i data-lucide="sparkles" style="color: var(--cf-brand-primary); width:14px;"></i></div>
          <div>
            <p class="text-muted text-uppercase tracking-wider mb-0" style="font-size: 9px;">AI quote draft</p>
            <p class="fw-semibold mb-0" style="font-size: 11px; color: var(--cf-text-primary);">Kitchen renovation</p>
          </div>
        </div>
        <div class="mt-2 pt-2 border-top text-start fw-bold" style="font-size: 14px; color: var(--cf-text-primary);">€8,240</div>
      </div>

      <div class="position-absolute bg-white border p-3 rounded-4 shadow-sm animate-float-medium d-none d-sm-block" style="width: 210px; top: -10px; right: -40px; z-index: 10; border-color: var(--cf-border-light) !important;">
        <div class="d-flex align-items-center gap-2">
          <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; background-color: #E6F7ED;"><i data-lucide="calendar" style="color: #10B981; width:14px;"></i></div>
          <div>
            <p class="text-muted text-uppercase tracking-wider mb-0" style="font-size: 9px;">Calendar synced</p>
            <p class="fw-semibold mb-0" style="font-size: 11px; color: var(--cf-text-primary);">Google · Outlook</p>
          </div>
        </div>
        <div class="mt-2 pt-2 border-top text-start fw-bold" style="font-size: 14px; color: var(--cf-text-primary);">Today, 14:30</div>
      </div>
    </div>
  </div>
</section>
