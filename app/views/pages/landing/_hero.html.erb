<%# app/views/pages/landing/_hero.html.erb %>
<section class="relative overflow-hidden bg-white text-center" style="padding: 90px 0 120px 0;">
  <div class="absolute inset-0 bg-radial-blue pointer-events-none" style="position:absolute; top:0; left:0; right:0; bottom:0; z-index:1;"></div>

  <div class="container relative" style="max-w: 1280px; position: relative; z-index: 2;">
    <div class="inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill border mb-4" style="background-color: rgba(255,255,255,0.8); border-color: var(--cf-brand-accent) !important; color: var(--cf-brand-primary); font-size: 0.75rem; font-weight: 500; backdrop-filter: blur(4px);">
      <i data-lucide="hammer" style="width: 14px; height: 14px;"></i>
      The two-sided marketplace for home repairs
    </div>

    <h1 class="fw-bold tracking-tight mb-4" style="font-size: calc(2rem + 3.5vw); font-family: var(--cf-font-heading); line-height: 1.05; color: var(--cf-text-primary);">
      Find the right pro.<br>
      <span style="background: linear-gradient(to right, #2F6BFF, #5B8DFF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Get the job done.</span>
    </h1>

    <p class="mx-auto mb-5 text-base md:text-xl" style="color: var(--cf-text-secondary); max-width: 42rem; font-size: 1.125rem;">
      Handyman connects homeowners with local contractors. Post your job, compare offers, and book — all in one place. No phone tag, no guesswork.
    </p>

    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-center gap-3 mb-5">
      <%= link_to new_listing_path, class: "btn-cf-primary d-inline-flex align-items-center text-decoration-none" do %>
        Post a project <i data-lucide="arrow-right" class="ms-2" style="width: 18px; height: 18px;"></i>
      <% end %>
      <%= link_to new_user_registration_path(role: 'contractor'), class: "btn-cf-secondary text-decoration-none" do %>
        Join as a contractor
      <% end %>
    </div>

    <div class="d-flex align-items-center justify-content-center gap-4 text-muted" style="font-size: 0.75rem; color: var(--cf-text-tertiary) !important;">
      <div class="d-flex align-items-center gap-1"><i data-lucide="check-circle-2" style="color: var(--cf-brand-primary); width: 14px;"></i> Free to post a job</div>
      <div class="d-flex align-items-center gap-1"><i data-lucide="check-circle-2" style="color: var(--cf-brand-primary); width: 14px;"></i> No credit card needed</div>
      <div class="d-flex align-items-center gap-1 d-none d-sm-flex"><i data-lucide="check-circle-2" style="color: var(--cf-brand-primary); width: 14px;"></i> Pick the offer that suits you</div>
    </div>

    <div class="position-relative mx-auto mt-5 pt-4" style="max-width: 960px;">
      <div class="cf-card text-start" style="box-shadow: 0 30px 80px rgba(11,27,51,0.12);">
        <div class="d-flex align-items-center justify-content-between px-4 py-2.5 border-b" style="background-color: #F8FAFC; border-bottom: 1px solid var(--cf-border-light);">
          <div class="d-flex gap-1.5">
            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: #FF5F57; display: inline-block;"></span>
            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: #FEBC2E; display: inline-block;"></span>
            <span class="rounded-circle" style="width: 10px; height: 10px; background-color: #27C840; display: inline-block;"></span>
          </div>
          <div class="text-muted d-none d-sm-block" style="font-size: 11px;">Listing · Kitchen tap dripping and needs replacement</div>
          <div style="width: 40px;"></div>
        </div>

        <div class="row g-0">
          <div class="col-12 col-md-7 p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
              <div>
                <p class="mb-1 text-muted" style="font-size: 11px;">Plumbing · Posted 2h ago</p>
                <h3 class="fw-bold mb-0 h5" style="font-family: var(--cf-font-heading); color: var(--cf-text-primary);">Kitchen tap dripping and needs replacement</h3>
              </div>
              <span class="px-3 py-1.5 rounded-pill text-xs fw-medium" style="background-color: #FEF3C7; color: #92400E;">
                Active
              </span>
            </div>

            <p class="text-muted mb-4" style="font-size: 13px;">3 offers received from contractors in your area.</p>

            <div class="d-flex flex-column gap-2">
              <% [
                { name: "Mark T.", quote: "€95", status: "Pending", color: "#2F6BFF" },
                { name: "Lena S.", quote: "€110", status: "Pending", color: "#2F6BFF" },
                { name: "Tomáš K.", quote: "€90", status: "Accepted", color: "#10B981" }
              ].each do |o| %>
                <div class="d-flex align-items-center justify-content-between p-3 border rounded-3 bg-white" style="border-color: var(--cf-border-light) !important;">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-xs fw-semibold" style="width: 32px; height: 32px; background-color: var(--cf-brand-soft-blue); color: var(--cf-brand-primary);">
                      <%= o[:name][0] %>
                    </div>
                    <span class="text-sm fw-medium" style="color: var(--cf-text-primary); font-size: 14px;"><%= o[:name] %></span>
                  </div>
                  <div class="d-flex align-items-center gap-3">
                    <span class="fw-semibold text-sm" style="font-size: 13px; color: var(--cf-text-primary);"><%= o[:quote] %></span>
                    <span class="px-2 py-1 rounded-pill fw-semibold" style="font-size: 10px; background-color: <%= o[:color] %>15; color: <%= o[:color] %>;">
                      <%= o[:status] %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <div class="col-12 col-md-5 p-4 d-none d-md-block" style="background-color: var(--cf-brand-soft-blue); border-left: 1px solid var(--cf-border-light);">
            <p class="font-heading fw-semibold mb-2" style="color: var(--cf-text-primary); font-size: 14px;">Accepted offer</p>
            <p class="text-muted mb-3" style="font-size: 11px;">Booking confirmed with Tomáš K.</p>
            <div class="p-3 rounded-3 bg-white border" style="border-color: var(--cf-brand-accent) !important;">
              <p class="fw-semibold mb-1" style="font-size: 11px; color: var(--cf-text-primary);">📅 Scheduled</p>
              <p class="text-muted mb-0" style="font-size: 10px;">Thu, June 25 · 10:00</p>
            </div>
            <div class="mt-3 p-3 rounded-3 bg-white border" style="border-color: var(--cf-border-light) !important;">
              <p class="fw-semibold mb-1" style="font-size: 11px; color: var(--cf-text-primary);">⭐ Leave a review</p>
              <p class="text-muted mb-0" style="font-size: 10px;">Once the job is marked done</p>
            </div>
          </div>
        </div>
      </div>

      <div class="position-absolute bg-white border p-3 rounded-4 shadow-sm animate-float-slow d-none d-sm-block" style="width: 200px; top: -25px; left: -30px; z-index: 10; border-color: var(--cf-border-light) !important;">
        <div class="d-flex align-items-center gap-2">
          <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; background-color: var(--cf-brand-soft-blue);"><i data-lucide="hand-coins" style="color: var(--cf-brand-primary); width:14px;"></i></div>
          <div>
            <p class="text-muted text-uppercase tracking-wider mb-0" style="font-size: 9px;">Best offer</p>
            <p class="fw-semibold mb-0" style="font-size: 11px; color: var(--cf-text-primary);">Kitchen tap repair</p>
          </div>
        </div>
        <div class="mt-2 pt-2 border-top text-start fw-bold" style="font-size: 14px; color: var(--cf-text-primary);">€90</div>
      </div>

      <div class="position-absolute bg-white border p-3 rounded-4 shadow-sm animate-float-medium d-none d-sm-block" style="width: 200px; top: -10px; right: -30px; z-index: 10; border-color: var(--cf-border-light) !important;">
        <div class="d-flex align-items-center gap-2">
          <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; background-color: #E6F7ED;"><i data-lucide="star" style="color: #10B981; width:14px;"></i></div>
          <div>
            <p class="text-muted text-uppercase tracking-wider mb-0" style="font-size: 9px;">Verified contractor</p>
            <p class="fw-semibold mb-0" style="font-size: 11px; color: var(--cf-text-primary);">Tomáš K. · Plumbing</p>
          </div>
        </div>
        <div class="mt-2 pt-2 border-top text-start fw-bold" style="font-size: 14px; color: var(--cf-text-primary);">4.9 ★ rating</div>
      </div>
    </div>
  </div>
</section>
