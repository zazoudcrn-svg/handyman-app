<%# app/views/pages/landing/_future_vision.html.erb %>
<%
  visions = [
    { icon: "package", title: "Automatic material ordering", desc: "Approve a quote, materials are auto-ordered from your preferred supplier." },
    { icon: "book-open", title: "Accounting integrations", desc: "Two-way sync with DATEV, Sevdesk and more." },
    { icon: "file-spreadsheet", title: "Lexware Office sync", desc: "Invoices and clients stay perfectly aligned, automatically." },
    { icon: "receipt", title: "Smart invoicing", desc: "Generate, send and reconcile invoices — without leaving CraftFlow." },
    { icon: "calendar-clock", title: "AI scheduling assistant", desc: "An always-on assistant that protects your time and your jobs." },
    { icon: "shield-check", title: "Escrow payment protection", desc: "Funds locked until milestones are met — safe for everyone." }
  ]
%>

<section id="vision" class="relative overflow-hidden" style="background-color: #0B1B33; padding: 80px 0;">
  <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle at 80% 20%, rgba(47,107,255,0.15), transparent 60%); position: absolute; top:0; left:0; right:0; bottom:0;"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" style="max-w: 1280px; position: relative;">
    <div class="text-center max-w-2xl mx-auto mb-5" style="max-width: 42rem; margin-bottom: 3.5rem;">
      <p class="text-xs font-medium tracking-widest uppercase" style="color: #7AA3FF; font-size: 0.75rem;">Future vision</p>
      <h2 class="mt-3 fw-semibold tracking-tight text-white" style="font-size: calc(1.375rem + 1.5vw); font-family: var(--cf-font-heading);">
        The operating system for modern craftsmen.
      </h2>
      <p class="mt-3 text-base md:text-lg" style="color: #CBD5E1;">
        What's coming next on the CraftFlow roadmap. Built with the people who use it every day.
      </p>
    </div>

    <div class="row g-4">
      <% visions.each do |v| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="p-4 h-100 d-flex flex-column border-1 rounded-4" style="background-color: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(4px);">
            <div class="d-flex align-items-center justify-content-center rounded-3 border-1" style="width: 44px; height: 44px; background-color: rgba(47,107,255,0.2); border: 1px solid rgba(47,107,255,0.3);">
              <i data-lucide="<%= v[:icon] %>" style="color: #7AA3FF; width: 20px; height: 20px; stroke-width: 1.8;"></i>
            </div>
            <h3 class="fw-semibold text-lg mt-4 mb-2 tracking-tight text-white" style="font-size: 1.125rem; font-family: var(--cf-font-heading);"><%= v[:title] %></h3>
            <p class="text-sm leading-relaxed mb-3" style="color: #CBD5E1; font-size: 0.875rem;"><%= v[:desc] %></p>
            <span class="mt-auto inline-block text-[10px] font-medium tracking-widest uppercase" style="color: #7AA3FF; font-size: 10px; letter-spacing: 0.05em;">
              Coming soon
            </span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
