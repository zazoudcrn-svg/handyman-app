<%# app/views/pages/landing/_how_it_works.html.erb %>
<%
  customer_steps = [
    { icon: "bi-file-earmark-plus", title: "1. Create a Job", desc: "Specify your trade category, project description, urgency, and availability profile using our guided form." },
    { icon: "bi-tags", title: "2. Receive Offers", desc: "Review flat-rate quotes, estimated duration hours, and profile ratings submitted directly by local contractors." },
    { icon: "bi-check2-circle", title: "3. Confirm Booking", desc: "Accept your preferred offer to instantly instantiate the booking, secure the schedule, and open a dedicated chat thread." }
  ]
  contractor_steps = [
    { icon: "bi-search", title: "1. Browse Jobs", desc: "Filter open customer jobs mapped completely to your specific trade specialization categories and regional location." },
    { icon: "bi-send", title: "2. Submit Offers", desc: "File your target quote pricing, estimated duration hours, and suggested execution dates directly to the customer." },
    { icon: "bi-calendar-check", title: "3. Manage Bookings", desc: "Track confirmed bookings, coordinate project details via integrated chat, and log completion to compile customer reviews." }
  ]
%>

<section id="how-it-works" class="d-flex align-items-center" style="min-height: calc(100vh - 74px); background-color: #F8FAFC; border-bottom: 1px solid #E2E8F0; padding: 60px 0;">
  <div class="container" style="max-width: 1280px; width: 100%;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-3">
      <div>
        <h2 class="fw-bold tracking-tight mb-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2rem; letter-spacing: -0.5px;">Platform Workflows</h2>
        <p class="text-muted small mb-0" style="font-size: 14px; font-family: 'Manrope', sans-serif;">Optimized operational routes structured cleanly by platform identity roles.</p>
      </div>

      <ul class="nav nav-pills p-1 bg-white border" id="workflowTabs" role="tablist" style="border-radius: 12px; border-color: #E2E8F0 !important;">
        <li class="nav-item" role="presentation">
          <button class="nav-link active fw-bold border-0 px-4 py-2.5" id="flow-customer-tab" data-bs-toggle="pill" data-bs-target="#flow-customer" type="button" role="tab" style="font-size: 14px; font-family: 'Manrope', sans-serif; border-radius: 10px; transition: all 0.2s ease;">
            For Homeowners
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold border-0 px-4 py-2.5" id="flow-contractor-tab" data-bs-toggle="pill" data-bs-target="#flow-contractor" type="button" role="tab" style="font-size: 14px; font-family: 'Manrope', sans-serif; border-radius: 10px; transition: all 0.2s ease;">
            For Contractors
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content" id="workflowTabsContent">
      <%# CUSTOMER ROUTE %>
      <div class="tab-pane fade show active" id="flow-customer" role="tabpanel" aria-labelledby="flow-customer-tab">
        <div class="row g-4">
          <% customer_steps.each do |step| %>
            <div class="col-12 col-md-4">
              <div class="card p-4 bg-white border-0 h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 16px; box-shadow: 0 4px 20px rgba(11,27,51,0.01);">
                <div class="rounded-3 border d-flex align-items-center justify-content-center bg-light mb-3" style="width: 40px; height: 40px; border-color: #E2E8F0 !important;">
                  <i class="bi <%= step[:icon] %>" style="font-size: 18px; color: #2F6BFF;"></i>
                </div>
                <h3 class="h6 fw-bold mb-2" style="font-family: 'Outfit', sans-serif; color: #2F6BFF; font-size: 16px;"><%= step[:title] %></h3>
                <p class="text-muted small mb-0" style="line-height: 1.6; font-size: 13.5px; font-family: 'Manrope', sans-serif;"><%= step[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# CONTRACTOR ROUTE %>
      <div class="tab-pane fade" id="flow-contractor" role="tabpanel" aria-labelledby="flow-contractor-tab">
        <div class="row g-4">
          <% contractor_steps.each do |step| %>
            <div class="col-12 col-md-4">
              <div class="card p-4 bg-white border-0 h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 16px; box-shadow: 0 4px 20px rgba(11,27,51,0.01);">
                <div class="rounded-3 border d-flex align-items-center justify-content-center bg-light mb-3" style="width: 40px; height: 40px; border-color: #E2E8F0 !important;">
                  <i class="bi <%= step[:icon] %>" style="font-size: 18px; color: #10B981;"></i>
                </div>
                <h3 class="h6 fw-bold mb-2" style="font-family: 'Outfit', sans-serif; color: #10B981; font-size: 16px;"><%= step[:title] %></h3>
                <p class="text-muted small mb-0" style="line-height: 1.6; font-size: 13.5px; font-family: 'Manrope', sans-serif;"><%= step[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  #workflowTabs .nav-link { color: #64748B !important; background-color: transparent !important; }
  #workflowTabs .nav-link.active { color: #2F6BFF !important; background-color: #EFF6FF !important; }

  /* ADDED: hover state for the inactive tab — navy text + light gray background */
  #workflowTabs .nav-link:not(.active):hover {
    color: #0B1B33 !important;
    background-color: #F1F5F9 !important;
    cursor: pointer;
  }
</style>
