<%# app/views/pages/landing/_how_it_works.html.erb %>
<%
  customer_steps = [
    { icon: "file-text", title: "Create your request", desc: "Describe what you need in a few words." },
    { icon: "camera", title: "Upload photos & videos", desc: "Show the problem — pictures save a thousand calls." },
    { icon: "sparkles", title: "AI asks smart questions", desc: "We fill the gaps so the brief is complete." },
    { icon: "users", title: "Get matched", desc: "Trusted craftsmen in your area, qualified by radius and skill." },
    { icon: "mail", title: "Receive offers", desc: "AI-prepared quotes land in your inbox — clear and comparable." },
    { icon: "bar-chart-3", title: "Track progress", desc: "Live timeline, chat, milestones — all in one place." }
  ]

  craftsman_steps = [
    { icon: "user-plus", title: "Create profile", desc: "Business, logo and quick intro." },
    { icon: "wrench", title: "Select services", desc: "Pick the work you do best." },
    { icon: "map-pin", title: "Set travel radius", desc: "Define how far you're willing to travel." },
    { icon: "file-up", title: "Upload past invoices", desc: "AI learns your pricing and services." },
    { icon: "calendar-sync", title: "Sync calendar", desc: "Google, Apple, Outlook — no double bookings." },
    { icon: "sparkles", title: "Receive AI-prepared offers", desc: "Quote drafts ready for review." },
    { icon: "check-circle-2", title: "Approve & send", desc: "One tap. Customer notified instantly." }
  ]
%>

<section id="how-it-works" class="py-20 bg-white" style="padding: 80px 0;">
  <div class="container" style="max-w: 1280px;">
    <div class="text-center max-w-2xl mx-auto mb-5" style="max-width: 42rem; margin-bottom: 3rem;">
      <p class="text-xs font-medium tracking-widest uppercase" style="color: var(--cf-brand-primary); font-size: 0.75rem;">How it works</p>
      <h2 class="font-heading mt-3 fw-semibold tracking-tight" style="color: var(--cf-text-primary); font-size: calc(1.375rem + 1.5vw);">
        From request to result — in a few clicks.
      </h2>
      <p class="mt-3 text-base md:text-lg" style="color: var(--cf-text-secondary);">
        Built to feel effortless on both sides. Pick a flow and follow the timeline.
      </p>
    </div>

    <div class="d-flex justify-content-center mb-5">
      <ul class="nav nav-pills p-1 rounded-pill" id="howItWorksTabs" role="tablist" style="background-color: var(--cf-bg-secondary); border: 1px solid var(--cf-border-light);">
        <li class="nav-item" role="presentation">
          <button class="nav-link active rounded-pill px-4 py-2 text-sm fw-medium transition-all" id="how-customer-tab" data-bs-toggle="pill" data-bs-target="#how-customer" type="button" role="tab" aria-controls="how-customer" aria-selected="true">
            For Customers
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link rounded-pill px-4 py-2 text-sm fw-medium transition-all" id="how-craftsman-tab" data-bs-toggle="pill" data-bs-target="#how-craftsman" type="button" role="tab" aria-controls="how-craftsman" aria-selected="false">
            For Craftsmen
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content" id="howItWorksTabsContent">
      <div class="tab-pane fade show active" id="how-customer" role="tabpanel" aria-labelledby="how-customer-tab">
        <div class="row g-4 justify-content-center">
          <% customer_steps.each_with_index do |step, idx| %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="cf-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="font-heading text-xs font-semibold tracking-widest text-uppercase mb-2" style="color: var(--cf-text-tertiary); font-size: 10px;">
                    STEP <%= (idx + 1).to_s.rjust(2, "0") %>
                  </div>
                  <h3 class="fw-semibold mb-2 h5" style="color: var(--cf-text-primary); font-family: var(--cf-font-heading);"><%= step[:title] %></h3>
                  <p class="text-muted text-sm mb-0" style="font-size: 13px;"><%= step[:desc] %></p>
                </div>
                <div class="mt-4 rounded-3 d-flex align-items-center justify-content-center border" style="width: 48px; height: 48px; background-color: var(--cf-brand-soft-blue); border-color: var(--cf-brand-accent) !important;">
                  <i data-lucide="<%= step[:icon] %>" style="color: var(--cf-brand-primary); width: 22px; height: 22px;"></i>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="how-craftsman" role="tabpanel" aria-labelledby="how-craftsman-tab">
        <div class="row g-4 justify-content-center">
          <% craftsman_steps.each_with_index do |step, idx| %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="cf-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="font-heading text-xs font-semibold tracking-widest text-uppercase mb-2" style="color: var(--cf-text-tertiary); font-size: 10px;">
                    STEP <%= (idx + 1).to_s.rjust(2, "0") %>
                  </div>
                  <h3 class="fw-semibold mb-2 h5" style="color: var(--cf-text-primary); font-family: var(--cf-font-heading);"><%= step[:title] %></h3>
                  <p class="text-muted text-sm mb-0" style="font-size: 13px;"><%= step[:desc] %></p>
                </div>
                <div class="mt-4 rounded-3 d-flex align-items-center justify-content-center border" style="width: 48px; height: 48px; background-color: var(--cf-brand-soft-blue); border-color: var(--cf-brand-accent) !important;">
                  <i data-lucide="<%= step[:icon] %>" style="color: var(--cf-brand-primary); width: 22px; height: 22px;"></i>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  #howItWorksTabs .nav-link { color: var(--cf-text-secondary) !important; background: transparent !important; }
  #howItWorksTabs .nav-link.active { color: var(--cf-text-primary) !important; background-color: #FFFFFF !important; box-shadow: 0 2px 10px rgba(11,27,51,0.04) !important; }
</style>
