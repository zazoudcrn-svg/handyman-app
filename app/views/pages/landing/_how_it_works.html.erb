<%# app/views/pages/landing/_how_it_works.html.erb %>
<%
  customer_steps = [
    { icon: "file-text", title: "Post your job", desc: "Title, category, description, and when you need it done." },
    { icon: "inbox", title: "Receive offers", desc: "Local contractors who match your category submit quotes." },
    { icon: "users", title: "Compare & accept", desc: "Check ratings and quotes, then accept the one you like." },
    { icon: "message-square", title: "Message directly", desc: "Chat with your contractor on the offer thread." },
    { icon: "calendar-check", title: "Track the booking", desc: "Confirm or propose a new date and time together." },
    { icon: "star", title: "Leave a review", desc: "Once the job is marked done, rate your contractor." }
  ]

  contractor_steps = [
    { icon: "user-plus", title: "Create your profile", desc: "Business details, your specialties, and travel radius." },
    { icon: "search", title: "Browse open listings", desc: "See jobs that match your categories." },
    { icon: "send", title: "Submit an offer", desc: "Quote and an optional note — no cold calling." },
    { icon: "message-square", title: "Message the customer", desc: "Discuss details before or after they accept." },
    { icon: "calendar-check", title: "Manage the booking", desc: "Confirm, reschedule, or counter-propose a time." },
    { icon: "check-circle-2", title: "Mark the job done", desc: "Close it out and collect your review." }
  ]
%>

<section id="how-it-works" class="py-20" style="background-color: var(--cf-brand-soft-blue); padding: 80px 0;">
  <div class="container" style="max-w: 1280px;">
    <div class="text-center max-w-2xl mx-auto mb-5" style="max-width: 42rem; margin-bottom: 3rem;">
      <p class="text-xs font-medium tracking-widest uppercase" style="color: var(--cf-brand-primary); font-size: 0.75rem;">How it works</p>
      <h2 class="font-heading mt-3 fw-semibold tracking-tight" style="color: var(--cf-text-primary); font-size: calc(1.375rem + 1.5vw);">
        From request to result — in a few clicks.
      </h2>
      <p class="mt-3 text-base md:text-lg" style="color: var(--cf-text-secondary);">
        Pick a side and follow the journey.
      </p>
    </div>

    <div class="d-flex justify-content-center mb-5">
      <ul class="nav nav-pills p-1 rounded-pill" id="howItWorksTabs" role="tablist" style="background-color: #FFFFFF; border: 1px solid var(--cf-border-light);">
        <li class="nav-item" role="presentation">
          <button class="nav-link active rounded-pill px-4 py-2 text-sm fw-medium transition-all" id="how-customer-tab" data-bs-toggle="pill" data-bs-target="#how-customer" type="button" role="tab" aria-controls="how-customer" aria-selected="true">
            For Customers
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link rounded-pill px-4 py-2 text-sm fw-medium transition-all" id="how-contractor-tab" data-bs-toggle="pill" data-bs-target="#how-contractor" type="button" role="tab" aria-controls="how-contractor" aria-selected="false">
            For Contractors
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content" id="howItWorksTabsContent">
      <div class="tab-pane fade show active" id="how-customer" role="tabpanel" aria-labelledby="how-customer-tab">
        <div class="row g-4 justify-content-center">
          <% customer_steps.each_with_index do |step, idx| %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="cf-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="font-heading text-xs font-semibold tracking-widest text-uppercase mb-2" style="color: var(--cf-text-tertiary); font-size: 10px;">
                    STEP <%= (idx + 1).to_s.rjust(2, "0") %>
                  </div>
                  <h3 class="fw-semibold mb-2 h5" style="color: var(--cf-text-primary); font-family: var(--cf-font-heading);"><%= step[:title] %></h3>
                  <p class="text-muted text-sm mb-0" style="font-size: 13px;"><%= step[:desc] %></p>
                </div>
                <div class="mt-4 rounded-3 d-flex align-items-center justify-content-center border" style="width: 48px; height: 48px; background-color: var(--cf-brand-soft-blue); border-color: var(--cf-brand-accent) !important;">
                  <i data-lucide="<%= step[:icon] %>" style="color: var(--cf-brand-primary); width: 22px; height: 22px;"></i>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="how-contractor" role="tabpanel" aria-labelledby="how-contractor-tab">
        <div class="row g-4 justify-content-center">
          <% contractor_steps.each_with_index do |step, idx| %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="cf-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="font-heading text-xs font-semibold tracking-widest text-uppercase mb-2" style="color: var(--cf-text-tertiary); font-size: 10px;">
                    STEP <%= (idx + 1).to_s.rjust(2, "0") %>
                  </div>
                  <h3 class="fw-semibold mb-2 h5" style="color: var(--cf-text-primary); font-family: var(--cf-font-heading);"><%= step[:title] %></h3>
                  <p class="text-muted text-sm mb-0" style="font-size: 13px;"><%= step[:desc] %></p>
                </div>
                <div class="mt-4 rounded-3 d-flex align-items-center justify-content-center border" style="width: 48px; height: 48px; background-color: var(--cf-brand-soft-blue); border-color: var(--cf-brand-accent) !important;">
                  <i data-lucide="<%= step[:icon] %>" style="color: var(--cf-brand-primary); width: 22px; height: 22px;"></i>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  #howItWorksTabs .nav-link { color: var(--cf-text-secondary) !important; background: transparent !important; }
  #howItWorksTabs .nav-link.active { color: var(--cf-text-primary) !important; background-color: var(--cf-brand-soft-blue) !important; box-shadow: 0 2px 10px rgba(11,27,51,0.04) !important; }
</style>
