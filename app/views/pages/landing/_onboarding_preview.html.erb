<%# app/views/pages/landing/_onboarding_preview.html.erb %>
<%
  craftsman_screens = [
    { num: "01", title: "Welcome", desc: "A friendly intro and what to expect.", icon: "hammer" },
    { num: "02", title: "Basic info", desc: "Name, business, website, logo.", icon: "building-2" },
    { num: "03", title: "Select services", desc: "Pick categories you specialize in.", icon: "hammer" },
    { num: "04", title: "Work radius", desc: "Map + distance slider — set how far.", icon: "map-pin" },
    { num: "05", title: "Past invoices", desc: "AI learns your pricing and services.", icon: "file-up" },
    { num: "06", title: "Supplier invoices", desc: "Smarter material estimation.", icon: "upload" },
    { num: "07", title: "Calendar sync", desc: "Google, Apple or Outlook.", icon: "calendar" },
    { num: "08", title: "Profile complete", desc: "Ready to receive AI-prepared leads.", icon: "check-circle-2" }
  ]
%>

<section id="craftsman-flow" class="py-20 bg-white" style="padding: 80px 0;">
  <div class="container" style="max-w: 1280px;">
    <div class="row align-items-center g-5 mb-5">
      <div class="col-12 col-lg-6">
        <p class="text-xs font-medium tracking-widest uppercase" style="color: var(--cf-brand-primary); font-size: 0.75rem;">Craftsman onboarding</p>
        <h2 class="font-heading mt-3 fw-semibold tracking-tight" style="color: var(--cf-text-primary); font-size: calc(1.375rem + 1.5vw); line-height: 1.1;">
          From signup to first lead — in 5 minutes.
        </h2>
        <p class="mt-4 text-base md:text-lg" style="color: var(--cf-text-secondary);">
          A smooth, split-screen onboarding designed to feel calm and confident. Upload past invoices once — our AI handles the rest.
        </p>
        <%= link_to new_user_registration_path(role: 'contractor'), class: "btn-cf-primary text-decoration-none d-inline-flex align-items-center mt-3" do %>
          Start craftsman onboarding <i data-lucide="arrow-right" class="ms-2" style="width: 16px;"></i>
        <% end %>
      </div>

      <div class="col-12 col-lg-6">
        <div class="cf-card" style="box-shadow: 0 24px 60px rgba(11,27,51,0.10);">
          <div class="row g-0">
            <div class="col-5 p-4 d-none d-sm-block" style="background-color: var(--cf-brand-soft-blue);">
              <p class="font-heading fw-semibold mb-2" style="color: var(--cf-text-primary); font-size: 14px;">Welcome to CraftFlow</p>
              <p class="text-muted leading-relaxed" style="font-size: 10px;">The smart way to manage jobs, clients and your business — all in one place.</p>
              <div class="mt-4 d-flex flex-column gap-2">
                <% ["Save time", "Get better jobs", "Work with confidence"].each do |t| %>
                  <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white border" style="width: 20px; height: 20px; border-color: var(--cf-brand-accent) !important;">
                      <i data-lucide="check-circle-2" style="color: var(--cf-brand-primary); width: 10px;"></i>
                    </div>
                    <span class="fw-medium" style="font-size: 10px; color: var(--cf-text-primary);"><%= t %></span>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="col-12 col-sm-7 p-4">
              <p class="font-medium tracking-widest uppercase mb-1" style="color: var(--cf-brand-primary); font-size: 10px;">Onboarding</p>
              <p class="font-heading fw-semibold mb-3" style="color: var(--cf-text-primary); font-size: 16px;">Let's set up your profile</p>

              <div class="d-flex align-items-center gap-2 mb-4">
                <% [1, 2, 3, 4, 5].each do |n| %>
                  <div class="rounded-circle d-flex align-items-center justify-content-center text-xs" style="width: 24px; height: 24px; <%= n == 1 ? 'background-color: var(--cf-brand-primary); color: #FFFFFF; font-weight: 500;' : 'background-color: var(--cf-bg-tertiary); color: var(--cf-text-tertiary);' %>">
                    <%= n %>
                  </div>
                  <% if n < 5 %><div class="flex-grow-1" style="height: 1px; background-color: var(--cf-border-light);"></div><% end %>
                <% end %>
              </div>

              <div class="d-flex flex-column gap-2.5 mb-3">
                <% ["Full name", "Business name", "Website"].each do |l| %>
                  <div>
                    <p class="fw-medium mb-1" style="font-size: 10px; color: var(--cf-text-primary);"><%= l %></p>
                    <div class="rounded-2" style="height: 28px; background-color: #F8FAFC; border: 1px solid var(--cf-border-light);"></div>
                  </div>
                <% end %>
              </div>
              <div class="d-flex justify-content-end">
                <div class="px-3 py-1.5 rounded-pill text-white fw-medium" style="background-color: var(--cf-brand-primary); font-size: 10px;">Next step →</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <% craftsman_screens.each do |s| %>
        <div class="col-6 col-md-3">
          <div class="p-4 rounded-4 border h-100" style="background: linear-gradient(to bottom right, #FFFFFF, var(--cf-brand-soft-blue)); border-color: var(--cf-border-light) !important;">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="font-heading text-uppercase tracking-wider fw-medium" style="color: var(--cf-text-tertiary); font-size: 10px;">SCREEN <%= s[:num] %></span>
              <div class="rounded-3 d-flex align-items-center justify-content-center bg-white border" style="width: 32px; height: 32px; border-color: var(--cf-brand-accent) !important;">
                <i data-lucide="<%= s[:icon] %>" style="color: var(--cf-brand-primary); width: 14px;"></i>
              </div>
            </div>
            <h4 class="font-heading fw-semibold text-sm mb-1" style="color: var(--cf-text-primary); font-size: 14px;"><%= s[:title] %></h4>
            <p class="text-muted mb-0" style="font-size: 12px; line-height: 1.4;"><%= s[:desc] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
