<%# app/views/pages/landing/_solution_section.html.erb %>
<section id="solution" style="background-color: var(--cf-brand-soft-blue); padding: 80px 0;">
  <div class="container" style="max-w: 1280px;">
    <div class="row align-items-center g-5">
      <div class="col-12 col-lg-6">
        <p class="text-xs font-medium tracking-widest uppercase" style="color: var(--cf-brand-primary); font-size: 0.75rem;">The solution</p>
        <h2 class="mt-3 fw-semibold tracking-tight" style="color: var(--cf-text-primary); font-size: calc(1.375rem + 1.5vw); font-family: var(--cf-font-heading); line-height: 1.1;">
          The smarter way to organize craftsmanship projects.
        </h2>
        <p class="mt-4 text-base md:text-lg" style="color: var(--cf-text-secondary);">
          CraftFlow's AI guides customers through detailed requests, collects every project detail upfront, and generates quote drafts — so craftsmen spend less time on admin and more time on craft.
        </p>

        <div class="mt-4 d-flex flex-column gap-3.5 pt-2">
          <% [
            { icon: "wand-2", title: "AI guides every request", desc: "No more incomplete briefs. Smart follow-ups capture exactly what's needed." },
            { icon: "workflow", title: "Quote drafts in seconds", desc: "We learn from your past invoices and prepare quotes ready for approval." },
            { icon: "target", title: "Intelligent project matching", desc: "Radius, services, calendar — every job lands with the right craftsman." }
          ].each do |item| %>
            <div class="d-flex align-items-start gap-3">
              <div class="rounded-3 border d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; background-color: #FFFFFF; border-color: var(--cf-border-light) !important;">
                <i data-lucide="<%= item[:icon] %>" style="color: var(--cf-brand-primary); width: 18px;"></i>
              </div>
              <div>
                <h4 class="fw-semibold mb-1 text-sm" style="color: var(--cf-text-primary); font-family: var(--cf-font-heading); font-size: 15px;"><%= item[:title] %></h4>
                <p class="text-muted text-xs mb-0" style="font-size: 13px;"><%= item[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="cf-card bg-white shadow-sm">
          <div class="d-flex align-items-center justify-content-between px-4 py-3 border-b" style="border-bottom: 1px solid var(--cf-border-light);">
            <div class="d-flex align-items-center gap-2">
              <i data-lucide="sparkles" style="color: var(--cf-brand-primary); width:16px;"></i>
              <span class="text-xs fw-semibold" style="color: var(--cf-text-primary); font-size: 12px;">CraftFlow AI Assistant</span>
            </div>
            <span class="badge text-xs px-2 py-1 rounded-pill" style="background-color: var(--cf-brand-accent); color: var(--cf-brand-primary);">Live</span>
          </div>

          <div class="p-4 d-flex flex-column gap-3" style="background-color: #FFFFFF;">
            <div class="d-flex gap-2 align-items-start max-width-80">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; background-color: var(--cf-brand-accent);"><i data-lucide="sparkles" style="color: var(--cf-brand-primary); width:12px;"></i></div>
              <div class="p-3 rounded-4" style="background-color: var(--cf-brand-soft-blue); border: 1px solid var(--cf-brand-accent); font-size: 13px; color: var(--cf-text-primary); border-top-left-radius: 4px;">
                Hi! I'll help you describe your project. What needs fixing today?
              </div>
            </div>

            <div class="d-flex justify-content-end">
              <div class="p-3 rounded-4 text-white" style="background-color: var(--cf-brand-primary); font-size: 13px; border-top-right-radius: 4px; max-width: 80%;">
                My kitchen faucet is leaking.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
