<%# app/views/pages/landing/_solution_section.html.erb %>
<section id="solution" class="d-flex align-items-center bg-white" style="min-height: calc(100vh - 74px); border-bottom: 1px solid #E2E8F0; padding: 60px 0;">
  <div class="container" style="max-width: 1280px; width: 100%;">

    <div class="row align-items-center g-5">
      <div class="col-12 col-lg-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-1.5 rounded-pill mb-3 fw-semibold" style="background-color: #EFF6FF; color: #2F6BFF; font-size: 11px;">
          Marketplace Engine
        </span>
        <h2 class="fw-bold tracking-tight mb-4" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2.25rem; letter-spacing: -0.5px; line-height: 1.2;">
          Direct communication.<br>Zero intermediaries.
        </h2>
        <p class="text-muted mb-4" style="font-size: 15px; line-height: 1.7; color: #64748B !important;">
          Handyman connects homeowners and contractors inside a clear, structure-driven framework. By defining listing parameters explicitly up front, we eliminate ambiguous timelines and hidden fees.
        </p>

        <div class="d-flex flex-column gap-4 pt-2">
          <div class="d-flex gap-3 align-items-start">
            <div class="rounded-3 border d-flex align-items-center justify-content-center bg-light flex-shrink-0" style="width: 40px; height: 40px; border-color: #E2E8F0 !important;">
              <i class="bi bi-file-earmark-text text-primary" style="font-size: 18px; color: #2F6BFF !important;"></i>
            </div>
            <div>
              <h4 class="fw-bold mb-1" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 15px;">Structured Job Listings</h4>
              <p class="text-muted small mb-0" style="font-size: 13px;">Homeowners post clear categorical parameters, matching categories directly to contractor specializations.</p>
            </div>
          </div>

          <div class="d-flex gap-3 align-items-start">
            <div class="rounded-3 border d-flex align-items-center justify-content-center bg-light flex-shrink-0" style="width: 40px; height: 40px; border-color: #E2E8F0 !important;">
              <i class="bi bi-shield-check text-primary" style="font-size: 18px; color: #2F6BFF !important;"></i>
            </div>
            <div>
              <h4 class="fw-bold mb-1" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 15px;">Offer-Scoped Conversations</h4>
              <p class="text-muted small mb-0" style="font-size: 13px;">Quotes, estimated duration, and scheduling are processed entirely inside isolated offer threads.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-7">
        <div class="card p-4 border-0" style="background-color: #F8FAFC; border: 1px solid #E2E8F0 !important; border-radius: 20px;">
          <span class="text-uppercase tracking-wider font-monospace text-muted d-block mb-3" style="font-size: 9px; font-weight: 700;">Active Offer Details</span>

          <div class="card border-0 p-4 mb-3 bg-white" style="border-radius: 14px; border: 1px solid #E2E8F0 !important;">
            <div class="row g-3">
              <div class="col-6">
                <div class="p-3 rounded-3 bg-light">
                  <span class="text-muted d-block small mb-1" style="font-size: 11px;">Contractor Quote</span>
                  <strong class="h5 m-0 fw-bold" style="color: #0B1B33; font-family: 'Outfit', sans-serif;">€150.00</strong>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 rounded-3 bg-light">
                  <span class="text-muted d-block small mb-1" style="font-size: 11px;">Estimated Duration</span>
                  <strong class="h5 m-0 fw-bold" style="color: #0B1B33; font-family: 'Outfit', sans-serif;">2.5 Hours</strong>
                </div>
              </div>
              <div class="col-12">
                <div class="p-3 rounded-3 bg-light">
                  <span class="text-muted d-block small mb-1" style="font-size: 11px;">Suggested Availability Profile</span>
                  <strong class="small m-0 fw-bold d-block" style="color: #0B1B33;"><i class="bi bi-calendar-event me-1"></i> Workdays Daytime (Mon-Fri, 8AM - 4PM)</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="d-flex gap-2">
            <div class="w-100 text-center btn btn-light border py-2 fw-semibold small" style="border-radius: 10px; font-size: 13px; border-color: #E2E8F0 !important;">Decline Offer</div>
            <div class="w-100 text-center btn text-white py-2 fw-semibold small" style="background-color: #2F6BFF; border-radius: 10px; font-size: 13px;">Accept Offer & Confirm Booking</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
