<%# app/views/pages/landing/_features.html.erb %>
<%
  customer_features = [
    { icon: "bi-search", title: "Browse Categories", desc: "Filter by specialization—plumbing, electrical, or carpentry—to target correct contractor capabilities." },
    { icon: "bi-tags", title: "Multiple Offers", desc: "Receive and evaluate competitive, flat-rate pricing proposals submitted directly to your listing." },
    { icon: "bi-check-circle", title: "Accept or Decline", desc: "Authorize your preferred offer with a single interaction to instantiate a structural booking." },
    { icon: "bi-chat-left-text", title: "Offer-Scoped Chat", desc: "Maintain isolated text communication logs nested cleanly within individual contractor quotes." },
    { icon: "bi-calendar3", title: "Booking Tracking", desc: "Propose, alter, or log calendar verification metrics safely inside active booking views." },
    { icon: "bi-star", title: "Verified Reviews", desc: "Publish operational performance feedback linked strictly to fully executed bookings." }
  ]

  contractor_features = [
    { icon: "bi-unindent", title: "Browse Open Listings", desc: "Scan real-time client requirement definitions filtered precisely by your specific trade verticals." },
    { icon: "bi-send", title: "Submit Bidding Offers", desc: "Transmit fixed-price data inputs and estimated completion hours straight to consumer feeds." },
    { icon: "bi-chat-dots", title: "Customer Interaction", desc: "Execute isolated technical screening chats directly attached to active offer data rows." },
    { icon: "bi-calendar-check", title: "Booking Calendars", desc: "Track execution schedules and manage temporal allocations using structural dashboards." },
    { icon: "bi-person-badge", title: "Profile Track Record", desc: "Compile automated rating scores and completed task metrics onto your storefront view." },
    { icon: "bi-shield-lock", title: "Role-Based Security", desc: "Ensure protected database isolation utilizing custom authenticated platform permissions." }
  ]
%>

<section id="features" class="d-flex align-items-center bg-white" style="min-height: calc(100vh - 74px); border-bottom: 1px solid #E2E8F0; padding: 60px 0;">
  <div class="container" style="max-width: 1280px; width: 100%;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-3">
      <div>
        <span class="badge bg-primary-subtle text-primary px-3 py-1.5 rounded-pill mb-2 fw-semibold" style="background-color: #EFF6FF; color: #2F6BFF; font-size: 11px;">
          Platform Capabilities
        </span>
        <h2 class="fw-bold tracking-tight mb-0" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 2rem; letter-spacing: -0.5px;">
          Engineered for the full execution cycle.
        </h2>
      </div>

      <ul class="nav nav-pills p-1 bg-white border" id="featuresTabs" role="tablist" style="border-radius: 12px; border-color: #E2E8F0 !important;">
        <li class="nav-item" role="presentation">
          <button class="nav-link active fw-bold border-0 px-4 py-2.5" id="feat-customer-tab" data-bs-toggle="pill" data-bs-target="#feat-customer" type="button" role="tab" style="font-size: 14px; font-family: 'Manrope', sans-serif; border-radius: 10px; transition: all 0.2s ease;">
            For Customers
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold border-0 px-4 py-2.5" id="feat-contractor-tab" data-bs-toggle="pill" data-bs-target="#feat-contractor" type="button" role="tab" style="font-size: 14px; font-family: 'Manrope', sans-serif; border-radius: 10px; transition: all 0.2s ease;">
            For Contractors
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content" id="featuresTabsContent">
      <div class="tab-pane fade show active" id="feat-customer" role="tabpanel" aria-labelledby="feat-customer-tab">
        <div class="row g-4">
          <% customer_features.each do |f| %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="card p-4 bg-white border-0 h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 16px; box-shadow: 0 4px 20px rgba(11,27,51,0.01);">
                <div class="rounded-3 border d-flex align-items-center justify-content-center bg-light mb-3" style="width: 40px; height: 40px; border-color: #E2E8F0 !important;">
                  <i class="bi <%= f[:icon] %> text-primary" style="font-size: 18px; color: #2F6BFF !important;"></i>
                </div>
                <h3 class="fw-bold mb-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 16px;"><%= f[:title] %></h3>
                <p class="text-muted small mb-0" style="line-height: 1.6; font-size: 13.5px; font-family: 'Manrope', sans-serif;"><%= f[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="feat-contractor" role="tabpanel" aria-labelledby="feat-contractor-tab">
        <div class="row g-4">
          <% contractor_features.each do |f| %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="card p-4 bg-white border-0 h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 16px; box-shadow: 0 4px 20px rgba(11,27,51,0.01);">
                <div class="rounded-3 border d-flex align-items-center justify-content-center bg-light mb-3" style="width: 40px; height: 40px; border-color: #E2E8F0 !important;">
                  <i class="bi <%= f[:icon] %> text-success" style="font-size: 18px; color: #10B981 !important;"></i>
                </div>
                <h3 class="fw-bold mb-2" style="font-family: 'Outfit', sans-serif; color: #0B1B33; font-size: 16px;"><%= f[:title] %></h3>
                <p class="text-muted small mb-0" style="line-height: 1.6; font-size: 13.5px; font-family: 'Manrope', sans-serif;"><%= f[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  #featuresTabs .nav-link { color: #64748B !important; background-color: transparent !important; }
  #featuresTabs .nav-link.active { color: #2F6BFF !important; background-color: #EFF6FF !important; }
</style>
