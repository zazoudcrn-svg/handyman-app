<%# app/views/pages/landing/_trust_safety.html.erb %>
<section id="trust" class="bg-white" style="padding: 80px 0;">
  <div class="container" style="max-w: 1280px;">
    <div class="text-center max-w-2xl mx-auto mb-5" style="max-width: 42rem; margin-bottom: 4rem;">
      <div class="inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background-color: var(--cf-brand-accent); color: var(--cf-brand-primary); font-size: 12px; font-weight: 500;">
        <i data-lucide="shield-check" style="width: 14px;"></i> Trust & safety
      </div>
      <h2 class="font-heading fw-semibold tracking-tight" style="color: var(--cf-text-primary); font-size: calc(1.375rem + 1.5vw);">
        Built on trust. Backed by transparency.
      </h2>
      <p class="mt-3 text-base md:text-lg" style="color: var(--cf-text-secondary);">
        CraftFlow only works if everyone — customer and craftsman — feels safe. That's non-negotiable.
      </p>
    </div>

    <div class="row g-4 pt-2">
      <% [
        { name: "Mark T.", role: "Carpenter · Munich", avatar: "MT", quote: "CraftFlow has completely changed how I run my business. Less admin, more happy customers — and AI quotes that actually sound like me." },
        { name: "Elena R.", role: "Homeowner · Berlin", avatar: "ER", quote: "I had a water leak at 11pm. Within minutes I had three verified plumbers responding. One of them was at my door in 40 minutes." },
        { name: "Tomáš K.", role: "Electrician · Vienna", avatar: "TK", quote: "The AI follow-up questions filter out time-wasters. Every lead that reaches me is ready to book." }
      ].each do |t| %>
        <div class="col-12 col-md-4">
          <div class="cf-card p-4 h-100 d-flex flex-column">
            <div class="d-flex gap-1 mb-3">
              <% 5.times do %>
                <i data-lucide="star" style="fill: var(--cf-brand-primary); color: var(--cf-brand-primary); width: 14px; height: 14px;"></i>
              <% end %>
            </div>
            <p class="text-sm leading-relaxed mb-4 flex-grow-1" style="color: var(--cf-text-primary); font-style: italic; font-size: 14.5px;">"<%= t[:quote] %>"</p>
            <div class="pt-3 border-top d-flex align-items-center gap-3" style="border-top: 1px solid var(--cf-border-light) !important;">
              <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-xs" style="width: 38px; height: 38px; background-color: var(--cf-brand-accent); color: var(--cf-brand-primary);">
                <%= t[:avatar] %>
              </div>
              <div>
                <h5 class="mb-0 text-sm fw-semibold" style="color: var(--cf-text-primary); font-size: 14px;"><%= t[:name] %></h5>
                <span class="text-muted" style="font-size: 11px;"><%= t[:role] %></span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
