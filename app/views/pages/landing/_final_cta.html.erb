<%# app/views/pages/landing/_final_cta.html.erb %>
<section class="d-flex align-items-center bg-white" style="min-height: calc(100vh - 74px); padding: 60px 0;">
  <div class="max-w-4xl mx-auto px-4 text-center" style="max-width: 720px; width: 100%;">

    <h2 class="fw-bold tracking-tight mb-3" style="color: #0B1B33; font-size: 2.25rem; font-family: 'Outfit', sans-serif; letter-spacing: -0.5px; line-height: 1.2;">
      Ready to start matching?<br>
      <span style="background: linear-gradient(to right, #2F6BFF, #5B8DFF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        Get your project handled today.
      </span>
    </h2>

    <p class="text-muted mb-5" style="max-width: 34rem; margin: 0 auto; font-size: 15px; line-height: 1.6; color: #64748B !important; font-family: 'Manrope', sans-serif;">
      Create a job to collect competitive offers immediately, or open a contractor profile to access available jobs in your specialization.
    </p>

    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-center gap-3">
      <%= link_to new_listing_path, class: "btn text-white px-4 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center text-decoration-none shadow-sm", style: "background-color: #2F6BFF; border-radius: 12px; font-size: 14px; height: 46px;" do %>
        Post a job <i class="bi bi-arrow-right ms-2" style="font-size: 14px;"></i>
      <% end %>
      <%= link_to new_user_registration_path(role: 'contractor'), class: "btn btn-light border px-4 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center text-decoration-none shadow-sm navbar-guest-btn-outline", style: "color: #0B1B33; border-radius: 12px; font-size: 14px; height: 46px; background-color: #FFFFFF;" do %>
        Join as a Contractor
      <% end %>
    </div>

  </div>
</section>
