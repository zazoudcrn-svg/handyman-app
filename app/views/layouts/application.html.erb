<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Handyman App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Handyman App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body class="bg-light">

    <%# ==================== GLOBAL HEADER NAVBAR ==================== %>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
      <div class="container-fluid px-4">
        <%= link_to "Handyman App", dashboard_path, class: "navbar-brand fw-bold text-white" %>

        <% if user_signed_in? %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-3 gap-1">

              <%# CONTRACTOR MENU NAVIGATION %>
              <% if current_user.role == "contractor" %>
                <li class="nav-item">
                  <%= link_to "Find Jobs (Dashboard)", dashboard_path, class: "nav-link #{'active fw-bold' if current_page?(dashboard_path)}" %>
                </li>
                <li class="nav-item">
                  <%= link_to "My Sent Offers", offers_path, class: "nav-link #{'active fw-bold' if current_page?(offers_path)}" %>
                </li>
                <li class="nav-item">
                  <%= link_to "My Bookings (Jobs)", bookings_path, class: "nav-link #{'active fw-bold' if current_page?(bookings_path)}" %>
                </li>

              <%# CUSTOMER MENU NAVIGATION %>
              <% else %>
                <li class="nav-item">
                  <%= link_to "My Requests (Dashboard)", dashboard_path, class: "nav-link #{'active fw-bold' if current_page?(dashboard_path)}" %>
                </li>
                <li class="nav-item">
                  <%= link_to "Received Offers", offers_path, class: "nav-link #{'active fw-bold' if current_page?(offers_path)}" %>
                </li>
                <li class="nav-item">
                  <%= link_to "My Bookings", bookings_path, class: "nav-link #{'active fw-bold' if current_page?(bookings_path)}" %>
                </li>
              <% end %>
            </ul>

            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-white border border-secondary rounded px-3" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  👤 <%= current_user.email %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow p-3" aria-labelledby="userDropdown" style="min-width: 230px;">
                  <li>
                    <div class="dropdown-header px-0 pt-0">
                      <strong><%= current_user.role&.capitalize %> Mode</strong>
                    </div>
                  </li>

                  <li>
                    <div class="px-3 py-1 my-1 rounded bg-light text-center small">
                      <span class="text-muted">Your Rating:</span>
                      <div class="text-warning fw-bold">
                        <% received_reviews = Review.where(reviewee_id: current_user.id) %>
                        <% if received_reviews.any? %>
                          ⭐ <%= (received_reviews.average(:rating) || 0).round(1) %>
                        <% else %>
                          <span class="text-muted small">No ratings yet</span>
                        <% end %>
                      </div>
                    </div>
                  </li>

                  <li><hr class="dropdown-divider"></li>

                  <li>
                    <%= link_to "View Profile", profile_path(current_user), class: "dropdown-item rounded #{'active' if current_page?(profile_path(current_user))}" %>
                  </li>

                  <li>
                    <%= link_to "My Reviews", reviews_path, class: "dropdown-item rounded #{'active' if current_page?(reviews_path)}" %>
                  </li>

                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "dropdown-item text-danger fw-bold rounded" %>
                  </li>
                </ul>
              </li>
            </ul>

          </div>
        <% else %>
          <div class="ms-auto">
            <%= link_to "Sign In", new_user_session_path, class: "btn btn-sm btn-primary fw-bold px-3" %>
          </div>
        <% end %>
      </div>
    </nav>

    <%# ==================== SYSTEM NOTIFICATIONS ==================== %>
    <div class="container mt-3">
      <% if notice %>
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
          <strong>Notice:</strong> <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
          <strong>Alert:</strong> <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <%# ==================== MAIN INJECTED APP VIEW CONTENT ==================== %>
    <div class="container my-4">
      <div class="card p-4 shadow-sm bg-white border-0" style="border-radius: 12px;">
        <main>
          <%= yield %>
        </main>
      </div>
    </div>

  </body>
</html>
