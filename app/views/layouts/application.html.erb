<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Handyman App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Handyman App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%# Premium Google Fonts for modern typography %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body>

    <%# ==================== GLOBAL HEADER NAVBAR ==================== %>
    <%# The intelligent, dynamic navbar handles all dashboard and landing contexts %>
    <%= render "layouts/navbar" %>

    <%# ==================== SYSTEM NOTIFICATIONS ==================== %>
    <%# Toast notifications positioned cleanly in the bottom right corner %>
    <div class="position-fixed bottom-0 end-0 p-4" style="z-index: 1100;">
      <% if notice %>
        <div class="toast show align-items-center text-primary bg-white border-0 shadow-lg rounded-4 p-2 animate-fade-in" role="alert" aria-live="assertive" aria-atomic="true" style="min-width: 280px; border: 1px solid var(--cf-brand-accent) !important;">
          <div class="d-flex align-items-center">
            <div class="toast-body d-flex align-items-center gap-2 fw-medium" style="font-size: 14px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              <%= notice %>
            </div>
            <button type="button" class="btn-close ms-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="toast show align-items-center text-danger bg-white border-0 shadow-lg rounded-4 p-2 animate-fade-in" role="alert" aria-live="assertive" aria-atomic="true" style="min-width: 280px; border: 1px solid #FEE2E2 !important;">
          <div class="d-flex align-items-center">
            <div class="toast-body d-flex align-items-center gap-2 fw-medium" style="font-size: 14px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-danger"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              <%= alert %>
            </div>
            <button type="button" class="btn-close ms-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        </div>
      <% end %>
    </div>

    <%# ==================== MAIN INJECTED APP VIEW CONTENT ==================== %>
    <%# Container logic is moved entirely into internal pages to allow full-width landing banners %>
    <main>
      <%= yield %>
    </main>

    <script>
      // Automatically fade out notifications after 4 seconds
      document.addEventListener('turbo:load', function() {
        const toasts = document.querySelectorAll('.toast');
        toasts.forEach(function(toast) {
          setTimeout(function() {
            toast.style.transition = 'opacity 0.5s ease';
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 500);
          }, 4000);
        });
      });
    </script>

  </body>
</html>
