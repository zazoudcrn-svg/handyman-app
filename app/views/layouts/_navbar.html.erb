<%# app/views/layouts/_navbar.html.erb %>

<nav style="background: white; border-bottom: 1px solid #E2E8F0; height: 90px; display: flex; align-items: center; position: sticky; top: 0; z-index: 1050;">
  <div class="container d-flex align-items-center justify-content-between" style="max-width: 1280px;">

    <%# Logo %>
    <%= link_to user_signed_in? ? dashboard_path : root_path, class: "d-flex align-items-center gap-2 text-decoration-none fw-medium", style: "font-size: 18px; color: #0B1B33;" do %>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
        <path d="M4 14C4 9 8 4 12 4C16 4 20 9 20 14C20 19 16 20 12 20C8 20 4 19 4 14Z" fill="#2F6BFF"/>
        <path d="M8 12C10 10 14 10 16 12" stroke="white" stroke-width="2" stroke-linecap="round"/>
      </svg>
      Handyman
    <% end %>

    <%# Navigation links — role-based %>
    <% if user_signed_in? %>
      <ul class="d-flex align-items-center gap-1 list-unstyled mb-0">
        <% if current_user.role == 'contractor' %>
          <li><%= link_to "Available Jobs", dashboard_path, class: "nav-link px-3 py-2 fw-medium #{current_page?(dashboard_path) ? 'active-link' : 'inactive-link'}" %></li>
          <li><%= link_to "Offers Sent", offers_path, class: "nav-link px-3 py-2 fw-medium #{current_page?(offers_path) ? 'active-link' : 'inactive-link'}" %></li>
          <li><%= link_to "My Bookings", bookings_path, class: "nav-link px-3 py-2 fw-medium #{current_page?(bookings_path) ? 'active-link' : 'inactive-link'}" %></li>
        <% else %>
          <li><%= link_to "My Listings", dashboard_path, class: "nav-link px-3 py-2 fw-medium #{current_page?(dashboard_path) ? 'active-link' : 'inactive-link'}" %></li>
          <li><%= link_to "Offers Received", offers_path, class: "nav-link px-3 py-2 fw-medium #{current_page?(offers_path) ? 'active-link' : 'inactive-link'}" %></li>
          <li><%= link_to "My Bookings", bookings_path, class: "nav-link px-3 py-2 fw-medium #{current_page?(bookings_path) ? 'active-link' : 'inactive-link'}" %></li>
        <% end %>
      </ul>
    <% else %>
      <%# Guest navigation links for landing page %>
      <ul class="d-flex align-items-center gap-1 list-unstyled mb-0">
        <li><a class="nav-link px-3 py-2 inactive-link fw-medium" href="#solution">Product</a></li>
        <li><a class="nav-link px-3 py-2 inactive-link fw-medium" href="#how-it-works">How it works</a></li>
        <li><a class="nav-link px-3 py-2 inactive-link fw-medium" href="#features">Features</a></li>
      </ul>
    <% end %>

    <%# Right side — user dropdown or guest CTAs %>
    <div class="d-flex align-items-center gap-3">
      <% if user_signed_in? %>

         <%# Notification %>
        <% initial = current_user.first_name.presence&.first || current_user.email.first %>
<% unread_count = current_user.notifications.unread.count %>

<%# Notification Bell dropdown %>
<div class="dropdown">
  <div class="position-relative" style="cursor: pointer;" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="ti ti-bell" style="font-size: 22px; color: #64748b;" aria-hidden="true"></i>
    <% if unread_count > 0 %>
      <span style="position: absolute; top: -4px; right: -4px; background: #2F6BFF; color: white; font-size: 10px; font-weight: 600; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; line-height: 1;">
        <%= unread_count > 9 ? "9+" : unread_count %>
      </span>
    <% end %>
  </div>

  <ul class="dropdown-menu dropdown-menu-end border-0 rounded-4 mt-2 p-0"
      style="min-width: 320px; box-shadow: 0 20px 48px rgba(11,27,51,0.12); overflow: hidden;">

    <li>
      <div style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; align-items: center; justify-content: space-between;">
        <span style="font-size: 15px; font-weight: 600; color: #0B1B33;">Notifications</span>
        <% if unread_count > 0 %>
          <%= link_to "Mark all as read", mark_all_read_notifications_path, data: { turbo_method: :patch }, style: "font-size: 12px; color: #2F6BFF; text-decoration: none;" %>
        <% end %>
      </div>
    </li>

    <% notifications = current_user.notifications.recent.limit(4) %>
    <% if notifications.any? %>
      <% notifications.each do |notification| %>
        <% resource = notification.resource %>
        <% nav_link_url = if resource.present?
          case notification.notification_type
          when 'new_match', 'new_offer', 'offer_updated', 'offer_accepted', 'offer_declined'
            resource.is_a?(Offer) ? listing_offer_path(resource.listing, resource) : (resource.is_a?(Listing) ? listing_path(resource) : notifications_path)
          when 'booking_confirmed', 'booking_cancelled', 'date_changed'
            resource.is_a?(Booking) ? booking_path(resource) : notifications_path
          when 'new_review'
            resource.is_a?(Review) ? profile_path(current_user) : notifications_path
          end
        else
          notifications_path
        end %>

        <li>
          <a href="<%= nav_link_url %>" style="text-decoration: none;">
            <div style="padding: 12px 20px; display: flex; align-items: flex-start; gap: 12px; background: <%= notification.read? ? 'white' : '#F0F5FF' %>; border-bottom: 1px solid #F1F5F9;"
                 onmouseover="this.style.background='#EEF3FF'" onmouseout="this.style.background='<%= notification.read? ? "white" : "#F0F5FF" %>'">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: <%= notification.read? ? '#E2E8F0' : '#2F6BFF' %>; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="ti <%= case notification.notification_type
                                  when 'new_match' then 'ti-map-pin'
                                  when 'new_offer', 'offer_updated' then 'ti-briefcase'
                                  when 'offer_accepted' then 'ti-circle-check'
                                  when 'offer_declined' then 'ti-circle-x'
                                  when 'booking_confirmed', 'booking_cancelled' then 'ti-calendar'
                                  when 'new_message' then 'ti-message'
                                  when 'new_review' then 'ti-star'
                                  else 'ti-bell'
                                  end %>"
                   style="font-size: 16px; color: <%= notification.read? ? '#64748b' : 'white' %>;" aria-hidden="true"></i>
              </div>
              <div style="flex: 1; min-width: 0;">
                <p style="margin: 0 0 2px; font-size: 13px; color: #0B1B33; line-height: 1.4;">
                  <%= case notification.notification_type
                        when 'new_match' then "New job match available"
                        when 'new_offer' then "New offer received"
                        when 'offer_updated' then "An offer was updated"
                        when 'offer_accepted' then "Your offer was accepted"
                        when 'offer_declined' then "Your offer was declined"
                        when 'booking_confirmed' then "Booking confirmed"
                        when 'booking_cancelled' then "Booking cancelled"
                        when 'new_message' then "New message received"
                        when 'new_review' then "You received a new review"
                        else "New notification"
                        end %>
                </p>
                <% if resource.present? %>
                  <p style="margin: 0 0 2px; font-size: 11px; color: #2F6BFF; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <%= if resource.is_a?(Listing)
                          "#{resource.title} · #{resource.city}"
                        elsif resource.is_a?(Offer)
                          resource.listing&.title
                        elsif resource.is_a?(Booking)
                          resource.offer&.listing&.title
                        end %>
                  </p>
                <% end %>
                <p style="margin: 0; font-size: 11px; color: #94a3b8;"><%= time_ago_in_words(notification.created_at) %> ago</p>
              </div>
              <% unless notification.read? %>
                <div style="width: 8px; height: 8px; border-radius: 50%; background: #2F6BFF; flex-shrink: 0; margin-top: 4px;"></div>
              <% end %>
            </div>
          </a>
        </li>
      <% end %>
    <% else %>
      <li>
        <div style="padding: 32px 20px; text-align: center;">
          <i class="ti ti-bell-off" style="font-size: 32px; color: #E2E8F0; display: block; margin-bottom: 8px;" aria-hidden="true"></i>
          <p style="margin: 0; font-size: 13px; color: #94a3b8;">No notifications yet</p>
        </div>
      </li>
    <% end %>

    <li>
      <div style="padding: 12px 20px; border-top: 1px solid #E2E8F0; text-align: center;">
        <%= link_to "View all notifications", notifications_path, style: "font-size: 13px; color: #2F6BFF; text-decoration: none;" %>
      </div>
    </li>

  </ul>
</div>
        <%# Notification %>

        <%# User dropdown trigger — Pill shape %>
        <% initial = current_user.first_name.presence&.first || current_user.email.first %>
        <div class="dropdown">
          <div class="d-flex align-items-center gap-2 navbar-trigger"
               style="border: 1px solid #E2E8F0; cursor: pointer; background: white;
                      padding: 6px 12px 6px 6px; border-radius: 50px;"
               data-bs-toggle="dropdown" aria-expanded="false">

            <%# Avatar circle %>
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #2F6BFF; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; color: white; flex-shrink: 0;">
              <%= initial.upcase %>
            </div>

            <span style="font-size: 13px; font-weight: 500; color: #0B1B33; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <% if current_user.first_name.present? %>
                <%= current_user.first_name %> <%= current_user.last_name %>
              <% else %>
                <%= current_user.email %>
              <% end %>
            </span>

            <i class="ti ti-chevron-down" style="font-size: 13px; color: #94a3b8;" aria-hidden="true"></i>
          </div>

          <%# Dropdown menu %>
          <ul class="dropdown-menu dropdown-menu-end border-0 rounded-4 mt-2 p-0"
              style="min-width: 260px; box-shadow: 0 20px 48px rgba(11,27,51,0.12); overflow: hidden;">

            <%# Header mit Avatar + Name + Role-Badge %>
            <li>
              <div style="padding: 20px 20px 16px; background: #F8FAFF; border-bottom: 1px solid #E2E8F0;">
                <div class="d-flex align-items-center gap-3">
                  <div style="width: 44px; height: 44px; border-radius: 50%; background: #2F6BFF; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 600; color: white; flex-shrink: 0;">
                    <%= initial.upcase %>
                  </div>
                  <div>
                    <div style="font-size: 14px; font-weight: 600; color: #0B1B33; line-height: 1.2;">
                      <% if current_user.first_name.present? %>
                        <%= current_user.first_name %> <%= current_user.last_name %>
                      <% else %>
                        <%= current_user.email %>
                      <% end %>
                    </div>
                    <div style="margin-top: 5px;">
                      <span style="display: inline-flex; align-items: center; gap: 4px; background: #EEF3FF; color: #2F6BFF; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; padding: 3px 8px; border-radius: 20px; text-transform: uppercase;">
                        <span style="width: 5px; height: 5px; border-radius: 50%; background: #2F6BFF; display: inline-block;"></span>
                        <%= current_user.role&.capitalize %> Mode
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </li>

            <%# Navigation links %>
            <li style="padding: 8px 8px 0;">
              <%= link_to profile_path(current_user), class: "dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2", style: "font-size: 13.5px; color: #374151;" do %>
                <i class="ti ti-user" style="font-size: 16px; color: #94a3b8;" aria-hidden="true"></i>
                View Profile
              <% end %>
            </li>
            <li style="padding: 2px 8px 0;">
              <%= link_to reviews_path, class: "dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2", style: "font-size: 13.5px; color: #374151;" do %>
                <i class="ti ti-star" style="font-size: 16px; color: #94a3b8;" aria-hidden="true"></i>
                My Reviews
              <% end %>
            </li>
            <% if current_user.role == 'contractor' %>
              <li style="padding: 2px 8px 0;">
                <%= link_to calendar_path, class: "dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2", style: "font-size: 13.5px; color: #374151;" do %>
                  <i class="ti ti-calendar" style="font-size: 16px; color: #94a3b8;" aria-hidden="true"></i>
                  My Calendar
                <% end %>
              </li>
            <% end %>

            <%# Logout %>
            <li style="padding: 8px;">
              <div style="border-top: 1px solid #E2E8F0; margin-bottom: 8px;"></div>
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2", style: "font-size: 13.5px; color: #64748b;" do %>
                <i class="ti ti-logout" style="font-size: 16px; color: #94a3b8;" aria-hidden="true"></i>
                Log Out
              <% end %>
            </li>

          </ul>
        </div>

      <% else %>
        <%# Guest CTAs %>
        <%= link_to "For Customers", new_user_registration_path(role: 'customer'), class: "text-decoration-none fw-medium", style: "font-size: 14px; color: #0B1B33;" %>
        <%= link_to "For Craftsmen", new_user_registration_path(role: 'contractor'), class: "btn text-white fw-medium", style: "font-size: 14px; background: #2F6BFF; border-radius: 8px; padding: 8px 20px;" %>
      <% end %>
    </div>

  </div>
</nav>

<style>
  .active-link {
    color: #2F6BFF !important;
    font-size: 14px;
    text-decoration: none;
  }
  .inactive-link {
    color: #64748b !important;
    font-size: 14px;
    text-decoration: none;
  }
  .inactive-link:hover {
    color: #0B1B33 !important;
  }
  .navbar-trigger {
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .navbar-trigger:hover {
    border-color: #c7d2e8 !important;
    box-shadow: 0 2px 8px rgba(11,27,51,0.08);
  }
  .dropdown-item:hover {
    background-color: #F8FAFF !important;
    color: #0B1B33 !important;
  }
</style>
